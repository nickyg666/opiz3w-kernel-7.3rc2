    core2 { cpu = <&cpu14>; };
    core3 { cpu = <&cpu15>; };
   };
  };

  cpu0: cpu@0 {
   compatible = "arm,cortex-a720ae";
   device_type = "cpu";
   reg = <0x00 0x0000>;
   enable-method = "psci";

   clocks = <&scmi_dvfs 0>;
   cpu-idle-states = <&cpu_sleep &cluster_sleep>;
   next-level-cache = <&cl0_l2_0>;

   i-cache-line-size = <64>;
