   compatible = "samsung,exynos2200-cmu-vts";
   reg = <0x15300000 0x8000>;
   #clock-cells = <1>;

   clocks = <&xtcxo>,
     <&cmu_top 160>;
   clock-names = "oscclk", "dmic";
  };

  pinctrl_vts: pinctrl@15320000 {
   compatible = "samsung,exynos2200-pinctrl";
   reg = <0x15320000 0x1000>;
  };

  cmu_alive: clock-controller@15800000 {
   compatible = "samsung,exynos2200-cmu-alive";
   reg = <0x15800000 0x8000>;
   #clock-cells = <1>;

   clocks = <&xtcxo>,
     <&cmu_top 120>;
   clock-names = "oscclk", "noc";
  };

  pinctrl_alive: pinctrl@15850000 {
   compatible = "samsung,exynos2200-pinctrl";
   reg = <0x15850000 0x1000>;

   wakeup-interrupt-controller {
    compatible = "samsung,exynos2200-wakeup-eint",
          "samsung,exynos850-wakeup-eint",
          "samsung,exynos7-wakeup-eint";
   };
  };

  pmu_system_controller: system-controller@15860000 {
   compatible = "samsung,exynos2200-pmu",
         "samsung,exynos7-pmu", "syscon";
   reg = <0x15860000 0x10000>;

   reboot: syscon-reboot {
    compatible = "syscon-reboot";
    offset = <0x3c00>;
    mask = <0x2>;
    value = <0x2>;
   };
  };

  cmu_top: clock-controller@1a320000 {
   compatible = "samsung,exynos2200-cmu-top";
   reg = <0x1a320000 0x8000>;
   #clock-cells = <1>;

   clocks = <&xtcxo>;
   clock-names = "oscclk";
  };
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupts = <1 13 8 0>,
        <1 14 8 0>,
        <1 11 8 0>,
        <1 10 8 0>,
        <1 12 8 0>;




  clock-frequency = <25600000>;
 };
};

# 1 "arch/arm64/boot/dts/exynos/exynos2200-pinctrl.dtsi" 1
# 9 "arch/arm64/boot/dts/exynos/exynos2200-pinctrl.dtsi"
# 1 "arch/arm64/boot/dts/exynos/exynos-pinctrl.h" 1
# 10 "arch/arm64/boot/dts/exynos/exynos2200-pinctrl.dtsi" 2

&pinctrl_alive {
 gpa0: gpa0-gpio-bank {
  gpio-controller;
  #gpio-cells = <2>;

  interrupt-controller;
  #interrupt-cells = <2>;
  interrupt-parent = <&gic>;
  interrupts = <0 0 4 0>,
        <0 1 4 0>,
        <0 2 4 0>,
        <0 3 4 0>,
        <0 4 4 0>,
        <0 5 4 0>,
        <0 6 4 0>,
        <0 7 4 0>;
 };

 gpa1: gpa1-gpio-bank {
  gpio-controller;
  #gpio-cells = <2>;

  interrupt-controller;
  #interrupt-cells = <2>;
  interrupt-parent = <&gic>;
  interrupts = <0 8 4 0>,
        <0 9 4 0>,
        <0 10 4 0>,
        <0 11 4 0>,
        <0 12 4 0>,
        <0 13 4 0>,
        <0 14 4 0>,
        <0 15 4 0>;
 };

 gpa2: gpa2-gpio-bank {
  gpio-controller;
  #gpio-cells = <2>;

  interrupt-controller;
  #interrupt-cells = <2>;
  interrupt-parent = <&gic>;
  interrupts = <0 16 4 0>,
        <0 17 4 0>,
        <0 18 4 0>,
        <0 19 4 0>,
        <0 20 4 0>,
        <0 21 4 0>,
        <0 22 4 0>,
