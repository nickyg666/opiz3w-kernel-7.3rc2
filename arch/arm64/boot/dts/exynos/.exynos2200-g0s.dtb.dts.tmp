# 2023 "arch/arm64/boot/dts/exynos/exynos2200.dtsi" 2
# 10 "arch/arm64/boot/dts/exynos/exynos2200-g0s.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 11 "arch/arm64/boot/dts/exynos/exynos2200-g0s.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 1
# 13 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/linux-event-codes.h" 1
# 14 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 2
# 12 "arch/arm64/boot/dts/exynos/exynos2200-g0s.dts" 2


/ {
 model = "Samsung Galaxy S22+ (SM-S906B)";
 compatible = "samsung,g0s", "samsung,exynos2200";
 chassis-type = "handset";

 chosen {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  framebuffer: framebuffer {
   compatible = "simple-framebuffer";
   memory-region = <&cont_splash_mem>;
   width = <1080>;
   height = <2340>;
   stride = <(1080 * 4)>;
   format = "a8r8g8b8";
  };
 };







 rtcclk: clock-rtcclk {
  compatible = "fixed-clock";
  clock-output-names = "rtcclk";
  #clock-cells = <0>;
  clock-frequency = <32768>;
 };

 gpio-keys {
  compatible = "gpio-keys";

  pinctrl-0 = <&key_volup>;
  pinctrl-names = "default";

  volup-key {
   label = "Volume Up";
   linux,code = <115>;
   gpios = <&gpa3 0 1>;
   wakeup-source;
  };
 };

 memory@80000000 {
  device_type = "memory";
  reg = <0x0 0x80000000 0x0 0x80000000>,
        <0x8 0x80000000 0x1 0x7e000000>;
 };


 reg_dummy: regulator-0 {
  compatible = "regulator-fixed";
  regulator-name = "dummy_reg";
 };

 reserved-memory {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  cont_splash_mem: framebuffer@f6200000 {
   reg = <0x0 0xf6200000 0x0 (1080 * 2340 * 4)>;
   no-map;
  };

  debug_kinfo_reserved: debug-kinfo-reserved@fcfff000 {
   reg = <0x0 0xfcfff000 0x0 0x1000>;
   no-map;
  };

  log_itmon: log-itmon@fffe0000 {
   reg = <0x0 0xfffe0000 0x0 0x20000>;
   no-map;
  };
 };
};

&cmu_hsi0 {
 clocks = <&xtcxo>,
   <&rtcclk>,
   <&cmu_top 137>,
   <&cmu_top 135>,
   <&cmu_top 136>,
   <&cmu_top 138>;
 clock-names = "oscclk", "rtcclk", "noc", "dpgtc", "dposc", "usb";
};





&cpu2 {
 status = "fail";
};

&cpu3 {
 status = "fail";
};

&ext_26m {
 clock-frequency = <26000000>;
};

&ext_200m {
 clock-frequency = <200000000>;
};

&mct_peris {
 status = "okay";
};

&pinctrl_alive {
 key_volup: key-volup-pins {
  samsung,pins = "gpa3-0";
  samsung,pin-function = <0xf>;
  samsung,pin-pud = <3>;
  samsung,pin-drv = <3>;
 };
};

&ppi_cluster0 {
 affinity = <&cpu0 &cpu1>;
};

&usb {

 vdd10-supply = <&reg_dummy>;
 vdd33-supply = <&reg_dummy>;

 status = "okay";
};

&usb32drd {
 status = "okay";
};

&usb_dwc3 {
 dr_mode = "otg";
 usb-role-switch;
 role-switch-default-mode = "peripheral";
 maximum-speed = "high-speed";
};

&usb_hsphy {

 vdda12-supply = <&reg_dummy>;
 vdd-supply = <&reg_dummy>;

 status = "okay";
};

&xtcxo {
 clock-frequency = <76800000>;
};
