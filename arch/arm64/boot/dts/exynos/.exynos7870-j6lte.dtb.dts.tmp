# 0 "arch/arm64/boot/dts/exynos/exynos7870-j6lte.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/exynos/exynos7870-j6lte.dts"
# 9 "arch/arm64/boot/dts/exynos/exynos7870-j6lte.dts"
/dts-v1/;
# 1 "arch/arm64/boot/dts/exynos/exynos7870.dtsi" 1
# 9 "arch/arm64/boot/dts/exynos/exynos7870.dtsi"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/clock/samsung,exynos7870-cmu.h" 1
# 10 "arch/arm64/boot/dts/exynos/exynos7870.dtsi" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/arm-gic.h" 1
# 9 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/arm-gic.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 10 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/arm-gic.h" 2
# 11 "arch/arm64/boot/dts/exynos/exynos7870.dtsi" 2

/ {
 compatible = "samsung,exynos7870";
 #address-cells = <2>;
 #size-cells = <1>;

 interrupt-parent = <&gic>;

 aliases {
  pinctrl0 = &pinctrl_alive;
  pinctrl1 = &pinctrl_dispaud;
  pinctrl2 = &pinctrl_ese;
  pinctrl3 = &pinctrl_fsys;
  pinctrl4 = &pinctrl_mif;
  pinctrl5 = &pinctrl_nfc;
  pinctrl6 = &pinctrl_top;
  pinctrl7 = &pinctrl_touch;
 };

 cpus {
  #address-cells = <1>;
  #size-cells = <0>;

  cpu-map {
   cluster0 {
    core0 {
     cpu = <&cpu0>;
    };

    core1 {
     cpu = <&cpu1>;
    };

    core2 {
     cpu = <&cpu2>;
    };

    core3 {
     cpu = <&cpu3>;
    };
   };

   cluster1 {
    core0 {
     cpu = <&cpu4>;
    };

    core1 {
     cpu = <&cpu5>;
    };

    core2 {
     cpu = <&cpu6>;
    };

    core3 {
     cpu = <&cpu7>;
    };
   };
  };

  cpu0: cpu@0 {
   device_type = "cpu";
   compatible = "arm,cortex-a53";
   reg = <0x0>;
   enable-method = "psci";
  };

  cpu1: cpu@1 {
   device_type = "cpu";
   compatible = "arm,cortex-a53";
   reg = <0x1>;
   enable-method = "psci";
  };

  cpu2: cpu@2 {
   device_type = "cpu";
   compatible = "arm,cortex-a53";
   reg = <0x2>;
   enable-method = "psci";
  };

  cpu3: cpu@3 {
   device_type = "cpu";
   compatible = "arm,cortex-a53";
   reg = <0x3>;
   enable-method = "psci";
  };

  cpu4: cpu@100 {
   device_type = "cpu";
   compatible = "arm,cortex-a53";
   reg = <0x100>;
   enable-method = "psci";
  };

  cpu5: cpu@101 {
   device_type = "cpu";
   compatible = "arm,cortex-a53";
   reg = <0x101>;
   enable-method = "psci";
  };

  cpu6: cpu@102 {
   device_type = "cpu";
   compatible = "arm,cortex-a53";
   reg = <0x102>;
   enable-method = "psci";
  };

  cpu7: cpu@103 {
   device_type = "cpu";
   compatible = "arm,cortex-a53";
   reg = <0x103>;
   enable-method = "psci";
  };
 };

 oscclk: oscclk {
  compatible = "fixed-clock";
  #clock-cells = <0>;
 };

 psci {
  compatible = "arm,psci";
  method = "smc";
  cpu_suspend = <0xc4000001>;
  cpu_off = <0x84000002>;
  cpu_on = <0xc4000003>;
 };

 soc: soc@0 {
  compatible = "simple-bus";
  ranges = <0x0 0x0 0x0 0x20000000>;
  #address-cells = <1>;
  #size-cells = <1>;

  chipid@10100000 {
   compatible = "samsung,exynos7870-chipid",
         "samsung,exynos4210-chipid";
   reg = <0x10100000 0x100>;
  };

  cmu_peri: clock-controller@101f0000 {
   compatible = "samsung,exynos7870-cmu-peri";
   reg = <0x101f0000 0x1000>;
   #clock-cells = <1>;

   clock-names = "oscclk", "bus", "spi0", "spi1", "spi2",
          "spi3", "spi4", "uart0", "uart1", "uart2";
   clocks = <&oscclk>,
     <&cmu_mif 50>,
     <&cmu_mif 51>,
     <&cmu_mif 52>,
     <&cmu_mif 53>,
     <&cmu_mif 54>,
     <&cmu_mif 55>,
     <&cmu_mif 56>,
     <&cmu_mif 57>,
     <&cmu_mif 58>;
  };

  cmu_mif: clock-controller@10460000 {
   compatible = "samsung,exynos7870-cmu-mif";
   reg = <0x10460000 0x1000>;
   #clock-cells = <1>;

   clock-names = "oscclk";
   clocks = <&oscclk>;
  };

  pmu_system_controller: system-controller@10480000 {
   compatible = "samsung,exynos7870-pmu",
         "samsung,exynos7-pmu", "syscon";
   reg = <0x10480000 0x10000>;

   mipi_phy: mipi-phy {
    compatible = "samsung,exynos7870-mipi-video-phy";
    #phy-cells = <1>;

    samsung,cam0-sysreg = <&syscon_cam0>;
    samsung,disp-sysreg = <&syscon_disp>;
   };

   reboot-mode {
    compatible = "syscon-reboot-mode";
    offset = <0x080c>;
    mode-bootloader = <0x1234567d>;
    mode-download = <0x12345671>;
    mode-recovery = <0x12345674>;
   };
  };

  gic: interrupt-controller@104e1000 {
   compatible = "arm,cortex-a15-gic";
   reg = <0x104e1000 0x1000>,
         <0x104e2000 0x1000>,
         <0x104e4000 0x2000>,
         <0x104e6000 0x2000>;
   interrupts = <1 9 ((((1 << (8)) - 1) << 8) | 4)>;
   interrupt-controller;
   #address-cells = <0>;
   #interrupt-cells = <3>;
  };

  hsi2c0: i2c@10510000 {
   compatible = "samsung,exynos7870-hsi2c",
         "samsung,exynos7-hsi2c";
   reg = <0x10510000 0x2000>;
   interrupts = <0 371 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&hsi2c0_bus>;

   clock-names = "hsi2c";
   clocks = <&cmu_mif 66>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  pinctrl_mif: pinctrl@10530000 {
   compatible = "samsung,exynos7870-pinctrl";
   reg = <0x10530000 0x1000>;
   interrupts = <0 392 4>;
  };

  gpu: gpu@11400000 {
   compatible = "samsung,exynos7870-mali", "arm,mali-t830";
   reg = <0x11400000 0x5000>;
   interrupt-names = "job", "mmu", "gpu";
   interrupts = <0 282 4>,
         <0 283 4>,
         <0 281 4>;

   clock-names = "core", "bus";
   clocks = <&cmu_g3d 6>,
     <&cmu_g3d 4>;

   status = "disabled";
  };

  cmu_g3d: clock-controller@11460000 {
   compatible = "samsung,exynos7870-cmu-g3d";
   reg = <0x11460000 0x1000>;
   #clock-cells = <1>;

   clock-names = "oscclk", "switch";
   clocks = <&oscclk>,
     <&cmu_mif 41>;
  };

  cmu_mfcmscl: clock-controller@12cb0000 {
   compatible = "samsung,exynos7870-cmu-mfcmscl";
   reg = <0x12cb0000 0x1000>;
   #clock-cells = <1>;

   clock-names = "oscclk", "mfc", "mscl";
   clocks = <&oscclk>,
     <&cmu_mif 48>,
     <&cmu_mif 49>;
  };

  mmc0: mmc@13540000 {
   compatible = "samsung,exynos7870-dw-mshc-smu";
   reg = <0x13540000 0x2000>;
   interrupts = <0 245 4>;

   clock-names = "biu", "ciu";
   clocks = <&cmu_fsys 3>,
     <&cmu_mif 37>;

   status = "disabled";
  };

  mmc1: mmc@13550000 {
   compatible = "samsung,exynos7870-dw-mshc-smu";
   reg = <0x13550000 0x2000>;
   interrupts = <0 246 4>;

   clock-names = "biu", "ciu";
   clocks = <&cmu_fsys 4>,
     <&cmu_mif 38>;

   status = "disabled";
  };

  mmc2: mmc@13560000 {
   compatible = "samsung,exynos7870-dw-mshc-smu";
   reg = <0x13560000 0x2000>;
   interrupts = <0 247 4>;

   clock-names = "biu", "ciu";
   clocks = <&cmu_fsys 5>,
     <&cmu_mif 39>;

   status = "disabled";
  };

  usbdrd_phy: phy@135c0000 {
   compatible = "samsung,exynos7870-usbdrd-phy";
   reg = <0x135c0000 0x100>;
   #phy-cells = <1>;

   clock-names = "phy", "ref";
   clocks = <&cmu_fsys 6>,
     <&cmu_fsys 8>;

   samsung,pmu-syscon = <&pmu_system_controller>;
  };

  usbdrd: usb@13600000 {
   compatible = "samsung,exynos7870-dwusb3";
   ranges = <0x0 0x13600000 0x10000>;
   #address-cells = <1>;
   #size-cells = <1>;

   clock-names = "bus_early", "ref", "ctrl";
   clocks = <&cmu_fsys 15>,
     <&cmu_fsys 17>,
     <&cmu_fsys 16>;

   status = "disabled";

   usb@0 {
    compatible = "snps,dwc3";
    reg = <0x0 0x10000>;
    interrupts = <0 230 4>;

    phy-names = "usb2-phy";
    phys = <&usbdrd_phy 0>;

    usb-role-switch;
    snps,usb2-gadget-lpm-disable;
   };
  };

  cmu_fsys: clock-controller@13730000 {
   compatible = "samsung,exynos7870-cmu-fsys";
   reg = <0x13730000 0x1000>;
   #clock-cells = <1>;

   clock-names = "oscclk", "bus", "usb20drd";
   clocks = <&oscclk>,
     <&cmu_mif 36>,
     <&cmu_mif 40>;
  };

  pinctrl_fsys: pinctrl@13750000 {
   compatible = "samsung,exynos7870-pinctrl";
   reg = <0x13750000 0x1000>;
   interrupts = <0 250 4>;
  };

  serial0: serial@13800000 {
   compatible = "samsung,exynos7870-uart",
         "samsung,exynos8895-uart";
   reg = <0x13800000 0x100>;
   interrupts = <0 421 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&uart0_bus>;

   clock-names = "uart", "clk_uart_baud0";
   clocks = <&cmu_peri 41>,
     <&cmu_peri 40>;

   samsung,uart-fifosize = <16>;

   status = "disabled";
  };

  serial1: serial@13810000 {
   compatible = "samsung,exynos7870-uart",
         "samsung,exynos8895-uart";
   reg = <0x13810000 0x100>;
   interrupts = <0 422 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&uart1_bus>;

   clock-names = "uart", "clk_uart_baud0";
   clocks = <&cmu_peri 43>,
     <&cmu_peri 42>;

   samsung,uart-fifosize = <256>;

   status = "disabled";
  };

  serial2: serial@13820000 {
   compatible = "samsung,exynos7870-uart",
         "samsung,exynos8895-uart";
   reg = <0x13820000 0x100>;
   interrupts = <0 423 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&uart2_bus>;

   clock-names = "uart", "clk_uart_baud0";
   clocks = <&cmu_peri 45>,
     <&cmu_peri 44>;

   samsung,uart-fifosize = <256>;

   status = "disabled";
  };

  i2c0: i2c@13830000 {
   compatible = "samsung,exynos7870-i2c",
         "samsung,s3c2440-i2c";
   reg = <0x13830000 0x100>;
   interrupts = <0 424 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&i2c0_bus>;

   clock-names = "i2c";
   clocks = <&cmu_peri 12>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  i2c1: i2c@13840000 {
   compatible = "samsung,exynos7870-i2c",
         "samsung,s3c2440-i2c";
   reg = <0x13840000 0x100>;
   interrupts = <0 425 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&i2c1_bus>;

   clock-names = "i2c";
   clocks = <&cmu_peri 13>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  i2c2: i2c@13850000 {
   compatible = "samsung,exynos7870-i2c",
         "samsung,s3c2440-i2c";
   reg = <0x13850000 0x100>;
   interrupts = <0 426 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&i2c2_bus>;

   clock-names = "i2c";
   clocks = <&cmu_peri 14>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  i2c3: i2c@13860000 {
   compatible = "samsung,exynos7870-i2c",
         "samsung,s3c2440-i2c";
   reg = <0x13860000 0x100>;
   interrupts = <0 427 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&i2c3_bus>;

   clock-names = "i2c";
   clocks = <&cmu_peri 15>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  i2c4: i2c@13870000 {
   compatible = "samsung,exynos7870-i2c",
         "samsung,s3c2440-i2c";
   reg = <0x13870000 0x100>;
   interrupts = <0 428 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&i2c4_bus>;

   clock-names = "i2c";
   clocks = <&cmu_peri 16>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  i2c5: i2c@13880000 {
   compatible = "samsung,exynos7870-i2c",
         "samsung,s3c2440-i2c";
   reg = <0x13880000 0x100>;
   interrupts = <0 429 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&i2c5_bus>;

   clock-names = "i2c";
   clocks = <&cmu_peri 17>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  i2c6: i2c@13890000 {
   compatible = "samsung,exynos7870-i2c",
         "samsung,s3c2440-i2c";
   reg = <0x13890000 0x100>;
   interrupts = <0 430 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&i2c6_bus>;

   clock-names = "i2c";
   clocks = <&cmu_peri 18>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  hsi2c1: i2c@138a0000 {
   compatible = "samsung,exynos7870-hsi2c",
         "samsung,exynos7-hsi2c";
   reg = <0x138a0000 0x1000>;
   interrupts = <0 449 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&hsi2c1_bus>;

   clock-names = "hsi2c";
   clocks = <&cmu_peri 6>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  hsi2c2: i2c@138b0000 {
   compatible = "samsung,exynos7870-hsi2c",
         "samsung,exynos7-hsi2c";
   reg = <0x138b0000 0x1000>;
   interrupts = <0 450 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&hsi2c2_bus>;

   clock-names = "hsi2c";
   clocks = <&cmu_peri 7>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  hsi2c3: i2c@138c0000 {
   compatible = "samsung,exynos7870-hsi2c",
         "samsung,exynos7-hsi2c";
   reg = <0x138c0000 0x1000>;
   interrupts = <0 451 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&hsi2c3_bus>;

   clock-names = "hsi2c";
   clocks = <&cmu_peri 8>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  i2c7: i2c@138d0000 {
   compatible = "samsung,exynos7870-i2c",
         "samsung,s3c2440-i2c";
   reg = <0x138d0000 0x100>;
   interrupts = <0 453 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&i2c7_bus>;

   clock-names = "i2c";
   clocks = <&cmu_peri 19>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  i2c8: i2c@138e0000 {
   compatible = "samsung,exynos7870-i2c",
         "samsung,s3c2440-i2c";
   reg = <0x138e0000 0x100>;
   interrupts = <0 454 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&i2c8_bus>;

   clock-names = "i2c";
   clocks = <&cmu_peri 20>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  hsi2c4: i2c@138f0000 {
   compatible = "samsung,exynos7870-hsi2c",
         "samsung,exynos7-hsi2c";
   reg = <0x138f0000 0x1000>;
   interrupts = <0 456 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&hsi2c4_bus>;

   clock-names = "hsi2c";
   clocks = <&cmu_peri 9>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  hsi2c5: i2c@13950000 {
   compatible = "samsung,exynos7870-hsi2c",
         "samsung,exynos7-hsi2c";
   reg = <0x13950000 0x1000>;
   interrupts = <0 457 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&hsi2c5_bus>;

   clock-names = "hsi2c";
   clocks = <&cmu_peri 10>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  hsi2c6: i2c@13960000 {
   compatible = "samsung,exynos7870-hsi2c",
         "samsung,exynos7-hsi2c";
   reg = <0x13960000 0x1000>;
   interrupts = <0 458 4>;

   pinctrl-names = "default";
   pinctrl-0 = <&hsi2c6_bus>;

   clock-names = "hsi2c";
   clocks = <&cmu_peri 11>;

   #address-cells = <1>;
   #size-cells = <0>;

   status = "disabled";
  };

  pinctrl_top: pinctrl@139b0000 {
   compatible = "samsung,exynos7870-pinctrl";
   reg = <0x139b0000 0x1000>;
   interrupts = <0 438 4>;
  };

  pinctrl_nfc: pinctrl@139c0000 {
   compatible = "samsung,exynos7870-pinctrl";
   reg = <0x139c0000 0x1000>;
   interrupts = <0 439 4>;
  };

  pinctrl_touch: pinctrl@139d0000 {
   compatible = "samsung,exynos7870-pinctrl";
   reg = <0x139d0000 0x1000>;
   interrupts = <0 440 4>;
  };

  pinctrl_ese: pinctrl@139e0000 {
   compatible = "samsung,exynos7870-pinctrl";
   reg = <0x139e0000 0x1000>;
   interrupts = <0 441 4>;
  };

  pinctrl_alive: pinctrl@139f0000 {
   compatible = "samsung,exynos7870-pinctrl";
   reg = <0x139f0000 0x1000>;

   wakeup-interrupt-controller {
    compatible = "samsung,exynos7870-wakeup-eint",
          "samsung,exynos7-wakeup-eint";
    interrupt-parent = <&gic>;
    interrupts = <0 16 4>;
   };
  };

  cmu_isp: clock-controller@144d0000 {
   compatible = "samsung,exynos7870-cmu-isp";
   reg = <0x144d0000 0x1000>;
   #clock-cells = <1>;

   clock-names = "oscclk", "cam", "isp", "vra";
   clocks = <&oscclk>,
     <&cmu_mif 42>,
     <&cmu_mif 43>,
     <&cmu_mif 47>;
  };

  syscon_cam0: system-controller@144f1040 {
   compatible = "samsung,exynos7870-cam0-sysreg", "syscon";
   reg = <0x144f1040 0x04>;
  };

  dsi: dsi@14800000 {
   compatible = "samsung,exynos7870-mipi-dsi";
   reg = <0x14800000 0x100>;
   interrupts = <0 207 4>;

   clocks = <&cmu_dispaud 12>,
     <&cmu_dispaud 10>,
     <&cmu_dispaud 33>,
     <&cmu_dispaud 31>;
   clock-names = "bus", "pll", "byte", "esc";

   phys = <&mipi_phy 1>;
   phy-names = "dsim";

   status = "disabled";

   ports {
    #address-cells = <1>;
    #size-cells = <0>;

    port@0 {
     reg = <0>;

     dsi_to_decon: endpoint {
      remote-endpoint = <&decon_to_dsi>;
     };
    };
   };
  };

  decon: display-controller@14830000 {
   compatible = "samsung,exynos7870-decon";
   reg = <0x14830000 0x8000>;
   interrupts = <0 201 4>,
         <0 202 4>,
         <0 203 4>;
   interrupt-names = "fifo", "vsync", "lcd_sys";

   clocks = <&cmu_dispaud 35>,
     <&cmu_dispaud 25>,
     <&cmu_dispaud 26>,
     <&cmu_dispaud 28>;
   clock-names = "pclk_decon0", "aclk_decon0",
          "decon0_eclk", "decon0_vclk";

   iommus = <&sysmmu_decon>;

   status = "disabled";

   port {
    decon_to_dsi: endpoint {
     remote-endpoint = <&dsi_to_decon>;
    };
   };
  };

  sysmmu_decon: iommu@14860000 {
   compatible = "samsung,exynos-sysmmu";
   reg = <0x14860000 0x1000>;
   interrupts = <0 193 4>;
   #iommu-cells = <0>;

   clocks = <&cmu_dispaud 25>;
   clock-names = "sysmmu";
  };

  pinctrl_dispaud: pinctrl@148c0000 {
   compatible = "samsung,exynos7870-pinctrl";
   reg = <0x148c0000 0x1000>;
   interrupts = <0 68 4>;
  };

  cmu_dispaud: clock-controller@148d0000 {
   compatible = "samsung,exynos7870-cmu-dispaud";
   reg = <0x148d0000 0x1000>;
   #clock-cells = <1>;

   clock-names = "oscclk", "bus", "decon_eclk", "decon_vclk";
   clocks = <&oscclk>,
     <&cmu_mif 33>,
     <&cmu_mif 34>,
     <&cmu_mif 35>;
  };

  syscon_disp: system-controller@148f100c {
   compatible = "samsung,exynos7870-disp-sysreg", "syscon";
   reg = <0x148f100c 0x04>;
  };
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupts = <1 13 ((((1 << (8)) - 1) << 8) | 8)>,
        <1 14 ((((1 << (8)) - 1) << 8) | 8)>,
        <1 11 ((((1 << (8)) - 1) << 8) | 8)>,
        <1 10 ((((1 << (8)) - 1) << 8) | 8)>;





  clock-frequency = <26000000>;
 };
};

