 };

 spi4_cs_func: spi4-cs-func-pins {
  samsung,pins = "gpc4-3";
  samsung,pin-function = <3>;
  samsung,pin-pud = <3>;
  samsung,pin-drv = <0>;
 };

 spi4_miso: spi4-miso-pins {
