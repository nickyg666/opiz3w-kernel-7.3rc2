# 0 "arch/arm64/boot/dts/rockchip/rk3588-tiger-haikou-video-demo.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/rk3588-tiger-haikou-video-demo.dtso"
# 12 "arch/arm64/boot/dts/rockchip/rk3588-tiger-haikou-video-demo.dtso"
/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 16 "arch/arm64/boot/dts/rockchip/rk3588-tiger-haikou-video-demo.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 17 "arch/arm64/boot/dts/rockchip/rk3588-tiger-haikou-video-demo.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/leds/common.h" 1
# 18 "arch/arm64/boot/dts/rockchip/rk3588-tiger-haikou-video-demo.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/rockchip.h" 1
# 19 "arch/arm64/boot/dts/rockchip/rk3588-tiger-haikou-video-demo.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/soc/rockchip,vop2.h" 1
# 20 "arch/arm64/boot/dts/rockchip/rk3588-tiger-haikou-video-demo.dtso" 2

&{/} {
 backlight: backlight {
  compatible = "pwm-backlight";
  power-supply = <&dc_12v>;
  pwms = <&pwm0 0 25000 0>;
 };

 vcc1v8_video: regulator-vcc1v8-video {
  compatible = "regulator-fixed";
  regulator-name = "vcc1v8-video";
  regulator-always-on;
  regulator-boot-on;
  regulator-min-microvolt = <1800000>;
  regulator-max-microvolt = <1800000>;
  vin-supply = <&vcc3v3_baseboard>;
 };

 vcc2v8_video: regulator-vcc2v8-video {
  compatible = "regulator-fixed";
  regulator-name = "vcc2v8-video";
  regulator-always-on;
  regulator-boot-on;
  regulator-min-microvolt = <2800000>;
  regulator-max-microvolt = <2800000>;
  vin-supply = <&vcc3v3_baseboard>;
 };

 video-adapter-leds {
  compatible = "gpio-leds";

  video-adapter-led {
   color = <3>;
   gpios = <&pca9670 7 0>;
   label = "video-adapter-led";
   linux,default-trigger = "none";
  };
 };
};

&dsi0 {
 #address-cells = <1>;
 #size-cells = <0>;
 status = "okay";

 panel@0 {
  compatible = "leadtek,ltk050h3148w";
  reg = <0>;
  backlight = <&backlight>;
  iovcc-supply = <&vcc1v8_video>;
  reset-gpios = <&pca9670 0 1>;
  vci-supply = <&vcc2v8_video>;

  port {
   mipi_panel_in: endpoint {
    remote-endpoint = <&dsi0_out_panel>;
   };
  };
 };
};

&dsi0_in {
 dsi0_in_vp3: endpoint {
  remote-endpoint = <&vp3_out_dsi0>;
 };
};

&dsi0_out {
 dsi0_out_panel: endpoint {
  remote-endpoint = <&mipi_panel_in>;
 };
};

&i2c6 {

 clock-frequency = <400000>;
 #address-cells = <1>;
 #size-cells = <0>;

 touchscreen@14 {
  compatible = "goodix,gt911";
  reg = <0x14>;
  interrupt-parent = <&gpio3>;
  interrupts = <19 8>;
  irq-gpios = <&gpio3 19 0>;
  pinctrl-names = "default";
  pinctrl-0 = <&touch_int>;
  reset-gpios = <&pca9670 1 0>;
  AVDD28-supply = <&vcc2v8_video>;
  VDDIO-supply = <&vcc3v3_baseboard>;
 };

 pca9670: gpio@27 {
  compatible = "nxp,pca9670";
  reg = <0x27>;
  gpio-controller;
  #gpio-cells = <2>;
  pinctrl-names = "default";
  pinctrl-0 = <&pca9670_resetn>;
  reset-gpios = <&gpio3 17 1>;
 };
};

&mipidcphy0 {
 status = "okay";
};

&pinctrl {
 pca9670 {
  pca9670_resetn: pca9670-resetn {
   rockchip,pins = <3 17 0 &pcfg_pull_none>;
  };
 };

 touch {
  touch_int: touch-int {
   rockchip,pins = <3 19 0 &pcfg_pull_none>;
  };
 };
};

&pwm0 {
 status = "okay";
};

&vp3 {
 #address-cells = <1>;
 #size-cells = <0>;

 vp3_out_dsi0: endpoint@4 {
  reg = <4>;
  remote-endpoint = <&dsi0_in_vp3>;
 };
};
