   compatible = "rockchip,rk3562-dw-mshc",
         "rockchip,rk3288-dw-mshc";
   reg = <0x0 0xff890000 0x0 0x10000>;
   interrupts = <0 57 4>;
   clocks = <&cru 145>, <&cru 146>,
