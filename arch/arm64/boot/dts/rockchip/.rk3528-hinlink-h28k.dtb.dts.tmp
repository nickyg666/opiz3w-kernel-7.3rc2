  otp: efuse@ffce0000 {
   compatible = "rockchip,rk3528-otp";
   reg = <0x0 0xffce0000 0x0 0x4000>;
   clocks = <&cru 299>, <&cru 297>,
     <&cru 298>;
   clock-names = "otp", "apb_pclk", "sbpi";
   resets = <&cru 192>, <&cru 190>,
     <&cru 191>;
   reset-names = "otp", "apb", "sbpi";

   nvmem-layout {
    compatible = "fixed-layout";
    #address-cells = <1>;
    #size-cells = <1>;

    cpu_code: cpu-code@2 {
     reg = <0x02 0x2>;
    };

    otp_cpu_version: cpu-version@8 {
     reg = <0x08 0x1>;
     bits = <3 3>;
    };

    otp_id: id@a {
     reg = <0x0a 0x10>;
    };

    cpu_leakage: cpu-leakage@1a {
     reg = <0x1a 0x1>;
    };

    logic_leakage: logic-leakage@1b {
     reg = <0x1b 0x1>;
    };

    gpu_leakage: gpu-leakage@1c {
     reg = <0x1c 0x1>;
    };

    tsadc_trim: tsadc-trim@44 {
     reg = <0x44 0x2>;
     bits = <0 10>;
    };
   };
  };

  dmac: dma-controller@ffd60000 {
   compatible = "arm,pl330", "arm,primecell";
   reg = <0x0 0xffd60000 0x0 0x4000>;
   clocks = <&cru 94>;
   clock-names = "apb_pclk";
   interrupts = <0 0 4>,
         <0 1 4>,
         <0 2 4>,
         <0 3 4>,
         <0 4 4>,
         <0 5 4>,
         <0 6 4>,
         <0 7 4>,
         <0 16 4>;
   #dma-cells = <1>;
   arm,pl330-periph-burst;
  };

  combphy: phy@ffdc0000 {
   compatible = "rockchip,rk3528-naneng-combphy";
   reg = <0x0 0xffdc0000 0x0 0x10000>;
   assigned-clocks = <&cru 123>;
   assigned-clock-rates = <100000000>;
   clocks = <&cru 123>,
     <&cru 179>,
     <&cru 180>;
   clock-names = "ref", "apb", "pipe";
   power-domains = <&power 8>;
   resets = <&cru 99>,
     <&cru 101>;
   reset-names = "phy", "apb";
   #phy-cells = <1>;
   rockchip,pipe-grf = <&vpu_grf>;
   rockchip,pipe-phy-grf = <&pipe_phy_grf>;
   status = "disabled";
  };

  usb2phy: usb2phy@ffdf0000 {
   compatible = "rockchip,rk3528-usb2phy";
   reg = <0x0 0xffdf0000 0x0 0x10000>;
   clocks = <&cru 311>, <&cru 310>;
   clock-names = "phyclk", "pclk";
   #clock-cells = <0>;
   clock-output-names = "clk_usbphy_480m";
   power-domains = <&power 7>;
   rockchip,usbgrf = <&vo_grf>;
   status = "disabled";

   usb2phy_otg: otg-port {
    interrupts = <0 146 4>,
          <0 147 4>,
          <0 148 4>;
    interrupt-names = "otg-bvalid", "otg-id",
        "linestate";
    #phy-cells = <0>;
    status = "disabled";
   };

   usb2phy_host: host-port {
    interrupts = <0 150 4>;
    interrupt-names = "linestate";
    #phy-cells = <0>;
    status = "disabled";
   };
  };
 };
