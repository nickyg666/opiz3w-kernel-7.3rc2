# 0 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso"
# 19 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso"
/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 23 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/rockchip.h" 1
# 24 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso" 2

&{/} {
 pre_ict_tester_vcc_1v2: regulator-pre-ict-tester-vcc-1v2 {
  compatible = "regulator-fixed";
  regulator-name = "pre_ict_tester_vcc_1v2";
  regulator-always-on;
  regulator-boot-on;
  regulator-min-microvolt = <1200000>;
  regulator-max-microvolt = <1200000>;
  vin-supply = <&vcc_3v3_s3>;
 };

 pre_ict_tester_vcc_2v8: regulator-pre-ict-tester-vcc-2v8 {
  compatible = "regulator-fixed";
  regulator-name = "pre_ict_tester_vcc_2v8";
  regulator-always-on;
  regulator-boot-on;
  regulator-min-microvolt = <2800000>;
  regulator-max-microvolt = <2800000>;
  vin-supply = <&vcc_3v3_s3>;
 };
};

&combphy0_ps {
 status = "okay";
};

&gpio3 {
 pinctrl-0 = <&pre_ict_pwr2gpio>;
 pinctrl-names = "default";
};

&pcie2x1l2 {
 pinctrl-names = "default";
 pinctrl-0 = <&pcie2x1l2_perstn_m0>;
 reset-gpios = <&gpio3 25 0>;
 vpcie3v3-supply = <&vcc_3v3_s3>;
 status = "okay";
};

&pinctrl {
 pcie2x1l2 {
  pcie2x1l2_perstn_m0: pcie2x1l2-perstn-m0 {
   rockchip,pins = <3 25 0 &pcfg_pull_none>;
  };
 };

 pre-ict-tester {
  pre_ict_pwr2gpio: pre-ict-pwr2gpio-pins {
   rockchip,pins =
# 86 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso"
    <3 3 0 &pcfg_pull_up>,
# 95 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso"
    <3 4 0 &pcfg_pull_down>,
# 111 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso"
    <3 10 0 &pcfg_pull_up>,
# 128 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso"
    <3 22 0 &pcfg_pull_down>,
# 138 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso"
    <3 26 0 &pcfg_pull_down>,
# 148 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso"
    <3 27 0 &pcfg_pull_down>,
# 158 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso"
    <3 28 0 &pcfg_pull_down>,
# 168 "arch/arm64/boot/dts/rockchip/rk3588-jaguar-pre-ict-tester.dtso"
    <3 29 0 &pcfg_pull_down>;
  };
 };
};
