 status = "okay";
};

&u2phy0 {
 status = "okay";
};

&u2phy0_otg {
 phy-supply = <&vbus5v0_typec>;
 status = "okay";
};

&u2phy1 {
 status = "okay";
};

&u2phy1_otg {
