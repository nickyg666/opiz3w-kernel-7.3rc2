&i2c2 {
 status = "okay";

 hym8563: rtc@51 {
  compatible = "haoyu,hym8563";
  reg = <0x51>;
  clock-output-names = "hym8563";
  interrupt-parent = <&gpio0>;
  interrupts = <0 8>;
  pinctrl-names = "default";
  pinctrl-0 = <&rtc_int>;
  wakeup-source;
  #clock-cells = <0>;
 };
};

&i2c3 {
 status = "okay";

 es8388: audio-codec@10 {
  compatible = "everest,es8388", "everest,es8328";
  reg = <0x10>;
  AVDD-supply = <&vcca_3v3_s0>;
  DVDD-supply = <&vcc_1v8_s0>;
  HPVDD-supply = <&vcca_3v3_s0>;
  PVDD-supply = <&vcc_1v8_s0>;
  assigned-clocks = <&cru 572>;
  assigned-clock-rates = <12288000>;
  clocks = <&cru 572>;
  pinctrl-names = "default";
  pinctrl-0 = <&sai1m0_mclk>;
  #sound-dai-cells = <0>;
 };
};

&mdio0 {
 rgmii_phy0: ethernet-phy@1 {
  compatible = "ethernet-phy-id001c.c916";
  reg = <0x1>;
  clocks = <&cru 43>;
  assigned-clocks = <&cru 43>;
  assigned-clock-rates = <25000000>;
  pinctrl-names = "default";
  pinctrl-0 = <&rgmii_phy0_rst>;
  reset-assert-us = <20000>;
  reset-deassert-us = <100000>;
  reset-gpios = <&gpio2 13 1>;
 };
};

&mdio1 {
 rgmii_phy1: ethernet-phy@1 {
  compatible = "ethernet-phy-id001c.c916";
  reg = <0x1>;
  clocks = <&cru 44>;
  assigned-clocks = <&cru 44>;
  assigned-clock-rates = <25000000>;
  pinctrl-names = "default";
  pinctrl-0 = <&rgmii_phy1_rst>;
  reset-assert-us = <20000>;
  reset-deassert-us = <100000>;
  reset-gpios = <&gpio3 3 1>;
 };
};

&pcie0 {
 pinctrl-names = "default";
 pinctrl-0 = <&pcie0_rst>;
 reset-gpios = <&gpio2 12 0>;
 vpcie3v3-supply = <&vcc_3v3_s3>;
 status = "okay";

 pcie@0,0 {
  reg = <0x0 0 0 0 0>;
  bus-range = <0x0 0xf>;
  device_type = "pci";
  ranges;
  #address-cells = <3>;
  #size-cells = <2>;

  wifi: wifi@0,0 {
   compatible = "pci14e4,449d";
   reg = <0x10000 0 0 0 0>;
   clocks = <&hym8563>;
   clock-names = "lpo";
  };
 };
};

&pcie1 {
 reset-gpios = <&gpio4 20 0>;
 vpcie3v3-supply = <&vcc3v3_pcie1>;





 status = "disabled";
};

&pinctrl {
 audio {
  hp_det: hp-det {
   rockchip,pins = <0 27 0 &pcfg_pull_up>;
  };

  hp_ctl: hp-ctl {
   rockchip,pins = <3 30 0 &pcfg_pull_down>;
  };

  spk_ctl: spk-ctl {
   rockchip,pins = <2 9 0 &pcfg_pull_none>;
  };
 };

 bluetooth {
  bt_reg_on: bt-reg-on {
   rockchip,pins = <1 23 0 &pcfg_pull_up>;
  };

  bt_wake_host: bt-wake-host {
   rockchip,pins = <0 9 0 &pcfg_pull_down>;
  };

  host_wake_bt: host-wake-bt {
   rockchip,pins = <1 28 0 &pcfg_pull_up>;
  };
 };

 hdmi {
  hdmi_tx_on_h: hdmi-tx-on-h {
   rockchip,pins = <2 8 0 &pcfg_pull_none>;
  };
 };

 hym8563 {
  rtc_int: rtc-int {
   rockchip,pins = <0 0 0 &pcfg_pull_up>;
  };
 };

 network {
  rgmii_phy0_rst: rgmii-phy0-rst {
   rockchip,pins = <2 13 0 &pcfg_pull_none>;
  };

  rgmii_phy1_rst: rgmii-phy1-rst {
   rockchip,pins = <3 3 0 &pcfg_pull_none>;
  };
 };

 pcie0 {
  pcie0_rst: pcie0-rst {
   rockchip,pins = <2 12 0 &pcfg_pull_none>;
  };
 };

 sdmmc {
  sdmmc_pwren: sdmmc-pwren {
   rockchip,pins = <0 14 0 &pcfg_pull_none>;
  };
 };

 usb {
  usb_host_pwren: usb-host-pwren {
   rockchip,pins = <0 23 0 &pcfg_pull_none>;
  };

  usb_otg0_pwren: usb-otg0-pwren {
   rockchip,pins = <0 25 0 &pcfg_pull_none>;
  };

  usbc0_int: usbc0-int {
   rockchip,pins = <0 5 0 &pcfg_pull_up>;
  };
 };

 wifi {
  wifi_reg_on: wifi-reg-on {
   rockchip,pins = <1 22 0 &pcfg_pull_up>;
  };

  wifi_wake_host: wifi-wake-host {
   rockchip,pins = <0 8 0 &pcfg_pull_down>;
  };
 };
};

&sai1 {
 pinctrl-names = "default";
 pinctrl-0 = <&sai1m0_lrck
       &sai1m0_sclk
       &sai1m0_sdi0
       &sai1m0_sdo0>;
 status = "okay";
