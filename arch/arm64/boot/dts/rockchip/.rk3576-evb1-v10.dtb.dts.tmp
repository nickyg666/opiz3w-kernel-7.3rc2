  cru: clock-controller@27200000 {
   compatible = "rockchip,rk3576-cru";
   reg = <0x0 0x27200000 0x0 0x50000>;
   #clock-cells = <1>;
   #reset-cells = <1>;

   assigned-clocks =
    <&cru 542>,
    <&cru 5>, <&cru 4>,
    <&cru 3>, <&cru 27>,
    <&cru 28>, <&cru 29>,
    <&cru 23>, <&cru 24>,
    <&cru 17>, <&cru 13>,
    <&cru 10>, <&cru 221>,
    <&cru 255>;
   assigned-clock-parents = <&cru 3>;
   assigned-clock-rates =
    <0>,
    <1188000000>, <1000000000>,
    <786432000>, <18432000>,
    <96000000>, <128000000>,
    <45158400>, <49152000>,
    <500000000>, <250000000>,
    <100000000>, <500000000>,
    <250000000>;
  };

  i2c0: i2c@27300000 {
   compatible = "rockchip,rk3576-i2c", "rockchip,rk3399-i2c";
   reg = <0x0 0x27300000 0x0 0x1000>;
   clocks = <&cru 494>, <&cru 493>;
   clock-names = "i2c", "pclk";
   interrupts = <0 88 4>;
   pinctrl-names = "default";
   pinctrl-0 = <&i2c0m0_xfer>;
   #address-cells = <1>;
   #size-cells = <0>;
