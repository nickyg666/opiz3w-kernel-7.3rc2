     <&cru 391>,
     <&cru 392>,
     <&cru 393>,
     <&hdptxphy>;
   clock-names = "aclk",
          "hclk",
          "dclk_vp0",
          "dclk_vp1",
          "dclk_vp2",
          "pll_hdmiphy0";
   iommus = <&vop_mmu>;
   power-domains = <&power 18>;
   rockchip,grf = <&sys_grf>;
   rockchip,pmu = <&pmu>;
   status = "disabled";

   vop_out: ports {
    #address-cells = <1>;
    #size-cells = <0>;

    vp0: port@0 {
     #address-cells = <1>;
     #size-cells = <0>;
     reg = <0>;
    };

    vp1: port@1 {
     #address-cells = <1>;
     #size-cells = <0>;
     reg = <1>;
    };

    vp2: port@2 {
     #address-cells = <1>;
     #size-cells = <0>;
     reg = <2>;
    };
   };
  };

