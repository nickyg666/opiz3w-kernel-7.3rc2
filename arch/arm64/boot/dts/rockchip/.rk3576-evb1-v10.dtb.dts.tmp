  vdec_mmu: iommu@27b00800 {
   compatible = "rockchip,rk3576-iommu", "rockchip,rk3568-iommu";
   reg = <0x0 0x27b00800 0x0 0x40>, <0x0 0x27b00900 0x0 0x40>;
   interrupts = <0 309 4>;
   clocks = <&cru 320>, <&cru 318>;
   clock-names = "aclk", "iface";
