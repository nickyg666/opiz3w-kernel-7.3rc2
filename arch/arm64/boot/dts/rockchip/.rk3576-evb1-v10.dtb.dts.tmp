  gic: interrupt-controller@2a701000 {
   compatible = "arm,gic-400";
   reg = <0x0 0x2a701000 0 0x10000>,
         <0x0 0x2a702000 0 0x10000>,
         <0x0 0x2a704000 0 0x10000>,
         <0x0 0x2a706000 0 0x10000>;
   interrupts = <1 9 ((((1 << (8)) - 1) << 8) | 8)>;
