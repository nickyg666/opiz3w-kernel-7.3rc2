   dmas = <&dmac0 8>, <&dmac0 9>;
   interrupts = <0 77 4>;
   pinctrl-names = "default";
   pinctrl-0 = <&uart1m0_xfer>;
   status = "disabled";
  };

  pmu: power-management@27380000 {
   compatible = "rockchip,rk3576-pmu", "syscon", "simple-mfd";
   reg = <0x0 0x27380000 0x0 0x800>;

   power: power-controller {
    compatible = "rockchip,rk3576-power-controller";
    #power-domain-cells = <1>;
    #address-cells = <1>;
    #size-cells = <0>;

    power-domain@0 {
     reg = <0>;
     #power-domain-cells = <1>;
     #address-cells = <1>;
     #size-cells = <0>;

     power-domain@1 {
      reg = <1>;
      clocks = <&cru 229>,
        <&cru 230>,
        <&cru 240>,
        <&cru 232>,
        <&cru 244>,
        <&cru 231>,
        <&cru 241>,
        <&cru 233>;
      pm_qos = <&qos_npu_mcu>,
        <&qos_npu_nsp0>,
        <&qos_npu_nsp1>,
        <&qos_npu_m0ro>,
        <&qos_npu_m1ro>;
      #power-domain-cells = <1>;
      #address-cells = <1>;
      #size-cells = <0>;

      power-domain@2 {
       reg = <2>;
       clocks = <&cru 231>,
         <&cru 229>;
       pm_qos = <&qos_npu_m0>;
       #power-domain-cells = <0>;
      };
      power-domain@3 {
       reg = <3>;
       clocks = <&cru 231>,
         <&cru 230>;
       pm_qos = <&qos_npu_m1>;
       #power-domain-cells = <0>;
      };
     };
    };

    power-domain@4 {
     reg = <4>;
     clocks = <&cru 448>, <&cru 449>;
     pm_qos = <&qos_gpu>;
     #power-domain-cells = <0>;
    };

    power-domain@5 {
     reg = <5>;
     clocks = <&cru 251>, <&cru 250>;
     pm_qos = <&qos_emmc>,
       <&qos_fspi0>;
     #power-domain-cells = <1>;
     #address-cells = <1>;
     #size-cells = <0>;

     power-domain@6 {
      reg = <6>;
      clocks = <&cru 307>,
        <&cru 286>,
        <&cru 287>,
        <&cru 290>,
        <&cru 296>,
        <&cru 304>,
        <&cru 291>,
        <&cru 297>,
        <&cru 285>;
      pm_qos = <&qos_fspi1>,
        <&qos_gmac0>,
        <&qos_gmac1>,
        <&qos_sdio>,
        <&qos_sdmmc>,
        <&qos_flexbus>;
      #power-domain-cells = <0>;
     };
    };

    power-domain@8 {
     reg = <8>;
     clocks = <&cru 255>,
       <&cru 254>,
       <&cru 264>,
       <&cru 266>;
     pm_qos = <&qos_mmu0>,
       <&qos_mmu1>;
     #power-domain-cells = <1>;
     #address-cells = <1>;
     #size-cells = <0>;

     power-domain@9 {
      reg = <9>;
      #power-domain-cells = <0>;
     };
    };

    power-domain@10 {
     reg = <10>;
     #power-domain-cells = <0>;
    };

    power-domain@12 {
     reg = <12>;
     clocks = <&cru 461>,
       <&cru 460>;
     pm_qos = <&qos_vepu1>;
     #power-domain-cells = <0>;
    };

    power-domain@13 {
     reg = <13>;
     clocks = <&cru 348>,
       <&cru 347>,
       <&cru 338>,
       <&cru 339>,
       <&cru 336>,
       <&cru 335>,
       <&cru 344>,
       <&cru 343>,
       <&cru 341>,
       <&cru 340>;
     pm_qos = <&qos_ebc>,
       <&qos_jpeg>,
       <&qos_rga0>,
       <&qos_rga1>,
       <&qos_vdpp>;
     #power-domain-cells = <0>;
    };

    power-domain@14 {
     reg = <14>;
     clocks = <&cru 317>,
       <&cru 318>;
     pm_qos = <&qos_rkvdec>;
     #power-domain-cells = <0>;
    };

    power-domain@15 {
     reg = <15>;
     clocks = <&cru 359>,
       <&cru 360>,
       <&cru 358>,
       <&cru 355>,
       <&cru 356>,
       <&cru 357>,
       <&cru 361>,
       <&cru 364>,
       <&cru 365>,
       <&cru 368>,
       <&cru 366>,
       <&cru 367>;
     pm_qos = <&qos_isp_mro>,
       <&qos_isp_mwo>,
       <&qos_vicap_m0>,
       <&qos_vpss_mro>,
       <&qos_vpss_mwo>;
     #power-domain-cells = <1>;
     #address-cells = <1>;
     #size-cells = <0>;

     power-domain@11 {
      reg = <11>;
      clocks = <&cru 353>,
        <&cru 352>;
      pm_qos = <&qos_vepu0>;
      #power-domain-cells = <0>;
     };
    };

    power-domain@18 {
     reg = <18>;
     clocks = <&cru 387>,
       <&cru 386>,
       <&cru 384>,
       <&cru 385>;
     pm_qos = <&qos_vop_m0>,
       <&qos_vop_m1ro>;
     #power-domain-cells = <1>;
     #address-cells = <1>;
     #size-cells = <0>;

     power-domain@7 {
      reg = <7>;
      clocks = <&cru 254>,
        <&cru 322>,
        <&cru 327>,
        <&cru 328>,
        <&cru 329>;
      pm_qos = <&qos_mmu2>,
        <&qos_ufshc>;
      #power-domain-cells = <0>;
     };

     power-domain@16 {
      reg = <16>;
      clocks = <&cru 399>,
        <&cru 400>,
        <&cru 395>,
        <&cru 397>,
        <&cru 384>;
      pm_qos = <&qos_hdcp0>;
      #power-domain-cells = <0>;
     };

     power-domain@17 {
      reg = <17>;
      clocks = <&cru 438>,
        <&cru 439>,
        <&cru 424>,
        <&cru 426>,
        <&cru 384>;
      pm_qos = <&qos_hdcp1>;
      #power-domain-cells = <0>;
     };
    };
   };
  };

  gpu: gpu@27800000 {
   compatible = "rockchip,rk3576-mali", "arm,mali-bifrost";
   reg = <0x0 0x27800000 0x0 0x20000>;
   assigned-clocks = <&scmi_clk 456>;
