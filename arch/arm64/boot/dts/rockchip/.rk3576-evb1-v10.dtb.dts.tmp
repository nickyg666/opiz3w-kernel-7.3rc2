  vop: vop@27d00000 {
   compatible = "rockchip,rk3576-vop";
   reg = <0x0 0x27d00000 0x0 0x3000>, <0x0 0x27d05000 0x0 0x1000>;
   reg-names = "vop", "gamma-lut";
   interrupts = <0 342 4>,
         <0 379 4>,
         <0 380 4>,
         <0 381 4>;
   interrupt-names = "sys",
       "vp0",
       "vp1",
       "vp2";
   clocks = <&cru 387>,
