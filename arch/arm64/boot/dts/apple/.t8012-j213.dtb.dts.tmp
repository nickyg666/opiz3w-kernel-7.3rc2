# 303 "arch/arm64/boot/dts/apple/t8012.dtsi" 2
# 12 "arch/arm64/boot/dts/apple/t8012-jxxx.dtsi" 2

/ {
 chassis-type = "embedded";

 aliases {
  serial0 = &serial0;
 };

 chosen {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  stdout-path = "serial0";
 };

 memory@800000000 {
  device_type = "memory";
  reg = <0x8 0 0 0>;
 };

 reserved-memory {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;


 };
};

&serial0 {
 status = "okay";
};
# 10 "arch/arm64/boot/dts/apple/t8012-j213.dts" 2
# 1 "arch/arm64/boot/dts/apple/t8012-touchbar.dtsi" 1
# 10 "arch/arm64/boot/dts/apple/t8012-touchbar.dtsi"
/ {
 chosen {
  framebuffer0: framebuffer@0 {
   compatible = "apple,simple-framebuffer", "simple-framebuffer";
   reg = <0 0 0 0>;
   power-domains = <&ps_disp0_fe &ps_disp0_be &ps_mipi_dsi>;

   status = "disabled";
  };
 };
};
# 11 "arch/arm64/boot/dts/apple/t8012-j213.dts" 2

/ {
 model = "Apple T2 MacBookPro15,4 (j213)";
 compatible = "apple,j213", "apple,t8012", "apple,arm-platform";
};
