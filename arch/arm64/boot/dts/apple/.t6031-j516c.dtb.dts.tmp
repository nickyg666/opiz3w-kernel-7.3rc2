# 1 "arch/arm64/boot/dts/apple/t6031-gpio-pins.dtsi" 1







&pinctrl_ap {
 i2c0_pins: i2c0-pins {
  pinmux = <((56) | ((1) << 16))>,
   <((57) | ((1) << 16))>;
 };

 i2c1_pins: i2c1-pins {
  pinmux = <((58) | ((1) << 16))>,
   <((59) | ((1) << 16))>;
 };

 i2c2_pins: i2c2-pins {
  pinmux = <((60) | ((1) << 16))>,
   <((61) | ((1) << 16))>;
 };

 i2c3_pins: i2c3-pins {
  pinmux = <((62) | ((1) << 16))>,
   <((63) | ((1) << 16))>;
 };

 i2c4_pins: i2c4-pins {
  pinmux = <((64) | ((1) << 16))>,
   <((65) | ((1) << 16))>;
 };

 i2c5_pins: i2c5-pins {
  pinmux = <((66) | ((1) << 16))>,
   <((67) | ((1) << 16))>;
 };

 i2c6_pins: i2c6-pins {
  pinmux = <((68) | ((1) << 16))>,
   <((69) | ((1) << 16))>;
 };

 i2c7_pins: i2c7-pins {
  pinmux = <((70) | ((1) << 16))>,
   <((71) | ((1) << 16))>;
 };

 i2c8_pins: i2c8-pins {
  pinmux = <((72) | ((1) << 16))>,
   <((73) | ((1) << 16))>;
 };
};
