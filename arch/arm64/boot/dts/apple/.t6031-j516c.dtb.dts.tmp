   d-cache-size = <0x20000>;
  };

  cpu_p10: cpu@10200 {
   compatible = "apple,everest";
   device_type = "cpu";
   reg = <0x0 0x10200>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_2>;
   i-cache-size = <0x30000>;
   d-cache-size = <0x20000>;
  };

  cpu_p11: cpu@10201 {
   compatible = "apple,everest";
   device_type = "cpu";
   reg = <0x0 0x10201>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
   next-level-cache = <&l2_cache_2>;
   i-cache-size = <0x30000>;
   d-cache-size = <0x20000>;
  };

  cpu_p12: cpu@10202 {
   compatible = "apple,everest";
   device_type = "cpu";
   reg = <0x0 0x10202>;
   enable-method = "spin-table";
   cpu-release-addr = <0 0>;
