 pinctrl_nub: pinctrl@2a01f0000 {
  compatible = "apple,t6031-pinctrl", "apple,t8103-pinctrl";
  reg = <0x2 0xa01f0000 0x0 0x4000>;
  power-domains = <&ps_nub_gpio>;

  gpio-controller;
  #gpio-cells = <2>;
  gpio-ranges = <&pinctrl_nub 0 0 59>;
  apple,npins = <59>;

  interrupt-controller;
  #interrupt-cells = <2>;
  interrupt-parent = <&aic>;
  interrupts = <0 0 710 4>,
    <0 0 711 4>,
    <0 0 712 4>,
    <0 0 713 4>,
    <0 0 714 4>,
    <0 0 715 4>,
