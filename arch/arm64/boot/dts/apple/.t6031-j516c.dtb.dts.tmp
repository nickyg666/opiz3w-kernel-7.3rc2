&pmgr {
 ps_ispsens0: power-controller@100 {
  compatible = "apple,t6031-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
  reg = <0x100 4>;
  #power-domain-cells = <0>;
  #reset-cells = <0>;
  label = "ispsens0";
 };

 ps_apcie_gp: power-controller@108 {
  compatible = "apple,t6031-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
  reg = <0x108 4>;
  #power-domain-cells = <0>;
  #reset-cells = <0>;
  label = "apcie_gp";
 };

 ps_apcie_ge: power-controller@110 {
  compatible = "apple,t6031-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
  reg = <0x110 4>;
  #power-domain-cells = <0>;
  #reset-cells = <0>;
  label = "apcie_ge";
 };

 ps_apcie_st: power-controller@118 {
  compatible = "apple,t6031-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
  reg = <0x118 4>;
  #power-domain-cells = <0>;
  #reset-cells = <0>;
  label = "apcie_st";
 };

 ps_afnc3_ioa: power-controller@120 {
  compatible = "apple,t6031-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
  reg = <0x120 4>;
  #power-domain-cells = <0>;
  #reset-cells = <0>;
  label = "afnc3_ioa";
  apple,always-on;
 };

 ps_afnc3_ls: power-controller@128 {
  compatible = "apple,t6031-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
  reg = <0x128 4>;
  #power-domain-cells = <0>;
  #reset-cells = <0>;
  label = "afnc3_ls";
  apple,always-on;
  power-domains = <&ps_afnc3_ioa>;
 };

 ps_afnc3_lw0: power-controller@138 {
