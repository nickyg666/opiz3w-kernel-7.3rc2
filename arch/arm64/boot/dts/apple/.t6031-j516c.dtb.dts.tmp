 };

 serial0: serial@391200000 {
  compatible = "apple,s5l-uart";
  reg = <0x3 0x91200000 0x0 0x4000>;
  reg-io-width = <4>;
  interrupt-parent = <&aic>;
  interrupts = <0 0 1303 4>;




  clocks = <&clkref>, <&clkref>;
