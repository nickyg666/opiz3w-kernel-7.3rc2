# 46 "arch/arm64/boot/dts/apple/t6031.dtsi" 2
# 13 "arch/arm64/boot/dts/apple/t6031-j516c.dts" 2
# 1 "arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi" 1
# 18 "arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/leds/common.h" 1
# 19 "arch/arm64/boot/dts/apple/t603x-j514-j516.dtsi" 2

/ {
 chassis-type = "laptop";

 aliases {
  serial0 = &serial0;
 };

 chosen {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  stdout-path = "serial0";

  framebuffer0: framebuffer@0 {
   compatible = "apple,simple-framebuffer", "simple-framebuffer";
   reg = <0 0 0 0>;

   status = "disabled";
   power-domains = <&ps_disp_fe>;
  };
 };

 memory@10000000000 {
  device_type = "memory";
  reg = <0x100 0 0x2 0>;
 };

 led-controller {
  compatible = "pwm-leds";
  led-0 {
   pwms = <&fpwm0 0 40000>;
   function = "kbd_backlight";
   color = <0>;
   max-brightness = <255>;
   default-state = "keep";
  };
 };
};

&serial0 {
 status = "okay";
};

&fpwm0 {
 status = "okay";
};
# 14 "arch/arm64/boot/dts/apple/t6031-j516c.dts" 2

/ {
 compatible = "apple,j516c", "apple,t6031", "apple,arm-platform";
 model = "Apple MacBook Pro (16-inch, M3 Max, 16 CPU cores, Nov 2023)";
};
