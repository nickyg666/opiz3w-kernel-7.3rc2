  i3c0: i3c@80500400 {
   compatible = "axiado,ax3000-i3c", "cdns,i3c-master";
   reg = <0x00 0x80500400 0x00 0x400>;
   clocks = <&refclk &clk_xin>;
   clock-names = "pclk", "sysclk";
   interrupt-parent = <&gic500>;
   interrupts = <0 76 4>;
   i2c-scl-hz = <100000>;
   i3c-scl-hz = <400000>;
   #address-cells = <3>;
   #size-cells = <0>;
   status = "disabled";
  };

  i3c1: i3c@80500800 {
   compatible = "axiado,ax3000-i3c", "cdns,i3c-master";
   reg = <0x00 0x80500800 0x00 0x400>;
