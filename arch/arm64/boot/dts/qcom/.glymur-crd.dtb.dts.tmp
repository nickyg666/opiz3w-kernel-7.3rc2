    interrupts-extended = <&mdss 12>;

    clocks = <&dispcc 6>,
      <&dispcc 16>,
      <&dispcc 18>,
      <&dispcc 23>,
      <&dispcc 24>,
      <&dispcc 26>;
    clock-names = "core_iface",
           "core_aux",
           "ctrl_link",
