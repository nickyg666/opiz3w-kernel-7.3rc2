  usb_hs: usb@a200000 {
   compatible = "qcom,glymur-dwc3", "qcom,snps-dwc3";
   reg = <0x0 0x0a200000 0x0 0xfc100>;

   clocks = <&gcc 35>,
     <&gcc 296>,
     <&gcc 17>,
     <&gcc 301>,
     <&gcc 298>,
     <&gcc 40>,
     <&gcc 41>;
   clock-names = "cfg_noc",
          "core",
          "iface",
          "sleep",
          "mock_utmi",
          "noc_aggr_north",
          "noc_aggr_south";

   assigned-clocks = <&gcc 298>,
       <&gcc 296>;
   assigned-clock-rates = <19200000>, <200000000>;

   interrupts-extended = <&intc 0 240 4>,
           <&intc 0 246 4>,
           <&pdc 92 (2 | 1)>,
           <&pdc 57 (2 | 1)>,
           <&intc 0 239 4>;
   interrupt-names = "dwc_usb3",
       "pwr_event",
       "dp_hs_phy_irq",
       "dm_hs_phy_irq",
       "hs_phy_irq";

   resets = <&gcc 65>;

   power-domains = <&gcc 14>;
   required-opps = <&rpmhpd_opp_nom>;

   iommus = <&apps_smmu 0x0ce0 0x0>;

   interconnects = <&aggre3_noc 7 ((1 << 0) | (1 << 1) | (1 << 2))
      &mc_virt 1 ((1 << 0) | (1 << 1) | (1 << 2))>,
     <&hsc_noc 3 ((1 << 0) | (1 << 1))
      &config_noc 34 ((1 << 0) | (1 << 1))>;
   interconnect-names = "usb-ddr",
          "apps-usb";

   phys = <&usb_hs_phy>;
   phy-names = "usb2-phy";

   snps,hird-threshold = /bits/ 8 <0x0>;
   snps,dis-u1-entry-quirk;
   snps,dis-u2-entry-quirk;
   snps,is-utmi-l1-suspend;
   snps,usb3_lpm_capable;
   snps,has-lpm-erratum;
   tx-fifo-resize;
   snps,dis_u2_susphy_quirk;
   snps,dis_enblslpm_quirk;

   maximum-speed = "high-speed";

   qcom,select-utmi-as-pipe-clk;
   usb-role-switch;
   wakeup-source;

   status = "disabled";
  };

  usb_mp: usb@a400000 {
   compatible = "qcom,glymur-dwc3-mp", "qcom,snps-dwc3";
   reg = <0x0 0x0a400000 0x0 0xfc100>;

   clocks = <&gcc 36>,
     <&gcc 302>,
     <&gcc 18>,
     <&gcc 307>,
     <&gcc 304>,
     <&gcc 40>,
     <&gcc 41>;
   clock-names = "cfg_noc",
          "core",
          "iface",
          "sleep",
          "mock_utmi",
          "noc_aggr_north",
          "noc_aggr_south";

   interrupts-extended = <&intc 0 132 4>,
           <&intc 0 345 4>,
           <&intc 0 346 4>,
           <&intc 0 162 4>,
           <&intc 0 163 4>,
           <&pdc 12 4>,
           <&pdc 11 4>,
           <&pdc 14 4>,
           <&pdc 13 4>,
           <&pdc 78 4>,
           <&pdc 77 4>;
   interrupt-names = "dwc_usb3",
       "pwr_event_1",
       "pwr_event_2",
       "hs_phy_1",
       "hs_phy_2",
       "dp_hs_phy_1",
       "dm_hs_phy_1",
       "dp_hs_phy_2",
       "dm_hs_phy_2",
       "ss_phy_1",
       "ss_phy_2";

   resets = <&gcc 66>;
   power-domains = <&gcc 15>;

   iommus = <&apps_smmu 0xda0 0x0>;

   phys = <&usb_mp_hsphy0>,
          <&usb_mp_qmpphy0>,
          <&usb_mp_hsphy1>,
          <&usb_mp_qmpphy1>;
   phy-names = "usb2-0",
        "usb3-0",
        "usb2-1",
        "usb3-1";

   snps,hird-threshold = /bits/ 8 <0x0>;
   snps,dis-u1-entry-quirk;
   snps,dis-u2-entry-quirk;
   snps,is-utmi-l1-suspend;
   snps,usb3_lpm_capable;
   snps,has-lpm-erratum;
   tx-fifo-resize;
   snps,dis_u2_susphy_quirk;
   snps,dis_enblslpm_quirk;

   dr_mode = "host";
   wakeup-source;

   status = "disabled";
  };

  camcc: clock-controller@ade0000 {
   compatible = "qcom,glymur-camcc";
   reg = <0x0 0x0ade0000 0x0 0x20000>;
   clocks = <&gcc 29>,
     <&rpmhcc 0>,
     <&rpmhcc 1>,
     <&sleep_clk>;
   power-domains = <&rpmhpd 10>,
     <&rpmhpd 6>;
   required-opps = <&rpmhpd_opp_low_svs>,
     <&rpmhpd_opp_low_svs>;
   #clock-cells = <1>;
   #reset-cells = <1>;
   #power-domain-cells = <1>;
  };

  mdss: display-subsystem@ae00000 {
   compatible = "qcom,glymur-mdss";
   reg = <0x0 0x0ae00000 0x0 0x1000>;
   reg-names = "mdss";

   interrupts = <0 83 4>;

   clocks = <&dispcc 6>,
     <&gcc 43>,
     <&dispcc 70>;

   resets = <&dispcc 0>;

   interconnects = <&mmss_noc 5 ((1 << 0) | (1 << 1) | (1 << 2))
      &mc_virt 1 ((1 << 0) | (1 << 1) | (1 << 2))>,
     <&hsc_noc 3 ((1 << 0) | (1 << 1))
      &config_noc 9 ((1 << 0) | (1 << 1))>;
   interconnect-names = "mdp0-mem",
          "cpu-cfg";

   power-domains = <&dispcc 0>;

   iommus = <&apps_smmu 0x1de0 0x2>;

   interrupt-controller;
   #interrupt-cells = <1>;

   #address-cells = <2>;
   #size-cells = <2>;
   ranges;

   status = "disabled";

   mdss_mdp: display-controller@ae01000 {
    compatible = "qcom,glymur-dpu";
    reg = <0x0 0x0ae01000 0x0 0x93000>,
          <0x0 0x0aeb0000 0x0 0x3000>;
    reg-names = "mdp",
         "vbif";

    interrupts-extended = <&mdss 0>;

    clocks = <&gcc 43>,
      <&dispcc 6>,
      <&dispcc 73>,
      <&dispcc 70>,
      <&dispcc 84>;
    clock-names = "nrt_bus",
           "iface",
           "lut",
           "core",
           "vsync";

    operating-points-v2 = <&mdp_opp_table>;

    power-domains = <&rpmhpd 6>;

    ports {
     #address-cells = <1>;
     #size-cells = <0>;

     port@0 {
      reg = <0>;

      dpu_intf0_out: endpoint {
       remote-endpoint = <&mdss_dp0_in>;
      };
     };

     port@4 {
      reg = <4>;

      mdss_intf4_out: endpoint {
       remote-endpoint = <&mdss_dp1_in>;
      };
     };

     port@5 {
      reg = <5>;

      mdss_intf5_out: endpoint {
       remote-endpoint = <&mdss_dp3_in>;
      };
     };

     port@6 {
      reg = <6>;

      mdss_intf6_out: endpoint {
       remote-endpoint = <&mdss_dp2_in>;
      };
     };
    };

    mdp_opp_table: opp-table {
     compatible = "operating-points-v2";

     opp-156000000 {
      opp-hz = /bits/ 64 <156000000>;
      required-opps = <&rpmhpd_opp_low_svs_d1>;
     };

     opp-205000000 {
      opp-hz = /bits/ 64 <205000000>;
      required-opps = <&rpmhpd_opp_low_svs>;
     };

     opp-337000000 {
      opp-hz = /bits/ 64 <337000000>;
      required-opps = <&rpmhpd_opp_svs>;
     };

     opp-417000000 {
      opp-hz = /bits/ 64 <417000000>;
      required-opps = <&rpmhpd_opp_svs_l1>;
     };

     opp-532000000 {
      opp-hz = /bits/ 64 <532000000>;
      required-opps = <&rpmhpd_opp_nom>;
     };

     opp-600000000 {
      opp-hz = /bits/ 64 <600000000>;
      required-opps = <&rpmhpd_opp_nom_l1>;
     };

     opp-660000000 {
      opp-hz = /bits/ 64 <660000000>;
      required-opps = <&rpmhpd_opp_turbo>;
     };

     opp-717000000 {
      opp-hz = /bits/ 64 <717000000>;
      required-opps = <&rpmhpd_opp_turbo_l1>;
     };
    };
   };

   mdss_dp0: displayport-controller@af54000 {
    compatible = "qcom,glymur-dp";
    reg = <0x0 0xaf54000 0x0 0x200>,
          <0x0 0xaf54200 0x0 0x200>,
          <0x0 0xaf55000 0x0 0xc00>,
          <0x0 0xaf56000 0x0 0x400>,
