    assigned-clock-parents = <&usb_0_qmpphy 1>,
        <&usb_0_qmpphy 2>,
        <&usb_0_qmpphy 2>;

    operating-points-v2 = <&mdss_dp0_opp_table>;

    power-domains = <&rpmhpd 6>;

