 qcom,tune-usb2-preem = /bits/ 8 <0x6>;
};

&pmr735b_gpios {
 s1j_enable_default: s1j-enable-default-state {
  pins = "gpio1";
  function = "normal";
  power-source = <0>;
  bias-disable;
  output-low;
 };

 pm8008_reset_n_default: pm8008-reset-n-default-state {
  pins = "gpio3";
  function = "normal";
  bias-pull-down;
 };
};

&pm7550_gpios {
 volume_up_default: volume-up-default-state {
  pins = "gpio6";
  function = "normal";
  power-source = <1>;
  bias-pull-up;
 };
};

