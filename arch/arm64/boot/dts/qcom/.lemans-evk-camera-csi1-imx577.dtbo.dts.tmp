# 0 "arch/arm64/boot/dts/qcom/lemans-evk-camera-csi1-imx577.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/qcom/lemans-evk-camera-csi1-imx577.dtso"





/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/clock/qcom,sa8775p-camcc.h" 1
# 10 "arch/arm64/boot/dts/qcom/lemans-evk-camera-csi1-imx577.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 11 "arch/arm64/boot/dts/qcom/lemans-evk-camera-csi1-imx577.dtso" 2

&{/} {
 vreg_cam1_1p8: regulator-cam1 {
  compatible = "regulator-fixed";
  regulator-name = "vreg_cam1";
  startup-delay-us = <10000>;
  enable-active-high;
  gpio = <&pmm8654au_0_gpios 8 0>;
 };
};

&camss {
 vdda-pll-supply = <&vreg_l1c>;
 vdda-phy-supply = <&vreg_l4a>;

 status = "okay";

 ports {
  #address-cells = <1>;
  #size-cells = <0>;

  port@1 {
   reg = <1>;

   csiphy1_ep: endpoint {
    clock-lanes = <7>;
    data-lanes = <0 1 2 3>;
    remote-endpoint = <&imx577_ep1>;
   };
  };
 };
};

&cci1 {
 pinctrl-0 = <&cci1_0_default>;
 pinctrl-1 = <&cci1_0_sleep>;

 status = "okay";
};

&cci1_i2c0 {
 #address-cells = <1>;
 #size-cells = <0>;

 camera@1a {
  compatible = "sony,imx577";
  reg = <0x1a>;

  reset-gpios = <&tlmm 133 1>;
  pinctrl-0 = <&cam1_default>;
  pinctrl-names = "default";

  clocks = <&camcc 60>;
  assigned-clocks = <&camcc 60>;
  assigned-clock-rates = <24000000>;

  dovdd-supply = <&vreg_s4a>;
  avdd-supply = <&vreg_cam1_1p8>;

  port {
   imx577_ep1: endpoint {
    clock-lanes = <7>;
    link-frequencies = /bits/ 64 <600000000>;
    data-lanes = <0 1 2 3>;
    remote-endpoint = <&csiphy1_ep>;
   };
  };
 };
};

&tlmm {
 cam1_default: cam1-default-state {
  mclk-pins {
   pins = "gpio73";
   function = "cam_mclk";
   drive-strength = <2>;
   bias-disable;
  };

  rst-pins {
   pins = "gpio133";
   function = "gpio";
   drive-strength = <2>;
   bias-disable;
  };
 };
};
