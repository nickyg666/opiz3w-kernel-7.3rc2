   };

   i2c22: i2c@1a8c000 {
    compatible = "qcom,geni-i2c";
    reg = <0x0 0x01a8c000 0x0 0x4000>;

    interrupts = <0 859 4>;

    clocks = <&gcc 125>;
    clock-names = "se";

    interconnects = <&clk_virt 4 ((1 << 0) | (1 << 1) | (1 << 2))
       &clk_virt 9 ((1 << 0) | (1 << 1) | (1 << 2))>,
      <&gem_noc 2 ((1 << 0) | (1 << 1))
       &config_noc 22 ((1 << 0) | (1 << 1))>,
      <&aggre_noc 8 ((1 << 0) | (1 << 1) | (1 << 2))
       &mc_virt 1 ((1 << 0) | (1 << 1) | (1 << 2))>;
    interconnect-names = "qup-core",
           "qup-config",
           "qup-memory";

    dmas = <&gpi_dma4 0 3 3>,
           <&gpi_dma4 1 3 3>;
    dma-names = "tx",
         "rx";

    pinctrl-0 = <&qup_i2c22_data_clk>;
    pinctrl-names = "default";

    #address-cells = <1>;
    #size-cells = <0>;

