      <&aggre_noc 8 ((1 << 0) | (1 << 1) | (1 << 2))
       &mc_virt 1 ((1 << 0) | (1 << 1) | (1 << 2))>;
    interconnect-names = "qup-core",
           "qup-config",
           "qup-memory";

    dmas = <&gpi_dma4 0 1 3>,
           <&gpi_dma4 1 1 3>;
    dma-names = "tx",
         "rx";

    pinctrl-0 = <&qup_i2c20_data_clk>;
    pinctrl-names = "default";

    #address-cells = <1>;
    #size-cells = <0>;

    status = "disabled";
   };

   spi20: spi@1a84000 {
    compatible = "qcom,geni-spi";
    reg = <0x0 0x01a84000 0x0 0x4000>;

    interrupts = <0 857 4>;

    clocks = <&gcc 121>;
    clock-names = "se";

    interconnects = <&clk_virt 4 ((1 << 0) | (1 << 1) | (1 << 2))
       &clk_virt 9 ((1 << 0) | (1 << 1) | (1 << 2))>,
      <&gem_noc 2 ((1 << 0) | (1 << 1))
       &config_noc 22 ((1 << 0) | (1 << 1))>;
    interconnect-names = "qup-core",
           "qup-config";

    dmas = <&gpi_dma4 0 1 1>,
           <&gpi_dma4 1 1 1>;
    dma-names = "tx",
         "rx";

    pinctrl-0 = <&qup_spi20_data_clk>, <&qup_spi20_cs>;
    pinctrl-names = "default";

    #address-cells = <1>;
    #size-cells = <0>;

    status = "disabled";
   };

   i2c21: i2c@1a88000 {
    compatible = "qcom,geni-i2c";
    reg = <0x0 0x01a88000 0x0 0x4000>;

    interrupts = <0 858 4>;

    clocks = <&gcc 123>;
    clock-names = "se";

    interconnects = <&clk_virt 4 ((1 << 0) | (1 << 1) | (1 << 2))
       &clk_virt 9 ((1 << 0) | (1 << 1) | (1 << 2))>,
      <&gem_noc 2 ((1 << 0) | (1 << 1))
       &config_noc 22 ((1 << 0) | (1 << 1))>,
      <&aggre_noc 8 ((1 << 0) | (1 << 1) | (1 << 2))
       &mc_virt 1 ((1 << 0) | (1 << 1) | (1 << 2))>;
    interconnect-names = "qup-core",
           "qup-config",
           "qup-memory";

    dmas = <&gpi_dma4 0 2 3>,
           <&gpi_dma4 1 2 3>;
    dma-names = "tx",
         "rx";

    pinctrl-0 = <&qup_i2c21_data_clk>;
    pinctrl-names = "default";

    #address-cells = <1>;
    #size-cells = <0>;

    status = "disabled";
   };

   spi21: spi@1a88000 {
    compatible = "qcom,geni-spi";
    reg = <0x0 0x01a88000 0x0 0x4000>;

    interrupts = <0 858 4>;

    clocks = <&gcc 123>;
    clock-names = "se";

    interconnects = <&clk_virt 4 ((1 << 0) | (1 << 1) | (1 << 2))
       &clk_virt 9 ((1 << 0) | (1 << 1) | (1 << 2))>,
      <&gem_noc 2 ((1 << 0) | (1 << 1))
       &config_noc 22 ((1 << 0) | (1 << 1))>;
    interconnect-names = "qup-core",
           "qup-config";

    dmas = <&gpi_dma4 0 2 1>,
