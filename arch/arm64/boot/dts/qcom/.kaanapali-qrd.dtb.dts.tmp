  sram@14680000 {
   compatible = "qcom,kaanapali-imem", "mmio-sram";
   reg = <0x0 0x14680000 0x0 0x1000>;
   ranges = <0x0 0x0 0x14680000 0x1000>;

   no-memory-wc;

   #address-cells = <1>;
   #size-cells = <1>;

   minidump_config: minidump-sram@1c {
    reg = <0x1c 0x4>;
   };

   pil-sram@94c {
    compatible = "qcom,pil-reloc-info";
    reg = <0x94c 0xc8>;
   };
  };

