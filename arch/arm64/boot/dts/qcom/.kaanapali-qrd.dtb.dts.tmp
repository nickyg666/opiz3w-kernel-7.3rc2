&pmh0101_flash {
 status = "okay";

 led-0 {
  function = "flash";
  function-enumerator = <0>;
  color = <6>;
  led-sources = <1>, <4>;
  led-max-microamp = <500000>;
  flash-max-microamp = <2000000>;
  flash-max-timeout-us = <1280000>;
 };

 led-1 {
  function = "flash";
  function-enumerator = <1>;
  color = <0>;
  led-sources = <2>, <3>;
  led-max-microamp = <500000>;
  flash-max-microamp = <2000000>;
  flash-max-timeout-us = <1280000>;
 };
};

&pmh0101_pwm {
 status = "okay";

 multi-led {
  color = <9>;
  function = "status";

  #address-cells = <1>;
  #size-cells = <0>;

  led@1 {
   reg = <1>;
   color = <1>;
  };

  led@2 {
   reg = <2>;
   color = <2>;
  };

  led@3 {
   reg = <3>;
   color = <3>;
  };
 };
};

&pmih0108_e1_eusb2_repeater {
 vdd18-supply = <&vreg_l15b_1p8>;
 vdd3-supply = <&vreg_l5b_3p1>;
};

&pon_resin {
 linux,code = <114>;

 status = "okay";
};

&sdhc_2 {
 cd-gpios = <&tlmm 55 1>;

 vmmc-supply = <&vreg_l9b_2p9>;
 vqmmc-supply = <&vreg_l8b_1p8>;

 bus-width = <4>;
 no-sdio;
 no-mmc;

 pinctrl-0 = <&sdc2_default>;
 pinctrl-1 = <&sdc2_sleep>;
 pinctrl-names = "default", "sleep";

 status = "okay";
};

&remoteproc_adsp {
 firmware-name = "qcom/kaanapali/adsp.mbn",
   "qcom/kaanapali/adsp_dtb.mbn";

 status = "okay";
};

&remoteproc_cdsp {
 firmware-name = "qcom/kaanapali/cdsp.mbn",
   "qcom/kaanapali/cdsp_dtb.mbn";

 status = "okay";
};

&remoteproc_soccp {
 firmware-name = "qcom/kaanapali/soccp.mbn",
   "qcom/kaanapali/soccp_dtb.mbn";
};

&tlmm {
 gpio-reserved-ranges = <36 4>,
          <74 1>,
          <119 2>,
          <144 4>;

 key_vol_up_default: key-vol-up-default-state {
  pins = "gpio101";
  function = "gpio";
  output-disable;
  bias-pull-up;
 };
};

&uart7 {
 status = "okay";
};

&ufs_mem_hc {
 reset-gpios = <&tlmm 217 1>;

 vcc-supply = <&vreg_l17b_2p5>;
 vcc-max-microamp = <1200000>;
 vccq-supply = <&vreg_l4d_1p2>;
 vccq-max-microamp = <1200000>;

 status = "okay";
};

&ufs_mem_phy {
 vdda-phy-supply = <&vreg_l4g_0p9>;
 vdda-pll-supply = <&vreg_l1d_1p2>;

 status = "okay";
};

&usb {
 status = "okay";
};

&usb_hsphy {
 vdd-supply = <&vreg_l4f_0p8>;
 vdda12-supply = <&vreg_l1d_1p2>;

 phys = <&pmih0108_e1_eusb2_repeater>;

 status = "okay";
};

&usb_dp_qmpphy {
 vdda-phy-supply = <&vreg_l4f_0p8>;
 vdda-pll-supply = <&vreg_l1d_1p2>;

 status = "okay";
};

&usb_dp_qmpphy_out {
 remote-endpoint = <&pmic_glink_ss_in>;
};

&usb_dwc3_hs {
 remote-endpoint = <&pmic_glink_hs_in>;
};
