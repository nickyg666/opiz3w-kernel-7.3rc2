  remoteproc_soccp: remoteproc@d00000 {
   compatible = "qcom,kaanapali-soccp-pas";
   reg = <0x0 0x00d00000 0x0 0x200000>;

   interrupts-extended = <&intc 0 167 1>,
           <&soccp_smp2p_in 0 1>,
           <&soccp_smp2p_in 1 1>,
           <&soccp_smp2p_in 2 1>,
           <&soccp_smp2p_in 3 1>,
           <&soccp_smp2p_in 9 1>;
   interrupt-names = "wdog",
       "fatal",
       "ready",
       "handover",
       "stop-ack",
       "pong";

   clocks = <&rpmhcc 0>;
   clock-names = "xo";

   power-domains = <&rpmhpd 0>,
     <&rpmhpd 8>;
   power-domain-names = "cx",
          "mx";

   memory-region = <&soccp_mem>,
     <&soccp_dtb_mem>;

   qcom,smem-states = <&soccp_smp2p_out 0>,
        <&soccp_smp2p_out 8>;
   qcom,smem-state-names = "stop",
      "ping";

   glink-edge {
    interrupts-extended = <&ipcc 13
            0
            1>;
    mboxes = <&ipcc 13
      0>;
    qcom,remote-pid = <19>;
    label = "soccp";
   };
  };

