  tpdm@1130d000 {
   compatible = "qcom,coresight-tpdm", "arm,primecell";
   reg = <0x0 0x1130d000 0x0 0x1000>;

   clocks = <&aoss_qmp>;
   clock-names = "apb_pclk";
   label = "tpdm_swao_1";

