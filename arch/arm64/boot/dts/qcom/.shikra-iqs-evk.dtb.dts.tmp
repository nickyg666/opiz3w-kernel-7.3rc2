# 0 "arch/arm64/boot/dts/qcom/shikra-iqs-evk.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/qcom/shikra-iqs-evk.dts"





/dts-v1/;

# 1 "arch/arm64/boot/dts/qcom/shikra-iqs-som.dtsi" 1





