     <&camcc 69>,
     <&camcc 28>,
     <&camcc 27>,
     <&camcc 30>,
     <&camcc 31>,
     <&camcc 35>,
     <&camcc 34>,
     <&camcc 37>,
     <&camcc 38>,
     <&camcc 41>,
     <&camcc 43>,
     <&camcc 44>,
     <&camcc 3>,
     <&camcc 0>,
     <&camcc 2>,
     <&camcc 1>,
     <&camcc 23>,
     <&camcc 49>,
     <&camcc 46>,
     <&camcc 47>,
     <&camcc 48>,
     <&camcc 51>,
     <&camcc 53>;
   clock-names = "gcc_ahb",
