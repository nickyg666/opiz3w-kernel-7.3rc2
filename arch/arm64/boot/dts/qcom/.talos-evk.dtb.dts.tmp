   interrupts = <0 464 1 0>,
         <0 466 1 0>,
         <0 468 1 0>,
         <0 477 1 0>,
         <0 478 1 0>,
         <0 479 1 0>,
         <0 465 1 0>,
         <0 467 1 0>,
         <0 469 1 0>,
         <0 459 1 0>,
         <0 461 1 0>,
         <0 463 1 0>,
         <0 475 1 0>,
         <0 474 1 0>,
         <0 476 1 0>;
   interrupt-names = "csid0",
