     <&mmss_noc 2 ((1 << 0) | (1 << 1) | (1 << 2))
      &mc_virt 2 ((1 << 0) | (1 << 1) | (1 << 2))>,
     <&mmss_noc 3 ((1 << 0) | (1 << 1) | (1 << 2))
      &mc_virt 2 ((1 << 0) | (1 << 1) | (1 << 2))>,
     <&mmss_noc 4 ((1 << 0) | (1 << 1) | (1 << 2))
      &mc_virt 2 ((1 << 0) | (1 << 1) | (1 << 2))>;
   interconnect-names = "ahb",
          "hf_0",
          "hf_1",
