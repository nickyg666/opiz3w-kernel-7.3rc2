 vdda-phy-dpdm-supply = <&vreg_l13a>;

 status = "okay";
};

&usb_qmpphy {
 vdda-phy-supply = <&vreg_l5a>;
 vdda-pll-supply = <&vreg_l12a>;

 status = "okay";
