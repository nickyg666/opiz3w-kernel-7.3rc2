    pinctrl-names = "default";

    #address-cells = <1>;
    #size-cells = <0>;

    status = "disabled";
   };

   i2c3: i2c@a8c000 {
    compatible = "qcom,geni-i2c";
    reg = <0x0 0x00a8c000 0x0 0x4000>;

    interrupts = <0 356 4>;

    clocks = <&gcc 81>;
    clock-names = "se";

    interconnects = <&clk_virt 0 ((1 << 0) | (1 << 1) | (1 << 2))
       &clk_virt 2 ((1 << 0) | (1 << 1) | (1 << 2))>,
      <&gem_noc 2 ((1 << 0) | (1 << 1))
       &config_noc 16 ((1 << 0) | (1 << 1))>,
      <&aggre1_noc 1 ((1 << 0) | (1 << 1) | (1 << 2))
       &mc_virt 1 ((1 << 0) | (1 << 1) | (1 << 2))>;
    interconnect-names = "qup-core",
           "qup-config",
           "qup-memory";

    dmas = <&gpi_dma1 0 3 3>,
           <&gpi_dma1 1 3 3>;
    dma-names = "tx",
         "rx";

    pinctrl-0 = <&qup_i2c3_data_clk>;
    pinctrl-names = "default";

    #address-cells = <1>;
    #size-cells = <0>;

    status = "disabled";
   };

