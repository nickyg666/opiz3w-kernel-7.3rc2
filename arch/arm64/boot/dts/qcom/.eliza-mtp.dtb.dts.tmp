   mdss_dp0: displayport-controller@af54000 {
    compatible = "qcom,eliza-dp", "qcom,sm8650-dp";
    reg = <0x0 0x0af54000 0x0 0x200>,
          <0x0 0x0af54200 0x0 0x200>,
          <0x0 0x0af55000 0x0 0xc00>,
          <0x0 0x0af56000 0x0 0x400>,
          <0x0 0x0af57000 0x0 0x400>,
          <0x0 0x0af58000 0x0 0x400>,
          <0x0 0x0af59000 0x0 0x400>,
          <0x0 0x0af5a000 0x0 0x600>,
          <0x0 0x0af5b000 0x0 0x600>;

    interrupts-extended = <&mdss 12>;

    clocks = <&dispcc 9>,
      <&dispcc 19>,
      <&dispcc 22>,
      <&dispcc 25>,
      <&dispcc 26>,
      <&dispcc 28>;
    clock-names = "core_iface",
           "core_aux",
           "ctrl_link",
           "ctrl_link_iface",
           "stream_pixel",
           "stream_1_pixel";

    assigned-clocks = <&dispcc 23>,
        <&dispcc 27>,
        <&dispcc 29>;
    assigned-clock-parents = <&usb_dp_qmpphy 1>,
        <&usb_dp_qmpphy 2>,
        <&usb_dp_qmpphy 2>;

    operating-points-v2 = <&dp_opp_table>;

    power-domains = <&rpmhpd 0>;

    phys = <&usb_dp_qmpphy 1>;
    phy-names = "dp";

    #sound-dai-cells = <0>;

    status = "disabled";

    dp_opp_table: opp-table {
     compatible = "operating-points-v2";

     opp-270000000 {
      opp-hz = /bits/ 64 <270000000>;
      required-opps = <&rpmhpd_opp_low_svs>;
     };

     opp-540000000 {
      opp-hz = /bits/ 64 <540000000>;
      required-opps = <&rpmhpd_opp_svs_l1>;
     };

     opp-810000000 {
      opp-hz = /bits/ 64 <810000000>;
