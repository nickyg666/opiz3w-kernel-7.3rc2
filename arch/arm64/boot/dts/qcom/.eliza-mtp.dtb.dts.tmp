   uart6: serial@a98000 {
    compatible = "qcom,geni-uart";
    reg = <0x0 0x00a98000 0x0 0x4000>;

    interrupts = <0 363 4>;

    clocks = <&gcc 87>;
    clock-names = "se";

    interconnects = <&clk_virt 0 ((1 << 0) | (1 << 1) | (1 << 2))
       &clk_virt 2 ((1 << 0) | (1 << 1) | (1 << 2))>,
      <&gem_noc 2 ((1 << 0) | (1 << 1) | (1 << 2))
