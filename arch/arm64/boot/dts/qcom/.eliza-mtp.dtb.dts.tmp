    interrupts = <0 357 4>;

    clocks = <&gcc 83>;
    clock-names = "se";

    interconnects = <&clk_virt 0 ((1 << 0) | (1 << 1) | (1 << 2))
       &clk_virt 2 ((1 << 0) | (1 << 1) | (1 << 2))>,
      <&gem_noc 2 ((1 << 0) | (1 << 1))
       &config_noc 16 ((1 << 0) | (1 << 1))>,
      <&aggre1_noc 1 ((1 << 0) | (1 << 1) | (1 << 2))
