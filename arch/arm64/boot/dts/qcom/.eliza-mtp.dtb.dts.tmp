      mdss_dp0_in: endpoint {
       remote-endpoint = <&dpu_intf0_out>;
      };
     };

     port@1 {
      reg = <1>;

      mdss_dp0_out: endpoint {
       data-lanes = <0 1 2 3>;
       remote-endpoint = <&usb_dp_qmpphy_dp_in>;
      };
     };
    };
   };
  };

  dispcc: clock-controller@af00000 {
   compatible = "qcom,eliza-dispcc";
   reg = <0x0 0x0af00000 0x0 0x20000>;

   clocks = <&bi_tcxo_div2>,
     <&bi_tcxo_ao_div2>,
