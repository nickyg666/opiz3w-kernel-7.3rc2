     <&sleep_clk>,
     <&mdss_dsi0_phy 0>,
     <&mdss_dsi0_phy 1>,
     <&mdss_dsi1_phy 0>,
     <&mdss_dsi1_phy 1>,
     <&usb_dp_qmpphy 1>,
     <&usb_dp_qmpphy 2>,
     <0>,
     <0>,
     <0>,
     <0>,
     <0>,
     <0>,
     <0>;

   power-domains = <&rpmhpd 8>;
   required-opps = <&rpmhpd_opp_low_svs>;

   #clock-cells = <1>;
   #reset-cells = <1>;
   #power-domain-cells = <1>;
