# 15 "arch/arm64/boot/dts/qcom/eliza.dtsi" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interconnect/qcom,osm-l3.h" 1
# 16 "arch/arm64/boot/dts/qcom/eliza.dtsi" 2
