# 12 "arch/arm64/boot/dts/qcom/eliza.dtsi" 2

# 1 "./scripts/dtc/include-prefixes/dt-bindings/interconnect/qcom,eliza-rpmh.h" 1
# 14 "arch/arm64/boot/dts/qcom/eliza.dtsi" 2
