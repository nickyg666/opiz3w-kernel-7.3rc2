  gpi_dma1: dma-controller@a00000 {
   compatible = "qcom,eliza-gpi-dma", "qcom,sm6350-gpi-dma";
   reg = <0x0 0x00a00000 0x0 0x60000>;

   interrupts = <0 279 4>,
         <0 280 4>,
         <0 281 4>,
         <0 282 4>,
         <0 283 4>,
         <0 284 4>,
         <0 293 4>,
         <0 294 4>,
         <0 295 4>,
         <0 296 4>,
         <0 297 4>,
         <0 298 4>;

   dma-channels = <12>;
   dma-channel-mask = <0x3f>;
   #dma-cells = <3>;

   iommus = <&apps_smmu 0xb6 0x0>;

   dma-coherent;
  };

