   pins = "gpio1";
   function = "pcie0_clkreq";
   drive-strength = <2>;
   bias-pull-up;
  };

  perst-pins {
   pins = "gpio2";
   function = "gpio";
   drive-strength = <2>;
   bias-pull-up;
  };

  wake-pins {
   pins = "gpio0";
