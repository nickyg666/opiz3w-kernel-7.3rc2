   opp-hz = /bits/ 64 <1632000000>;
   opp-peak-kBps = <(1708800 * 4) (1228800 * 32)>;
  };

  opp-1708800000 {
   opp-hz = /bits/ 64 <1708800000>;
   opp-peak-kBps = <(1708800 * 4) (1228800 * 32)>;
  };

  opp-1785600000 {
   opp-hz = /bits/ 64 <1785600000>;
   opp-peak-kBps = <(1708800 * 4) (1228800 * 32)>;
  };

  opp-1862400000 {
   opp-hz = /bits/ 64 <1862400000>;
   opp-peak-kBps = <(1708800 * 4) (1228800 * 32)>;
  };

  opp-1939200000 {
   opp-hz = /bits/ 64 <1939200000>;
   opp-peak-kBps = <(1708800 * 4) (1228800 * 32)>;
  };

  opp-2016000000 {
   opp-hz = /bits/ 64 <2016000000>;
