  llcc: system-cache-controller@9200000 {
   compatible = "qcom,sa8775p-llcc";
   reg = <0x0 0x09200000 0x0 0x80000>,
         <0x0 0x09300000 0x0 0x80000>,
         <0x0 0x09400000 0x0 0x80000>,
         <0x0 0x09500000 0x0 0x80000>,
         <0x0 0x09600000 0x0 0x80000>,
