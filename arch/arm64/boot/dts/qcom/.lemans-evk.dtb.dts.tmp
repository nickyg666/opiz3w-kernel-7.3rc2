   compatible = "qcom,sa8775p-cpu-bwmon", "qcom,sdm845-bwmon";
   reg = <0x0 0x90b6400 0x0 0x600>;
   interrupts = <0 581 4>;
   interconnects = <&gem_noc 3 ((1 << 0) | (1 << 1))
      &gem_noc 15 ((1 << 0) | (1 << 1))>;

   operating-points-v2 = <&cpu_bwmon_opp_table>;
