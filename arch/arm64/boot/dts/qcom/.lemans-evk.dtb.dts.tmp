 arch_timer: timer {
  compatible = "arm,armv8-timer";
  interrupts = <1 13 8>,
        <1 14 8>,
        <1 11 8>,
        <1 10 8>;
 };

 turing-llm-tpdm {
  compatible = "qcom,coresight-static-tpdm";
  label = "tpdm_cdsp_llm_0";

  qcom,cmb-element-bits = <32>;

  out-ports {
   port {
    turing_llm_tpdm_out: endpoint {
     remote-endpoint = <&turing0_funnel_in1>;
    };
   };
  };
 };
};
