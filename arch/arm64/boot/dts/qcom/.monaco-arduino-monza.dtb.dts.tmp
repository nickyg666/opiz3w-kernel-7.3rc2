   sdc1_state_on: sdc1-on-state {
    clk-pins {
     pins = "sdc1_clk";
     drive-strength = <16>;
     bias-disable;
    };

    cmd-pins {
     pins = "sdc1_cmd";
     drive-strength = <10>;
     bias-pull-up;
    };

    data-pins {
     pins = "sdc1_data";
     drive-strength = <10>;
     bias-pull-up;
    };

    rclk-pins {
     pins = "sdc1_rclk";
     bias-pull-down;
    };
   };

   sdc1_state_off: sdc1-off-state {
    clk-pins {
     pins = "sdc1_clk";
     drive-strength = <2>;
     bias-bus-hold;
    };

    cmd-pins {
     pins = "sdc1_cmd";
     drive-strength = <2>;
     bias-bus-hold;
    };

    data-pins {
     pins = "sdc1_data";
     drive-strength = <2>;
     bias-bus-hold;
    };

    rclk-pins {
     pins = "sdc1_rclk";
     bias-bus-hold;
    };
   };
  };

  sram: sram@146d8000 {
   compatible = "qcom,qcs8300-imem", "syscon", "simple-mfd";
   reg = <0x0 0x146d8000 0x0 0x1000>;
   ranges = <0x0 0x0 0x146d8000 0x1000>;

   #address-cells = <1>;
   #size-cells = <1>;

   minidump_config: minidump-sram@1c {
    reg = <0x1c 0x4>;
   };

   pil-reloc@94c {
    compatible = "qcom,pil-reloc-info";
    reg = <0x94c 0xc8>;
   };
  };

