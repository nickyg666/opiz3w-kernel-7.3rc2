# 0 "arch/arm64/boot/dts/qcom/talos-el2.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/qcom/talos-el2.dtso"







/dts-v1/;
/plugin/;

&gpu_zap_shader {
 status = "disabled";
};

&remoteproc_adsp {
 iommus = <&apps_smmu 0x1720 0x0>;
};

&remoteproc_cdsp {
 iommus = <&apps_smmu 0x1080 0x0>;
};

&venus {
 status = "disabled";
};
