    cache-line-size = <64>;


    cache-sets = <1024>;
    cache-unified;
    next-level-cache = <&l3_2>;
   };
  };
  cpu20300: cpu@20300 {
   compatible = "arm,cortex-a78";
   device_type = "cpu";
   enable-method = "psci";
   reg = <0x20300>;
   operating-points-v2 = <&cpu_opp_table>;
   cpu-idle-states = <&CPU_SLEEP_0>;
   d-cache-size = <0x10000>;
   d-cache-line-size = <64>;


