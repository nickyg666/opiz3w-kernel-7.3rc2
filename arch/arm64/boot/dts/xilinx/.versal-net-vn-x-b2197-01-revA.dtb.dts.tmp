   l2_01: l2-cache {
    compatible = "cache";
    cache-level = <2>;
    cache-size = <0x80000>;
    cache-line-size = <64>;


    cache-sets = <1024>;
    cache-unified;
    next-level-cache = <&l3_0>;
   };
  };
  cpu200: cpu@200 {
   compatible = "arm,cortex-a78";
