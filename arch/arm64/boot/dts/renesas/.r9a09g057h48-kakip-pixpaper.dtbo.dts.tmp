# 0 "arch/arm64/boot/dts/renesas/r9a09g057h48-kakip-pixpaper.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/renesas/r9a09g057h48-kakip-pixpaper.dtso"
# 9 "arch/arm64/boot/dts/renesas/r9a09g057h48-kakip-pixpaper.dtso"
/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/renesas,r9a09g057-pinctrl.h" 1
# 12 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/renesas,r9a09g057-pinctrl.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/rzg2l-pinctrl.h" 1
# 13 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/renesas,r9a09g057-pinctrl.h" 2
# 13 "arch/arm64/boot/dts/renesas/r9a09g057h48-kakip-pixpaper.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 14 "arch/arm64/boot/dts/renesas/r9a09g057h48-kakip-pixpaper.dtso" 2

&pinctrl {
 rspi0_pins: rspi0 {
  pinmux = <((9) * 8 + (0) | ((1) << 16))>,
    <((9) * 8 + (1) | ((1) << 16))>,
    <((9) * 8 + (2) | ((1) << 16))>,
    <((9) * 8 + (3) | ((1) << 16))>;
 };
};

&rspi0 {
 pinctrl-0 = <&rspi0_pins>;
 pinctrl-names = "default";
 #address-cells = <1>;
 #size-cells = <0>;
 status = "okay";

 display@0 {
  compatible = "mayqueen,pixpaper";
  reg = <0>;
  spi-max-frequency = <1000000>;
  reset-gpios = <&pinctrl ((10) * 8 + (7)) 0>;
  busy-gpios = <&pinctrl ((11) * 8 + (3)) 0>;
  dc-gpios = <&pinctrl ((7) * 8 + (4)) 0>;
 };
};
