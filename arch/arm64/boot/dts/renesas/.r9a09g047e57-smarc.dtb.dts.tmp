   clocks = <&cpg 1 0x9c>, <&cpg 1 0x9d>,
     <&cpg 1 0x9e>;
   clock-names = "fck", "ram_clk", "can_clk";
   assigned-clocks = <&cpg 1 0x9e>;
   assigned-clock-rates = <80000000>;
   resets = <&cpg 0xa1>, <&cpg 0xa2>;
   reset-names = "rstp_n", "rstc_n";
   power-domains = <&cpg>;
   status = "disabled";

   channel0 {
    status = "disabled";
   };
   channel1 {
    status = "disabled";
   };
   channel2 {
    status = "disabled";
   };
   channel3 {
    status = "disabled";
   };
   channel4 {
    status = "disabled";
   };
   channel5 {
