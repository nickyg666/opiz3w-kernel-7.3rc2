         <0 533 4>,
         <0 530 4>,
         <0 534 4>,
         <0 531 4>,
         <0 535 4>,
         <0 536 1>,
         <0 537 1>;
   interrupt-names = "eri", "rxi", "txi", "bri", "dri",
       "tei", "tei-dri", "rxi-edge", "txi-edge";
   clocks = <&cpg 1 0x8f>;
   clock-names = "fck";
   power-domains = <&cpg>;
   resets = <&cpg 0x95>;
   status = "disabled";
  };

  i3c: i3c@12400000 {
   compatible = "renesas,r9a09g047-i3c";
   reg = <0 0x12400000 0 0x10000>;
   clocks = <&cpg 1 0x91>,
     <&cpg 1 0x92>,
     <&cpg 1 0x90>;
   clock-names = "pclk", "tclk", "pclkrw";
   interrupts = <0 674 4>,
         <0 675 4>,
         <0 676 4>,
         <0 677 1>,
         <0 678 1>,
         <0 679 1>,
         <0 680 1>,
         <0 681 1>,
