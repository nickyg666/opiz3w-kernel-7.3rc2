   dmas = <&dmac0 0x4490>, <&dmac0 0x4491>,
          <&dmac1 0x4490>, <&dmac1 0x4491>,
          <&dmac2 0x4490>, <&dmac2 0x4491>,
          <&dmac3 0x4490>, <&dmac3 0x4491>,
          <&dmac4 0x4490>, <&dmac4 0x4491>;
   dma-names = "rx", "tx", "rx", "tx", "rx", "tx",
        "rx", "tx", "rx", "tx";
   power-domains = <&cpg>;
   #address-cells = <1>;
   #size-cells = <0>;
   status = "disabled";
  };

