         <0 696 4>;
   interrupt-names = "ierr", "terr", "abort", "resp",
       "cmd", "ibi", "rx", "tx", "rcv",
       "st", "sp", "tend", "nack", "al",
       "tmo", "wu";
   resets = <&cpg 0x96>, <&cpg 0x97>;
   reset-names = "presetn", "tresetn";
   power-domains = <&cpg>;
   #address-cells = <3>;
   #size-cells = <0>;
   status = "disabled";
  };

  canfd: can@12440000 {
   compatible = "renesas,r9a09g047-canfd";
   reg = <0 0x12440000 0 0x40000>;
   interrupts = <0 709 4>,
         <0 710 4>,
         <0 697 4>,
         <0 703 4>,
         <0 711 4>,
         <0 698 4>,
         <0 704 4>,
         <0 712 4>,
