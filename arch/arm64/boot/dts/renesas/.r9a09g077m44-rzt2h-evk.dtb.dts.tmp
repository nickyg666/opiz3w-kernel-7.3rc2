   status = "disabled";
  };

  wdt2: watchdog@80082800 {
   compatible = "renesas,r9a09g077-wdt";
   reg = <0 0x80082800 0 0x400>,
         <0 0x81295108 0 0x04>;
   clocks = <&cpg 0 14>;
   clock-names = "pclk";
   power-domains = <&cpg>;
   status = "disabled";
  };

  wdt3: watchdog@80082c00 {
   compatible = "renesas,r9a09g077-wdt";
   reg = <0 0x80082c00 0 0x400>,
         <0 0x8129510c 0 0x04>;
   clocks = <&cpg 0 14>;
   clock-names = "pclk";
   power-domains = <&cpg>;
   status = "disabled";
  };

  wdt4: watchdog@80083000 {
   compatible = "renesas,r9a09g077-wdt";
   reg = <0 0x80083000 0 0x400>,
         <0 0x81295110 0 0x04>;
   clocks = <&cpg 0 14>;
   clock-names = "pclk";
