   status = "disabled";
  };

  dmac0: dma-controller@800c0000 {
   compatible = "renesas,r9a09g077-dmac";
   reg = <0 0x800c0000 0 0x1000>;
   interrupts = <0 32 1>,
         <0 33 1>,
         <0 34 1>,
         <0 35 1>,
         <0 36 1>,
         <0 37 1>,
         <0 38 1>,
         <0 39 1>,
         <0 40 1>,
         <0 41 1>,
         <0 42 1>,
         <0 43 1>,
         <0 44 1>,
         <0 45 1>,
         <0 46 1>,
         <0 47 1>;
   interrupt-names = "ch0", "ch1", "ch2", "ch3",
       "ch4", "ch5", "ch6", "ch7",
       "ch8", "ch9", "ch10", "ch11",
       "ch12", "ch13", "ch14", "ch15";
   clocks = <&cpg 0 12>;
   power-domains = <&cpg>;
   #dma-cells = <1>;
   dma-channels = <16>;
   renesas,icu = <&icu 0>;
  };

  dmac1: dma-controller@800c1000 {
   compatible = "renesas,r9a09g077-dmac";
   reg = <0 0x800c1000 0 0x1000>;
   interrupts = <0 48 1>,
         <0 49 1>,
         <0 50 1>,
         <0 51 1>,
         <0 52 1>,
         <0 53 1>,
         <0 54 1>,
         <0 55 1>,
         <0 56 1>,
         <0 57 1>,
         <0 58 1>,
         <0 59 1>,
         <0 60 1>,
         <0 61 1>,
         <0 62 1>,
         <0 63 1>;
   interrupt-names = "ch0", "ch1", "ch2", "ch3",
       "ch4", "ch5", "ch6", "ch7",
       "ch8", "ch9", "ch10", "ch11",
       "ch12", "ch13", "ch14", "ch15";
   clocks = <&cpg 0 12>;
