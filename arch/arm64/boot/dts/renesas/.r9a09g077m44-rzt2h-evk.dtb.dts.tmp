# 1 "./scripts/dtc/include-prefixes/dt-bindings/net/renesas,r9a09g077-pcs-miic.h" 1
# 13 "arch/arm64/boot/dts/renesas/rzt2h-n2h-evk-common.dtsi" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/renesas,r9a09g077-pinctrl.h" 1
# 14 "arch/arm64/boot/dts/renesas/rzt2h-n2h-evk-common.dtsi" 2

/ {
 aliases {
  ethernet3 = &gmac1;
  ethernet2 = &gmac2;
  i2c0 = &i2c0;
  i2c1 = &i2c1;
  mmc0 = &sdhi0;
  mmc1 = &sdhi1;
  serial0 = &sci0;
  spi0 = &xspi0;
  spi1 = &xspi1;
 };

 chosen {
  stdout-path = "serial0:115200n8";
 };

 memory@c8000000 {
  device_type = "memory";

  reg = <0x0 0xc8000000 0x0 0x38000000>;
 };

 memory@240000000 {
  device_type = "memory";
  reg = <0x2 0x40000000 0x1 0xc0000000>;
 };

 reg_1p8v: regulator-1p8v {
  compatible = "regulator-fixed";
  regulator-name = "fixed-1.8V";
  regulator-min-microvolt = <1800000>;
  regulator-max-microvolt = <1800000>;
  regulator-boot-on;
  regulator-always-on;
 };

 reg_3p3v: regulator-3p3v {
  compatible = "regulator-fixed";
  regulator-name = "fixed-3.3V";
  regulator-min-microvolt = <3300000>;
  regulator-max-microvolt = <3300000>;
  regulator-boot-on;
  regulator-always-on;
 };
# 75 "arch/arm64/boot/dts/renesas/rzt2h-n2h-evk-common.dtsi"
 vccq_sdhi1: regulator-vccq-sdhi1 {
  compatible = "regulator-gpio";
  regulator-name = "SDHI1 VccQ";
  regulator-min-microvolt = <1800000>;
  regulator-max-microvolt = <3300000>;
  gpios = <&pinctrl ((8) * 8 + (6)) 0>;
  gpios-states = <0>;
  states = <3300000 0>, <1800000 1>;
 };

};
# 98 "arch/arm64/boot/dts/renesas/rzt2h-n2h-evk-common.dtsi"
&adc0 {
 status = "okay";

 channel@0 {
  reg = <0x0>;
 };

 channel@1 {
  reg = <0x1>;
 };

 channel@2 {
  reg = <0x2>;
 };

 channel@3 {
  reg = <0x3>;
 };
};
# 146 "arch/arm64/boot/dts/renesas/rzt2h-n2h-evk-common.dtsi"
&adc1 {
 status = "okay";

 channel@0 {
  reg = <0x0>;
 };

 channel@1 {
  reg = <0x1>;
 };

 channel@2 {
  reg = <0x2>;
 };

 channel@3 {
  reg = <0x3>;
 };
};

&ehci {
 dr_mode = "otg";
 status = "okay";
};

&ethss {
 status = "okay";

 renesas,miic-switch-portin = <0>;
};

&extal_clk {
 clock-frequency = <25000000>;
};

&gmac1 {
 pinctrl-0 = <&gmac1_pins>;
 pinctrl-names = "default";
 phy-handle = <&mdio1_phy>;
 phy-mode = "rgmii-id";
 pcs-handle = <&mii_conv3>;
 status = "okay";
};

&gmac2 {
 pinctrl-0 = <&gmac2_pins>;
 pinctrl-names = "default";
 phy-handle = <&mdio2_phy>;
 phy-mode = "rgmii-id";
 pcs-handle = <&mii_conv2>;
 status = "okay";
};

&hsusb {
 dr_mode = "otg";
 status = "okay";
};

&i2c0 {
 eeprom: eeprom@50 {
  compatible = "renesas,r1ex24016", "atmel,24c16";
  reg = <0x50>;
  pagesize = <16>;
 };
};

&mdio1 {
 mdio1_phy: ethernet-phy@3 {
  compatible = "ethernet-phy-id0007.0772", "ethernet-phy-ieee802.3-c22";
  reg = <3>;
  vsc8531,led-0-mode = <10>;
  vsc8531,led-1-mode = <0>;
  reset-assert-us = <2000>;
  reset-deassert-us = <15000>;
 };
};

&mdio2 {
 mdio2_phy: ethernet-phy@2 {
  compatible = "ethernet-phy-id0007.0772", "ethernet-phy-ieee802.3-c22";
  reg = <2>;
  vsc8531,led-0-mode = <10>;
  vsc8531,led-1-mode = <0>;
  reset-assert-us = <2000>;
  reset-deassert-us = <15000>;
 };
};

&mii_conv0 {
 renesas,miic-input = <6>;
 status = "okay";
};

&mii_conv1 {
 renesas,miic-input = <7>;
 status = "okay";
};

&mii_conv2 {
 renesas,miic-input = <2>;
 status = "okay";
};

&mii_conv3 {
 renesas,miic-input = <1>;
 status = "okay";
};

&ohci {
 dr_mode = "otg";
 status = "okay";
};

&pinctrl {
# 268 "arch/arm64/boot/dts/renesas/rzt2h-n2h-evk-common.dtsi"
 sci0_pins: sci0-pins {
  pinmux = <((27) * 8 + (4) | ((0x14) << 16))>,
    <((27) * 8 + (5) | ((0x14) << 16))>;
  drive-strength-microamp = <9000>;
  slew-rate = <1>;
  input-schmitt-disable;
 };


 sdhi0-emmc-iovs-hog {
  gpio-hog;
  gpios = <((2) * 8 + (6)) 0>;
  output-high;
  line-name = "SD0_IOVS";
 };


 sdhi0_emmc_pins: sd0-emmc-group {
  data-pins {
   pinmux = <((12) * 8 + (2) | ((0x29) << 16))>,
     <((12) * 8 + (3) | ((0x29) << 16))>,
     <((12) * 8 + (4) | ((0x29) << 16))>,
     <((12) * 8 + (5) | ((0x29) << 16))>,
     <((12) * 8 + (6) | ((0x29) << 16))>,
     <((12) * 8 + (7) | ((0x29) << 16))>,
     <((13) * 8 + (0) | ((0x29) << 16))>,
     <((13) * 8 + (1) | ((0x29) << 16))>;
   drive-strength-microamp = <5000>;
   slew-rate = <1>;
   input-schmitt-disable;
  };

  clk-pins {
   pinmux = <((12) * 8 + (0) | ((0x29) << 16))>;
   drive-strength-microamp = <9000>;
   slew-rate = <1>;
  };

  cmd-pins {
   pinmux = <((12) * 8 + (1) | ((0x29) << 16))>;
   drive-strength-microamp = <5000>;
   slew-rate = <1>;
   input-schmitt-disable;
  };

  rst-pins {
   pinmux = <((13) * 8 + (2) | ((0x29) << 16))>;
   drive-strength-microamp = <5000>;
   slew-rate = <1>;
  };
 };

 sdhi0_emmc_uhs_pins: sd0-emmc-uhs-group {
  data-pins {
   pinmux = <((12) * 8 + (2) | ((0x29) << 16))>,
     <((12) * 8 + (3) | ((0x29) << 16))>,
     <((12) * 8 + (4) | ((0x29) << 16))>,
     <((12) * 8 + (5) | ((0x29) << 16))>,
     <((12) * 8 + (6) | ((0x29) << 16))>,
     <((12) * 8 + (7) | ((0x29) << 16))>,
     <((13) * 8 + (0) | ((0x29) << 16))>,
     <((13) * 8 + (1) | ((0x29) << 16))>;
   drive-strength-microamp = <9000>;
   slew-rate = <1>;
   input-schmitt-disable;
  };

  clk-pins {
   pinmux = <((12) * 8 + (0) | ((0x29) << 16))>;
   drive-strength-microamp = <11800>;
   slew-rate = <1>;
  };

  cmd-pins {
   pinmux = <((12) * 8 + (1) | ((0x29) << 16))>;
   drive-strength-microamp = <9000>;
   slew-rate = <1>;
   input-schmitt-disable;
  };

  rst-pins {
   pinmux = <((13) * 8 + (2) | ((0x29) << 16))>;
   drive-strength-microamp = <9000>;
   slew-rate = <1>;
  };
 };
# 364 "arch/arm64/boot/dts/renesas/rzt2h-n2h-evk-common.dtsi"
 sdhi0_sd_pins: sd0-sd-group {
  data-pins {
   pinmux = <((12) * 8 + (2) | ((0x29) << 16))>,
     <((12) * 8 + (3) | ((0x29) << 16))>,
     <((12) * 8 + (4) | ((0x29) << 16))>,
     <((12) * 8 + (5) | ((0x29) << 16))>;
   drive-strength-microamp = <5000>;
   slew-rate = <1>;
   input-schmitt-disable;
  };

  clk-pins {
   pinmux = <((12) * 8 + (0) | ((0x29) << 16))>;
   drive-strength-microamp = <9000>;
   slew-rate = <1>;
  };

  ctrl-pins {
   pinmux = <((12) * 8 + (1) | ((0x29) << 16))>,
     <((22) * 8 + (5) | ((0x29) << 16))>;
   drive-strength-microamp = <5000>;
   slew-rate = <1>;
   input-schmitt-disable;
  };
 };

 sdhi0_sd_uhs_pins: sd0-sd-uhs-group {
  data-pins {
   pinmux = <((12) * 8 + (2) | ((0x29) << 16))>,
     <((12) * 8 + (3) | ((0x29) << 16))>,
     <((12) * 8 + (4) | ((0x29) << 16))>,
     <((12) * 8 + (5) | ((0x29) << 16))>;
   drive-strength-microamp = <9000>;
   slew-rate = <1>;
   input-schmitt-disable;
  };

  clk-pins {
   pinmux = <((12) * 8 + (0) | ((0x29) << 16))>;
   drive-strength-microamp = <11800>;
   slew-rate = <1>;
  };

  ctrl-pins {
   pinmux = <((12) * 8 + (1) | ((0x29) << 16))>,
     <((22) * 8 + (5) | ((0x29) << 16))>;
   drive-strength-microamp = <9000>;
   slew-rate = <1>;
   input-schmitt-disable;
  };
 };


 sdhi1-pwen-hog {
  gpio-hog;
  gpios = <((8) * 8 + (5)) 0>;
  output-high;
  line-name = "SD1_PWEN";
 };


 sdhi1_pins: sd1-group {
  data-pins {
   pinmux = <((16) * 8 + (7) | ((0x29) << 16))>,
     <((17) * 8 + (0) | ((0x29) << 16))>,
     <((17) * 8 + (1) | ((0x29) << 16))>,
     <((17) * 8 + (2) | ((0x29) << 16))>;
   drive-strength-microamp = <5000>;
   slew-rate = <1>;
   input-schmitt-disable;
  };

  clk-pins {
   pinmux = <((16) * 8 + (5) | ((0x29) << 16))>;
   drive-strength-microamp = <9000>;
   slew-rate = <1>;
  };

  ctrl-pins {
   pinmux = <((16) * 8 + (6) | ((0x29) << 16))>,
     <((17) * 8 + (4) | ((0x29) << 16))>;
   drive-strength-microamp = <5000>;
   slew-rate = <1>;
   input-schmitt-disable;
  };
 };

 sdhi1_uhs_pins: sd1-uhs-group {
  data-pins {
   pinmux = <((16) * 8 + (7) | ((0x29) << 16))>,
     <((17) * 8 + (0) | ((0x29) << 16))>,
     <((17) * 8 + (1) | ((0x29) << 16))>,
     <((17) * 8 + (2) | ((0x29) << 16))>;
   drive-strength-microamp = <9000>;
   slew-rate = <1>;
   input-schmitt-disable;
  };

  clk-pins {
   pinmux = <((16) * 8 + (5) | ((0x29) << 16))>;
   drive-strength-microamp = <11800>;
   slew-rate = <1>;
  };

  ctrl-pins {
   pinmux = <((16) * 8 + (6) | ((0x29) << 16))>,
     <((17) * 8 + (4) | ((0x29) << 16))>;
   drive-strength-microamp = <9000>;
   slew-rate = <1>;
   input-schmitt-disable;
  };
 };

 xspi0_pins: xspi0-group {
  ctrl-data-pins {
   pinmux = <((5) * 8 + (1) | ((0x1c) << 16))>,
     <((5) * 8 + (3) | ((0x1c) << 16))>,
     <((5) * 8 + (5) | ((0x1c) << 16))>,
     <((5) * 8 + (6) | ((0x1c) << 16))>,
     <((5) * 8 + (7) | ((0x1c) << 16))>,
     <((6) * 8 + (0) | ((0x1c) << 16))>,
     <((6) * 8 + (1) | ((0x1c) << 16))>,
     <((6) * 8 + (2) | ((0x1c) << 16))>,
     <((6) * 8 + (3) | ((0x1c) << 16))>,
     <((6) * 8 + (4) | ((0x1c) << 16))>,
     <((6) * 8 + (5) | ((0x1c) << 16))>,
     <((6) * 8 + (6) | ((0x1c) << 16))>;
   drive-strength-microamp = <9000>;
   input-schmitt-disable;
   slew-rate = <1>;
  };
 };
# 504 "arch/arm64/boot/dts/renesas/rzt2h-n2h-evk-common.dtsi"
 xspi1_pins: xspi1-pins {
  pinmux = <((1) * 8 + (0) | ((0x1c) << 16))>,
    <((1) * 8 + (1) | ((0x1c) << 16))>,
    <((1) * 8 + (4) | ((0x1c) << 16))>,
    <((1) * 8 + (5) | ((0x1c) << 16))>,
    <((1) * 8 + (6) | ((0x1c) << 16))>,
    <((1) * 8 + (7) | ((0x1c) << 16))>;
  drive-strength-microamp = <9000>;
  input-schmitt-enable;
  slew-rate = <1>;
 };
};

&sci0 {
 pinctrl-0 = <&sci0_pins>;
 pinctrl-names = "default";
 status = "okay";
};


&sdhi0 {
 pinctrl-0 = <&sdhi0_emmc_pins>;
 pinctrl-1 = <&sdhi0_emmc_uhs_pins>;
 pinctrl-names = "default", "state_uhs";
 vmmc-supply = <&reg_3p3v>;
 vqmmc-supply = <&reg_1p8v>;
 bus-width = <8>;
 non-removable;
 mmc-hs200-1_8v;
 fixed-emmc-driver-type = <1>;
 status = "okay";
};
# 554 "arch/arm64/boot/dts/renesas/rzt2h-n2h-evk-common.dtsi"
&sdhi1 {
 pinctrl-0 = <&sdhi1_pins>;
 pinctrl-1 = <&sdhi1_uhs_pins>;
 pinctrl-names = "default", "state_uhs";
 vmmc-supply = <&reg_3p3v>;
 vqmmc-supply = <&vccq_sdhi1>;
 bus-width = <4>;
 sd-uhs-sdr50;
 sd-uhs-sdr104;
 status = "okay";
};


&usb2_phy {
 pinctrl-0 = <&usb_pins>;
 pinctrl-names = "default";

 status = "okay";
};

&wdt2 {
 status = "okay";
 timeout-sec = <60>;
};

&xspi0 {
 pinctrl-0 = <&xspi0_pins>;
 pinctrl-names = "default";
 status = "okay";

 assigned-clocks = <&cpg 0 22>;
 assigned-clock-rates = <50000000>;

 flash@0 {
  compatible = "jedec,spi-nor";
  reg = <0>;
  vcc-supply = <&reg_3p3v>;
  m25p,fast-read;




  spi-tx-bus-width = <1>;
  spi-rx-bus-width = <1>;
  spi-max-frequency = <50000000>;

  partitions {
   compatible = "fixed-partitions";
   #address-cells = <1>;
   #size-cells = <1>;

   partition@0 {
    label = "bl2-0";
    reg = <0x00000000 0x00060000>;
    read-only;
   };

   partition@60000 {
    label = "fip-0";
    reg = <0x00060000 0x007a0000>;
    read-only;
   };

   partition@800000 {
    label = "user-0";
    reg = <0x800000 0x003800000>;
   };
  };
 };
};

&xspi1 {
 pinctrl-0 = <&xspi1_pins>;
 pinctrl-names = "default";
 status = "okay";

 assigned-clocks = <&cpg 0 23>;
 assigned-clock-rates = <50000000>;

 flash@0 {
  compatible = "jedec,spi-nor";
  reg = <0>;
  vcc-supply = <&reg_3p3v>;
  m25p,fast-read;
  spi-tx-bus-width = <4>;
  spi-rx-bus-width = <4>;
  spi-max-frequency = <50000000>;

  partitions {
   compatible = "fixed-partitions";
   #address-cells = <1>;
   #size-cells = <1>;

   partition@0 {
    label = "bl2-1";
    reg = <0x00000000 0x00060000>;
   };

   partition@60000 {
    label = "fip-1";
    reg = <0x00060000 0x007a0000>;
   };

   partition@800000 {
    label = "user-1";
    reg = <0x800000 0x800000>;
   };
  };
 };
};
# 63 "arch/arm64/boot/dts/renesas/r9a09g077m44-rzt2h-evk.dts" 2

/ {
 model = "Renesas RZ/T2H EVK Board based on r9a09g077m44";
 compatible = "renesas,rzt2h-evk", "renesas,r9a09g077m44", "renesas,r9a09g077";

 keys {
  compatible = "gpio-keys";
# 82 "arch/arm64/boot/dts/renesas/r9a09g077m44-rzt2h-evk.dts"
  key-2 {
   interrupts-extended = <&pinctrl ((0) * 8 + (3)) 2>;
   linux,code = <3>;
   label = "SW10";
   wakeup-source;
   debounce-interval = <20>;
  };

  key-3 {
   interrupts-extended = <&pinctrl ((8) * 8 + (7)) 2>;
   linux,code = <4>;
   label = "SW11";
   wakeup-source;
   debounce-interval = <20>;
  };
 };

 leds {
  compatible = "gpio-leds";

  led-0 {

   gpios = <&pinctrl ((23) * 8 + (1)) 0>;
   color = <2>;
   function = "debug";
   function-enumerator = <0>;
  };

  led-1 {

   gpios = <&pinctrl ((32) * 8 + (2)) 0>;
   color = <2>;
   function = "debug";
   function-enumerator = <1>;
  };

  led-2 {
   gpios = <&pinctrl ((6) * 8 + (7)) 0>;
   color = <6>;
   function = "debug";
   function-enumerator = <2>;
  };
# 135 "arch/arm64/boot/dts/renesas/r9a09g077m44-rzt2h-evk.dts"
  led-4 {

   gpios = <&pinctrl ((18) * 8 + (0)) 0>;
   color = <2>;
   function = "debug";
   function-enumerator = <4>;
  };

  led-5 {

   gpios = <&pinctrl ((18) * 8 + (1)) 0>;
   color = <1>;
   function = "debug";
   function-enumerator = <5>;
  };

  led-6 {

   gpios = <&pinctrl ((22) * 8 + (7)) 0>;
   color = <2>;
   function = "debug";
   function-enumerator = <6>;
  };

  led-7 {

   gpios = <&pinctrl ((23) * 8 + (0)) 0>;
   color = <2>;
   function = "debug";
   function-enumerator = <7>;
  };

  led-8 {

   gpios = <&pinctrl ((23) * 8 + (5)) 0>;
   color = <2>;
   function = "debug";
   function-enumerator = <8>;
  };
 };
};

&adc2 {
 status = "okay";

 channel@0 {
  reg = <0x0>;
 };

 channel@1 {
  reg = <0x1>;
 };

 channel@2 {
  reg = <0x2>;
 };

 channel@3 {
  reg = <0x3>;
 };

 channel@4 {
  reg = <0x4>;
 };

 channel@5 {
  reg = <0x5>;
 };
};

&canfd {
 pinctrl-0 = <&can0_pins>;
 pinctrl-names = "default";
 status = "okay";

 channel0 {
  status = "okay";
 };
};

&i2c0 {
 pinctrl-0 = <&i2c0_pins>;
 pinctrl-names = "default";
 clock-frequency = <400000>;
 status = "okay";
};

&i2c1 {
 pinctrl-0 = <&i2c1_pins>;
 pinctrl-names = "default";
 clock-frequency = <400000>;
 status = "okay";
};

&mdio1_phy {
 interrupts-extended = <&icu 19 2>;
 reset-gpios = <&pinctrl ((32) * 8 + (3)) 1>;
};

&mdio2_phy {
 interrupts-extended = <&icu 29 2>;





 reset-gpios = <&pinctrl ((17) * 8 + (5)) 1>;
};

&pinctrl {






 can0_pins: can0-pins {
  pinmux = <((24) * 8 + (3) | ((0x19) << 16))>,
    <((24) * 8 + (4) | ((0x19) << 16))>;
 };






 gmac1_pins: gmac1-group {
  irq-pins {
   pinmux = <((27) * 8 + (2) | ((0x0) << 16))>;
   drive-strength-microamp = <5000>;
   slew-rate = <0>;
   input-schmitt-disable;
  };

  md-pins {
   pinmux = <((26) * 8 + (1) | ((0x10) << 16))>,
     <((26) * 8 + (2) | ((0x10) << 16))>;
   drive-strength-microamp = <5000>;
   slew-rate = <0>;
   input-schmitt-disable;
  };

  refclk-pins {
   pinmux = <((34) * 8 + (6) | ((0x2) << 16))>;
   drive-strength-microamp = <5000>;
   slew-rate = <1>;
  };

  rx-pins {
   pinmux = <((34) * 8 + (0) | ((0xf) << 16))>,
     <((34) * 8 + (1) | ((0xf) << 16))>,
     <((34) * 8 + (2) | ((0xf) << 16))>,
     <((34) * 8 + (3) | ((0xf) << 16))>,
     <((34) * 8 + (4) | ((0xf) << 16))>,
     <((34) * 8 + (5) | ((0xf) << 16))>;
   input-schmitt-disable;
  };

  txclk-pins {
   pinmux = <((33) * 8 + (2) | ((0xf) << 16))>;
   drive-strength-microamp = <11800>;
   slew-rate = <1>;
   input-schmitt-disable;
  };

  txd-en-pins {
   pinmux = <((33) * 8 + (3) | ((0xf) << 16))>,
     <((33) * 8 + (4) | ((0xf) << 16))>,
     <((33) * 8 + (5) | ((0xf) << 16))>,
     <((33) * 8 + (6) | ((0xf) << 16))>,
     <((33) * 8 + (7) | ((0xf) << 16))>;
   drive-strength-microamp = <11800>;
   slew-rate = <1>;
  };
 };







 gmac2_pins: gmac2-group {
  irq-pins {
   pinmux = <((31) * 8 + (1) | ((0x0) << 16))>;
   drive-strength-microamp = <5000>;
   slew-rate = <0>;
   input-schmitt-disable;
  };

  md-pins {
   pinmux = <((30) * 8 + (5) | ((0x10) << 16))>,
     <((30) * 8 + (6) | ((0x10) << 16))>;
   drive-strength-microamp = <5000>;
   slew-rate = <0>;
