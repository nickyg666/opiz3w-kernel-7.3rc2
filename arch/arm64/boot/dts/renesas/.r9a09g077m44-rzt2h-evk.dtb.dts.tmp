   status = "disabled";
  };

  i2c2: i2c@81008000 {
   compatible = "renesas,riic-r9a09g077";
   reg = <0 0x81008000 0 0x400>;
   interrupts = <0 622 4>,
         <0 623 1>,
         <0 624 1>,
         <0 625 4>;
   interrupt-names = "eei", "rxi", "txi", "tei";
   clocks = <&cpg 1 601>;
