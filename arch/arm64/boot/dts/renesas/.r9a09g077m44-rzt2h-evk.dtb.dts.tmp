 };

 stmmac_axi_setup: stmmac-axi-config {
  snps,lpi_en;
  snps,wr_osr_lmt = <0xf>;
  snps,rd_osr_lmt = <0xf>;
  snps,blen = <16 8 4 0 0 0 0>;
 };

 thermal-zones {
  cpu-thermal {
   polling-delay = <1000>;
   polling-delay-passive = <250>;
   thermal-sensors = <&tsu>;

   cooling-maps {
    map0 {
     trip = <&target>;
     cooling-device = <&cpu0 0 1>, <&cpu1 0 1>,
        <&cpu2 0 1>, <&cpu3 0 1>;
     contribution = <1024>;
    };
   };

   trips {
    target: trip-point {
     temperature = <95000>;
     hysteresis = <1000>;
     type = "passive";
    };

    sensor_crit: sensor-crit {
     temperature = <120000>;
     hysteresis = <1000>;
     type = "critical";
    };
   };
  };
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupts = <1 13 8>,
        <1 14 8>,
        <1 11 8>,
        <1 10 8>,
        <1 12 8>;
  interrupt-names = "sec-phys", "phys", "virt", "hyp-phys", "hyp-virt";
 };
};
