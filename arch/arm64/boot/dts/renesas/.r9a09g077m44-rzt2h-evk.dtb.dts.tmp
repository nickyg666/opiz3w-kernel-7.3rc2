  };

  wdt5: watchdog@80083400 {
   compatible = "renesas,r9a09g077-wdt";
   reg = <0 0x80083400 0 0x400>,
         <0 0x81295114 0 0x04>;
   clocks = <&cpg 0 14>;
   clock-names = "pclk";
   power-domains = <&cpg>;
   status = "disabled";
  };

  tsu: thermal@80086000 {
   compatible = "renesas,r9a09g077-tsu";
   reg = <0 0x80086000 0 0x1000>;
   interrupts = <0 713 1>,
         <0 714 4>;
   interrupt-names = "adi", "adcmpi";
   clocks = <&cpg 1 307>;
   power-domains = <&cpg>;
   #thermal-sensor-cells = <0>;
  };

  i2c0: i2c@80088000 {
   compatible = "renesas,riic-r9a09g077";
   reg = <0 0x80088000 0 0x400>;
   interrupts = <0 614 4>,
         <0 615 1>,
         <0 616 1>,
         <0 617 4>;
   interrupt-names = "eei", "rxi", "txi", "tei";
   clocks = <&cpg 1 100>;
   power-domains = <&cpg>;
   #address-cells = <1>;
   #size-cells = <0>;
   status = "disabled";
  };

  i2c1: i2c@80088400 {
   compatible = "renesas,riic-r9a09g077";
   reg = <0 0x80088400 0 0x400>;
   interrupts = <0 618 4>,
         <0 619 1>,
         <0 620 1>,
         <0 621 4>;
   interrupt-names = "eei", "rxi", "txi", "tei";
   clocks = <&cpg 1 101>;
   power-domains = <&cpg>;
