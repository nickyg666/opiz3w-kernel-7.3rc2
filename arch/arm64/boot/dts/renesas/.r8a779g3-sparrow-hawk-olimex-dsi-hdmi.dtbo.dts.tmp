# 0 "arch/arm64/boot/dts/renesas/r8a779g3-sparrow-hawk-olimex-dsi-hdmi.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/renesas/r8a779g3-sparrow-hawk-olimex-dsi-hdmi.dtso"
# 9 "arch/arm64/boot/dts/renesas/r8a779g3-sparrow-hawk-olimex-dsi-hdmi.dtso"
/dts-v1/;
/plugin/;

&{/} {
 hdmi-connector {
  compatible = "hdmi-connector";
  label = "HDMI1";
  type = "a";
  ddc-i2c-bus = <&i2c0_mux3>;

  port {
   hdmi_connector_in: endpoint {
    remote-endpoint = <&lt8912b_out>;
   };
  };
 };

 reg_vr1: regulator-vr1 {
  compatible = "regulator-fixed";
  regulator-name = "VR1-1.8V";
  regulator-min-microvolt = <1800000>;
  regulator-max-microvolt = <1800000>;
  regulator-boot-on;
  regulator-always-on;
  vin-supply = <&reg_3p3v>;
 };
};

&i2c0_mux3 {
 #address-cells = <1>;
 #size-cells = <0>;

 hdmi-bridge@48 {
  compatible = "lontium,lt8912b";
  reg = <0x48>;
  vcchdmipll-supply = <&reg_vr1>;
  vcchdmitx-supply = <&reg_vr1>;
  vcclvdspll-supply = <&reg_vr1>;
  vcclvdstx-supply = <&reg_vr1>;
  vccmipirx-supply = <&reg_vr1>;
  vccsysclk-supply = <&reg_vr1>;
  vdd-supply = <&reg_vr1>;

  ports {
   #address-cells = <1>;
   #size-cells = <0>;

   port@0 {
    reg = <0>;

    hdmi_out_in: endpoint {
     data-lanes = <1 2>;
     remote-endpoint = <&dsi0_out>;
    };
   };

   port@1 {
    reg = <1>;

    lt8912b_out: endpoint {
     remote-endpoint = <&hdmi_connector_in>;
    };
   };
  };
 };
};

&dsi0 {
 status = "okay";

 ports {
  #address-cells = <1>;
  #size-cells = <0>;

  port@1 {
   reg = <1>;

   dsi0_out: endpoint {
    remote-endpoint = <&hdmi_out_in>;
    data-lanes = <1 2>;
   };
  };
 };
};
