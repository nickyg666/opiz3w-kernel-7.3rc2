# 1 "./scripts/dtc/include-prefixes/dt-bindings/clock/renesas,r9a09g056-cpg.h" 1







# 1 "./scripts/dtc/include-prefixes/dt-bindings/clock/renesas-cpg-mssr.h" 1
# 9 "./scripts/dtc/include-prefixes/dt-bindings/clock/renesas,r9a09g056-cpg.h" 2
