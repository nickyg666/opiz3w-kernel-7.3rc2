# 0 "arch/arm64/boot/dts/renesas/rzv2-evk-cn15-sd.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/renesas/rzv2-evk-cn15-sd.dtso"
# 9 "arch/arm64/boot/dts/renesas/rzv2-evk-cn15-sd.dtso"
/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 13 "arch/arm64/boot/dts/renesas/rzv2-evk-cn15-sd.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/pinctrl/rzg2l-pinctrl.h" 1
# 14 "arch/arm64/boot/dts/renesas/rzv2-evk-cn15-sd.dtso" 2

&{/} {
 aliases {
  mmc0 = "/soc/mmc@15c00000";
 };

 vqmmc_sdhi0: regulator-vqmmc-sdhi0 {
  compatible = "regulator-gpio";
  regulator-name = "SDHI0 VqmmC";
  gpios = <&pinctrl ((10) * 8 + (0)) 0>;
  regulator-min-microvolt = <1800000>;
  regulator-max-microvolt = <3300000>;
  gpios-states = <0>;
  states = <3300000 0>, <1800000 1>;
  regulator-ramp-delay = <60>;
 };
};

&pinctrl {
 sdhi0-pwr-en-hog {
  gpio-hog;
  gpios = <((10) * 8 + (1)) 0>;
  output-high;
  line-name = "sd0_pwr_en";
 };

 sdhi0_pins: sd0 {
  sd0-cd {
   pinmux = <((10) * 8 + (5) | ((15) << 16))>;
  };

  sd0-clk {
   pins = "SD0CLK";
   renesas,output-impedance = <3>;
   slew-rate = <0>;
  };

  sd0-dat-cmd {
   pins = "SD0DAT0", "SD0DAT1", "SD0DAT2", "SD0DAT3", "SD0CMD";
   input-enable;
   renesas,output-impedance = <3>;
   slew-rate = <0>;
  };
 };
};

&sdhi0 {
 pinctrl-0 = <&sdhi0_pins>;
 pinctrl-1 = <&sdhi0_pins>;
 pinctrl-names = "default", "state_uhs";
 vmmc-supply = <&reg_3p3v>;
 vqmmc-supply = <&vqmmc_sdhi0>;
 bus-width = <4>;
 sd-uhs-sdr50;
 sd-uhs-sdr104;
 status = "okay";
};
