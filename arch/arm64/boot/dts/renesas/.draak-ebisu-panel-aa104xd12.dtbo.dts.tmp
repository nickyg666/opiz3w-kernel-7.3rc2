# 0 "arch/arm64/boot/dts/renesas/draak-ebisu-panel-aa104xd12.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/renesas/draak-ebisu-panel-aa104xd12.dtso"
# 10 "arch/arm64/boot/dts/renesas/draak-ebisu-panel-aa104xd12.dtso"
# 1 "arch/arm64/boot/dts/renesas/panel-aa104xd12.dtsi" 1







/dts-v1/;
/plugin/;

&{/} {
 panel {
  compatible = "mitsubishi,aa104xd12", "panel-lvds";
  backlight = <&backlight>;

  width-mm = <210>;
  height-mm = <158>;
  data-mapping = "jeida-18";

  panel-timing {

   clock-frequency = <65000000>;
   hactive = <1024>;
   vactive = <768>;
   hsync-len = <136>;
   hfront-porch = <20>;
   hback-porch = <160>;
   vfront-porch = <3>;
   vback-porch = <29>;
   vsync-len = <6>;
  };

  port {
   lvds_panel_in: endpoint {
    remote-endpoint = <&lvds_panel_out>;
   };
  };
 };
};

&lvds1 {
 status = "okay";

 ports {
  #address-cells = <1>;
  #size-cells = <0>;

  port@1 {
   reg = <1>;

   lvds_panel_out: endpoint {
    remote-endpoint = <&lvds_panel_in>;
   };
  };
 };
};
# 11 "arch/arm64/boot/dts/renesas/draak-ebisu-panel-aa104xd12.dtso" 2
