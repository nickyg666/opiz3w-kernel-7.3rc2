  rsci2: serial@100f2000 {
   compatible = "renesas,r9a08g046-rsci";
   reg = <0 0x100f2000 0 0x1000>;
   interrupts = <0 428 4>,
         <0 429 1>,
         <0 430 1>,
         <0 431 4>,
         <0 432 1>,
         <0 433 4>;
   interrupt-names = "eri", "rxi", "txi", "tei",
       "aed", "bfd";
   clocks = <&cpg 1 125>,
