   clock-names = "ssi", "ssi_sfr", "audio_clk1", "audio_clk2";
   resets = <&cpg 68>;
   dmas = <&dmac 0x2671>, <&dmac 0x2672>;
   dma-names = "tx", "rx";
   power-domains = <&cpg>;
   #sound-dai-cells = <0>;
   status = "disabled";
  };

  cpg: clock-controller@11010000 {
   compatible = "renesas,r9a08g046-cpg";
   reg = <0 0x11010000 0 0x10000>;
   clocks = <&extal_clk>,
     <&eth0_txc_tx_clk>, <&eth0_rxc_rx_clk>,
     <&eth1_txc_tx_clk>, <&eth1_rxc_rx_clk>;
   clock-names = "extal",
          "eth0_txc_tx_clk", "eth0_rxc_rx_clk",
          "eth1_txc_tx_clk", "eth1_rxc_rx_clk";
   #clock-cells = <2>;
   #reset-cells = <1>;
   #power-domain-cells = <0>;
  };

  sysc: system-controller@11020000 {
   compatible = "renesas,r9a08g046-sysc";
   reg = <0 0x11020000 0 0x10000>;
   interrupts = <0 44 4>,
         <0 45 4>,
         <0 46 4>,
         <0 47 4>;
   interrupt-names = "lpm_int", "ca55stbydone_int",
       "cm33stbyr_int", "ca55_deny";
  };

  pinctrl: pinctrl@11030000 {
   compatible = "renesas,r9a08g046-pinctrl";
   reg = <0 0x11030000 0 0x10000>;
   gpio-controller;
   #gpio-cells = <2>;
   gpio-ranges = <&pinctrl 0 0 232>;
   interrupt-controller;
   #interrupt-cells = <2>;
   interrupt-parent = <&icu>;
   clocks = <&cpg 1 136>;
   power-domains = <&cpg>;
   resets = <&cpg 94>,
     <&cpg 95>,
     <&cpg 96>;
   reset-names = "rstn", "port", "spare";
   renesas,clonech = <&sysc 0xe2c>;
  };

  icu: interrupt-controller@11050000 {
   compatible = "renesas,r9a08g046-irqc";
   #interrupt-cells = <2>;
   #address-cells = <0>;
   interrupt-controller;
   reg = <0 0x11050000 0 0x10000>;
   interrupts = <0 0 4>,
         <0 1 4>,
         <0 2 4>,
         <0 3 4>,
         <0 4 4>,
         <0 5 4>,
         <0 6 4>,
         <0 7 4>,
         <0 8 4>,
         <0 529 4>,
         <0 530 4>,
         <0 531 4>,
         <0 532 4>,
         <0 533 4>,
         <0 534 4>,
         <0 535 4>,
         <0 536 4>,
         <0 505 4>,
         <0 506 4>,
         <0 507 4>,
         <0 508 4>,
         <0 509 4>,
         <0 510 4>,
         <0 511 4>,
         <0 512 4>,
         <0 513 4>,
         <0 514 4>,
         <0 515 4>,
         <0 516 4>,
         <0 517 4>,
         <0 518 4>,
         <0 519 4>,
         <0 520 4>,
         <0 521 4>,
         <0 522 4>,
         <0 523 4>,
         <0 524 4>,
         <0 525 4>,
         <0 526 4>,
         <0 527 4>,
         <0 528 4>,
         <0 529 4>,
         <0 530 4>,
         <0 531 4>,
         <0 532 4>,
         <0 533 4>,
         <0 534 4>,
         <0 535 4>,
         <0 536 4>,
         <0 33 4>,
         <0 35 4>,
         <0 36 4>,
         <0 37 4>,
         <0 212 4>,
         <0 224 4>,
         <0 236 4>,
         <0 248 4>,
         <0 260 4>,
         <0 272 4>,
         <0 284 4>,
         <0 296 4>;
   interrupt-names = "nmi",
       "irq0", "irq1", "irq2", "irq3",
       "irq4", "irq5", "irq6", "irq7",
       "irq8", "irq9", "irq10", "irq11",
       "irq12", "irq13", "irq14", "irq15",
       "tint0", "tint1", "tint2", "tint3",
       "tint4", "tint5", "tint6", "tint7",
       "tint8", "tint9", "tint10", "tint11",
       "tint12", "tint13", "tint14", "tint15",
       "tint16", "tint17", "tint18", "tint19",
       "tint20", "tint21", "tint22", "tint23",
       "tint24", "tint25", "tint26", "tint27",
       "tint28", "tint29", "tint30", "tint31",
       "bus-err", "ec7tie1-0", "ec7tie2-0", "ec7tiovf-0",
       "ovfunf0", "ovfunf1", "ovfunf2", "ovfunf3",
       "ovfunf4", "ovfunf5", "ovfunf6", "ovfunf7";
   clocks = <&cpg 1 15>,
     <&cpg 1 16>;
   clock-names = "clk", "pclk";
   power-domains = <&cpg>;
   resets = <&cpg 22>;
  };

  dmac: dma-controller@11820000 {
   compatible = "renesas,r9a08g046-dmac", "renesas,rz-dmac";
   reg = <0 0x11820000 0 0x10000>,
         <0 0x11830000 0 0x10000>;
   interrupts = <0 153 1>,
         <0 154 1>,
         <0 155 1>,
         <0 156 1>,
         <0 157 1>,
         <0 158 1>,
         <0 159 1>,
         <0 160 1>,
         <0 161 1>,
         <0 162 1>,
         <0 163 1>,
         <0 164 1>,
         <0 165 1>,
         <0 166 1>,
         <0 167 1>,
         <0 168 1>,
         <0 169 1>;
   interrupt-names = "error",
       "ch0", "ch1", "ch2", "ch3",
       "ch4", "ch5", "ch6", "ch7",
       "ch8", "ch9", "ch10", "ch11",
       "ch12", "ch13", "ch14", "ch15";
   clocks = <&cpg 1 19>,
     <&cpg 1 20>;
   clock-names = "main", "register";
   power-domains = <&cpg>;
   resets = <&cpg 25>,
     <&cpg 26>;
   reset-names = "arst", "rst_async";
   #dma-cells = <1>;
   dma-channels = <16>;
  };

  sdhi1: mmc@11c10000 {
   reg = <0x0 0x11c10000 0 0x10000>;

  };

  eth0: ethernet@11c30000 {
   compatible = "renesas,r9a08g046-gbeth", "snps,dwmac-5.30a";
   reg = <0 0x11c30000 0 0x10000>;
   interrupts = <0 78 4>,
         <0 80 4>,
         <0 79 4>,
         <0 85 1>,
         <0 86 1>,
         <0 87 1>,
         <0 88 1>,
         <0 81 1>,
         <0 82 1>,
         <0 83 1>,
         <0 84 1>,
         <0 89 1>,
         <0 90 1>,
         <0 91 1>,
         <0 92 1>;
   interrupt-names = "macirq", "eth_wake_irq", "eth_lpi",
       "rx-queue-0", "rx-queue-1", "rx-queue-2",
       "rx-queue-3", "tx-queue-0", "tx-queue-1",
       "tx-queue-2", "tx-queue-3", "ptp-pps-0",
       "ptp-pps-1", "ptp-pps-2", "ptp-pps-3";
   clocks = <&cpg 1 90>,
      <&cpg 1 91>,
      <&cpg 1 97>,
      <&cpg 1 92>,
      <&cpg 1 93>,
      <&cpg 1 94>,
      <&cpg 1 95>,
      <&cpg 1 96>,
      <&cpg 1 98>,
      <&cpg 1 99>;
   clock-names = "stmmaceth", "pclk", "ptp_ref",
          "tx", "rx", "tx-180", "rx-180",
          "rmii", "rmii_tx", "rmii_rx";
   resets = <&cpg 74>;
   power-domains = <&cpg>;
   snps,multicast-filter-bins = <256>;
   snps,perfect-filter-entries = <128>;
   rx-fifo-depth = <8192>;
   tx-fifo-depth = <8192>;
   snps,fixed-burst;
   snps,no-pbl-x8;
   snps,force_thresh_dma_mode;
   snps,axi-config = <&stmmac_axi_setup>;
   snps,mtl-rx-config = <&mtl_rx_setup0>;
   snps,mtl-tx-config = <&mtl_tx_setup0>;
   snps,txpbl = <32>;
   snps,rxpbl = <32>;
   status = "disabled";

   mdio0: mdio {
    compatible = "snps,dwmac-mdio";
    #address-cells = <1>;
    #size-cells = <0>;
   };

   mtl_rx_setup0: rx-queues-config {
    snps,rx-queues-to-use = <4>;
    snps,rx-sched-sp;

    queue0 {
     snps,dcb-algorithm;
     snps,priority = <0x1>;
     snps,map-to-dma-channel = <0>;
    };

    queue1 {
     snps,dcb-algorithm;
     snps,priority = <0x2>;
     snps,map-to-dma-channel = <1>;
    };

    queue2 {
     snps,dcb-algorithm;
     snps,priority = <0x4>;
     snps,map-to-dma-channel = <2>;
    };

    queue3 {
     snps,dcb-algorithm;
     snps,priority = <0x8>;
     snps,map-to-dma-channel = <3>;
    };
   };

   mtl_tx_setup0: tx-queues-config {
    snps,tx-queues-to-use = <4>;
    snps,tx-sched-wrr;

    queue0 {
     snps,weight = <0x10>;
     snps,dcb-algorithm;
     snps,priority = <0x1>;
    };

    queue1 {
     snps,weight = <0x12>;
     snps,dcb-algorithm;
     snps,priority = <0x2>;
    };

    queue2 {
     snps,weight = <0x14>;
     snps,dcb-algorithm;
     snps,priority = <0x4>;
    };

    queue3 {
     snps,weight = <0x18>;
     snps,dcb-algorithm;
     snps,priority = <0x8>;
    };
   };
  };

  eth1: ethernet@11c40000 {
   compatible = "renesas,r9a08g046-gbeth", "snps,dwmac-5.30a";
   reg = <0 0x11c40000 0 0x10000>;
   interrupts = <0 93 4>,
         <0 95 4>,
         <0 94 4>,
         <0 100 1>,
         <0 101 1>,
         <0 102 1>,
         <0 103 1>,
         <0 96 1>,
         <0 97 1>,
         <0 98 1>,
         <0 99 1>,
         <0 104 1>,
         <0 105 1>,
         <0 106 1>,
         <0 107 1>;
   interrupt-names = "macirq", "eth_wake_irq", "eth_lpi",
       "rx-queue-0", "rx-queue-1", "rx-queue-2",
       "rx-queue-3", "tx-queue-0", "tx-queue-1",
       "tx-queue-2", "tx-queue-3", "ptp-pps-0",
       "ptp-pps-1", "ptp-pps-2", "ptp-pps-3";
   clocks = <&cpg 1 100>,
     <&cpg 1 101>,
     <&cpg 1 107>,
     <&cpg 1 102>,
     <&cpg 1 103>,
     <&cpg 1 104>,
     <&cpg 1 105>,
     <&cpg 1 106>,
     <&cpg 1 108>,
     <&cpg 1 109>;
   clock-names = "stmmaceth", "pclk", "ptp_ref",
          "tx", "rx", "tx-180", "rx-180",
          "rmii", "rmii_tx", "rmii_rx";
   resets = <&cpg 75>;
   power-domains = <&cpg>;
   snps,multicast-filter-bins = <256>;
   snps,perfect-filter-entries = <128>;
   rx-fifo-depth = <8192>;
   tx-fifo-depth = <8192>;
   snps,fixed-burst;
   snps,no-pbl-x8;
   snps,force_thresh_dma_mode;
   snps,axi-config = <&stmmac_axi_setup>;
   snps,mtl-rx-config = <&mtl_rx_setup1>;
   snps,mtl-tx-config = <&mtl_tx_setup1>;
   snps,txpbl = <32>;
   snps,rxpbl = <32>;
   status = "disabled";

   mdio1: mdio {
    compatible = "snps,dwmac-mdio";
    #address-cells = <1>;
    #size-cells = <0>;
   };

   mtl_rx_setup1: rx-queues-config {
    snps,rx-queues-to-use = <4>;
    snps,rx-sched-sp;

    queue0 {
     snps,dcb-algorithm;
     snps,priority = <0x1>;
     snps,map-to-dma-channel = <0>;
    };

    queue1 {
     snps,dcb-algorithm;
     snps,priority = <0x2>;
     snps,map-to-dma-channel = <1>;
    };

    queue2 {
     snps,dcb-algorithm;
     snps,priority = <0x4>;
     snps,map-to-dma-channel = <2>;
    };

    queue3 {
     snps,dcb-algorithm;
     snps,priority = <0x8>;
     snps,map-to-dma-channel = <3>;
    };
   };

   mtl_tx_setup1: tx-queues-config {
    snps,tx-queues-to-use = <4>;
    snps,tx-sched-wrr;

    queue0 {
     snps,weight = <0x10>;
     snps,dcb-algorithm;
     snps,priority = <0x1>;
    };

    queue1 {
     snps,weight = <0x12>;
     snps,dcb-algorithm;
     snps,priority = <0x2>;
    };

    queue2 {
     snps,weight = <0x14>;
     snps,dcb-algorithm;
     snps,priority = <0x4>;
    };

    queue3 {
     snps,weight = <0x18>;
     snps,dcb-algorithm;
     snps,priority = <0x8>;
    };
   };
  };

  pcie: pcie@11e40000 {
   reg = <0 0x11e40000 0 0x10000>;
   ranges = <0x02000000 0 0x30000000 0 0x30000000 0 0x08000000>;
   device_type = "pci";
   #address-cells = <3>;
   #size-cells = <2>;


   pcie_port0: pcie@0,0 {
    reg = <0x0 0x0 0x0 0x0 0x0>;
    ranges;
    device_type = "pci";
    #address-cells = <3>;
    #size-cells = <2>;

   };
  };

  gic: interrupt-controller@12400000 {
   compatible = "arm,gic-v3";
   reg = <0x0 0x12400000 0 0x20000>,
         <0x0 0x12440000 0 0x80000>;
   #interrupt-cells = <3>;
   #address-cells = <0>;
   interrupt-controller;
   interrupts = <1 9 8>;
  };

  wdt0: watchdog@12800800 {
   compatible = "renesas,r9a08g046-wdt", "renesas,rzg2l-wdt";
   reg = <0 0x12800800 0 0x400>;
   clocks = <&cpg 1 31>,
     <&cpg 1 32>;
   clock-names = "pclk", "oscclk";
   interrupts = <0 53 4>,
         <0 52 4>;
   interrupt-names = "wdt", "perrout";
   resets = <&cpg 37>;
   power-domains = <&cpg>;
   status = "disabled";
  };
 };

 stmmac_axi_setup: stmmac-axi-config {
  snps,lpi_en;
  snps,wr_osr_lmt = <0xf>;
  snps,rd_osr_lmt = <0xf>;
  snps,blen = <16 8 4 0 0 0 0>;
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupts = <1 13 8>,
        <1 14 8>,
        <1 11 8>,
        <1 10 8>,
        <1 12 8>;
  interrupt-names = "sec-phys", "phys", "virt", "hyp-phys", "hyp-virt";
 };
};
# 10 "arch/arm64/boot/dts/renesas/r9a08g046l48.dtsi" 2

/ {
 compatible = "renesas,r9a08g046l48", "renesas,r9a08g046";
};
# 30 "arch/arm64/boot/dts/renesas/r9a08g046l48-smarc.dts" 2
# 1 "arch/arm64/boot/dts/renesas/rzg3l-smarc-som.dtsi" 1
# 33 "arch/arm64/boot/dts/renesas/rzg3l-smarc-som.dtsi"
/ {
 compatible = "renesas,rzg3l-smarcm", "renesas,r9a08g046l48", "renesas,r9a08g046";

 aliases {
  ethernet0 = &eth0;
  ethernet1 = &eth1;
  i2c0 = &i2c0;
 };

 memory@48000000 {
  device_type = "memory";

  reg = <0x0 0x48000000 0x0 0x78000000>;
 };

 reg_1p8v: regulator-1p8v {
  compatible = "regulator-fixed";
  regulator-name = "fixed-1.8V";
  regulator-min-microvolt = <1800000>;
  regulator-max-microvolt = <1800000>;
  regulator-boot-on;
  regulator-always-on;
 };

 reg_3p3v: regulator-3p3v {
  compatible = "regulator-fixed";
  regulator-name = "fixed-3.3V";
  regulator-min-microvolt = <3300000>;
  regulator-max-microvolt = <3300000>;
  regulator-boot-on;
  regulator-always-on;
 };

 x2_clk: x2-clock {
  compatible = "fixed-clock";
  #clock-cells = <0>;
  clock-frequency = <24000000>;
 };
};

&eth0 {
 phy-handle = <&phy0>;
 phy-mode = "rgmii-id";

 pinctrl-0 = <&eth0_pins>;
 pinctrl-names = "default";
 status = "okay";
};

&eth0_rxc_rx_clk {
 clock-frequency = <125000000>;
};

&eth1 {
 phy-handle = <&phy1>;
 phy-mode = "rgmii-id";

 pinctrl-0 = <&eth1_pins>;
 pinctrl-names = "default";
 status = "okay";
};

&eth1_rxc_rx_clk {
 clock-frequency = <125000000>;
};

&extal_clk {
 clock-frequency = <24000000>;
};

&i2c0 {
 pinctrl-0 = <&i2c0_pins>;
 pinctrl-names = "default";

 versa3: clock-generator@68 {
  compatible = "renesas,5p35023";
  reg = <0x68>;
  #clock-cells = <1>;
  clocks = <&x2_clk>;

  assigned-clocks = <&versa3 1>, <&versa3 2>,
      <&versa3 3>, <&versa3 4>;
  assigned-clock-rates = <12288000>, <11289600>,
           <12288000>, <25000000>;
 };
};

&mdio0 {
 phy0: ethernet-phy@7 {
  compatible = "ethernet-phy-id0022.1640";
  reg = <7>;
  interrupts-extended = <&icu 3 8>;
  rxc-skew-psec = <1400>;
  txc-skew-psec = <1400>;
  rxdv-skew-psec = <0>;
  txen-skew-psec = <0>;
  rxd0-skew-psec = <0>;
  rxd1-skew-psec = <0>;
  rxd2-skew-psec = <0>;
  rxd3-skew-psec = <0>;
  txd0-skew-psec = <0>;
  txd1-skew-psec = <0>;
  txd2-skew-psec = <0>;
  txd3-skew-psec = <0>;
 };
};

&mdio1 {
 phy1: ethernet-phy@7 {
  compatible = "ethernet-phy-id0022.1640";
  reg = <7>;
  interrupts-extended = <&icu 16 8>;
  rxc-skew-psec = <1400>;
  txc-skew-psec = <1400>;
  rxdv-skew-psec = <0>;
  txen-skew-psec = <0>;
  rxd0-skew-psec = <0>;
  rxd1-skew-psec = <0>;
  rxd2-skew-psec = <0>;
  rxd3-skew-psec = <0>;
  txd0-skew-psec = <0>;
  txd1-skew-psec = <0>;
  txd2-skew-psec = <0>;
  txd3-skew-psec = <0>;
 };
};

&pinctrl {
 eth0_pins: eth0 {
  txc {
   pinmux = <((11) * 8 + (1) | ((1) << 16))>;
   power-source = <1800>;
   output-enable;
   drive-strength-microamp = <5200>;
  };

  ctrl {
   pinmux = <((10) * 8 + (0) | ((1) << 16))>,
     <((10) * 8 + (1) | ((1) << 16))>,
     <((10) * 8 + (2) | ((1) << 16))>,
     <((10) * 8 + (3) | ((1) << 16))>,
     <((11) * 8 + (0) | ((1) << 16))>,
     <((11) * 8 + (2) | ((1) << 16))>,
     <((11) * 8 + (3) | ((1) << 16))>,
     <((11) * 8 + (4) | ((1) << 16))>,
     <((11) * 8 + (5) | ((1) << 16))>,
     <((11) * 8 + (6) | ((1) << 16))>,
     <((11) * 8 + (7) | ((1) << 16))>,
     <((12) * 8 + (0) | ((1) << 16))>,
     <((12) * 8 + (1) | ((1) << 16))>,
     <((12) * 8 + (2) | ((15) << 16))>;
     power-source = <1800>;
  };
 };

 eth1_pins: eth1 {
  txc {
   pinmux = <((14) * 8 + (1) | ((1) << 16))>;
   power-source = <1800>;
   output-enable;
   drive-strength-microamp = <5200>;
  };

  ctrl {
   pinmux = <((13) * 8 + (0) | ((1) << 16))>,
     <((13) * 8 + (1) | ((1) << 16))>,
     <((13) * 8 + (2) | ((1) << 16))>,
     <((13) * 8 + (3) | ((1) << 16))>,
     <((14) * 8 + (0) | ((1) << 16))>,
     <((14) * 8 + (2) | ((1) << 16))>,
     <((14) * 8 + (3) | ((1) << 16))>,
     <((14) * 8 + (4) | ((1) << 16))>,
     <((14) * 8 + (5) | ((1) << 16))>,
     <((14) * 8 + (6) | ((1) << 16))>,
     <((14) * 8 + (7) | ((1) << 16))>,
     <((15) * 8 + (0) | ((1) << 16))>,
     <((15) * 8 + (1) | ((1) << 16))>,
     <((15) * 8 + (2) | ((15) << 16))>;
     power-source = <1800>;
  };
 };

 i2c0_pins: i2c0 {
  pinmux = <((21) * 8 + (2) | ((4) << 16))>,
    <((21) * 8 + (3) | ((4) << 16))>;
 };
};

&wdt0 {
 timeout-sec = <60>;
 status = "okay";
};
# 31 "arch/arm64/boot/dts/renesas/r9a08g046l48-smarc.dts" 2
# 1 "arch/arm64/boot/dts/renesas/renesas-smarc2.dtsi" 1
# 38 "arch/arm64/boot/dts/renesas/renesas-smarc2.dtsi"
/ {
 model = "Renesas RZ SMARC Carrier-II Board";
 compatible = "renesas,smarc2-evk";

 chosen {
  bootargs = "ignore_loglevel";
  stdout-path = "serial3:115200n8";
 };

 can_transceiver0: can-phy0 {
  compatible = "ti,tcan1042";
  #phy-cells = <0>;
  max-bitrate = <8000000>;
  status = "disabled";
 };

 can_transceiver1: can-phy1 {
  compatible = "ti,tcan1042";
  #phy-cells = <0>;
  max-bitrate = <8000000>;
  status = "disabled";
 };

 keys: keys {
  compatible = "gpio-keys";

  key-1 {
   interrupts-extended = <&pinctrl ((19) * 8 + (3)) 2>;
   linux,code = <2>;
   label = "USER_SW1";
   wakeup-source;
   debounce-interval = <20>;
  };

  key-2 {
   interrupts-extended = <&pinctrl ((6) * 8 + (4)) 2>;
   linux,code = <3>;
   label = "USER_SW2";
   wakeup-source;
   debounce-interval = <20>;
  };

  key-3 {
   interrupts-extended = <&pinctrl ((6) * 8 + (5)) 2>;
   linux,code = <4>;
   label = "USER_SW3";
   wakeup-source;
   debounce-interval = <20>;
  };
 };
};

&canfd {
 status = "okay";
};

&i2c0 {
 status = "okay";
 clock-frequency = <400000>;
};

&pcie {
 status = "okay";
};

&scif0 {
 status = "okay";
};

&sdhi1 {
 bus-width = <4>;
 sd-uhs-sdr50;
 sd-uhs-sdr104;

 status = "okay";
};
# 32 "arch/arm64/boot/dts/renesas/r9a08g046l48-smarc.dts" 2

/ {
 model = "Renesas SMARC EVK version 2 based on r9a08g046l48";
 compatible = "renesas,smarc2-evk", "renesas,rzg3l-smarcm",
       "renesas,r9a08g046l48", "renesas,r9a08g046";

 aliases {
  i2c2 = &i2c2;
  i2c3 = &i2c3;
  serial0 = &rsci2;
  serial1 = &rsci3;
  serial2 = &rsci1;
  serial3 = &scif0;
 };


 snd_rzg3l: sound {
  compatible = "simple-audio-card";
  simple-audio-card,name = "snd_rzg3l";
  #address-cells = <1>;
  #size-cells = <0>;

  ssi_link_play: simple-audio-card,dai-link@0 {
   reg = <0>;
   format = "i2s";
   bitclock-master = <&cpu_dai>;
   frame-master = <&cpu_dai>;
   mclk-fs = <256>;

   cpu_dai: cpu {
    sound-dai = <&ssi0>;
   };

   codec_dai: codec {
    sound-dai = <&da7212>;
    clocks = <&versa3 1>;
   };
  };
 };

};

&i2c2 {
 pinctrl-0 = <&i2c2_pins>;
 pinctrl-names = "default";

 status = "okay";
};


&i2c3 {
 pinctrl-0 = <&i2c3_pins>;
 pinctrl-names = "default";

 status = "okay";

 da7212: codec@1a {
  compatible = "dlg,da7212";
  reg = <0x1a>;

  clocks = <&versa3 1>;
  clock-names = "mclk";

  #sound-dai-cells = <0>;

  dlg,micbias1-lvl = <2500>;
  dlg,micbias2-lvl = <2500>;
  dlg,dmic-data-sel = "lrise_rfall";
  dlg,dmic-samplephase = "between_clkedge";
  dlg,dmic-clkrate = <3000000>;

  VDDA-supply = <&reg_1p8v>;
  VDDSP-supply = <&reg_3p3v>;
  VDDMIC-supply = <&reg_3p3v>;
  VDDIO-supply = <&reg_1p8v>;
 };
};


&keys {
# 123 "arch/arm64/boot/dts/renesas/r9a08g046l48-smarc.dts"
};

&pinctrl {
 audio_clk_pins: audio-clock {
  pinmux = <((17) * 8 + (4) | ((6) << 16))>,
    <((17) * 8 + (5) | ((6) << 16))>;
 };

 i2c2_pins: i2c2 {
  pinmux = <((10) * 8 + (4) | ((4) << 16))>,
    <((10) * 8 + (5) | ((4) << 16))>;
 };

 i2c3_pins: i2c3 {
  pinmux = <((2) * 8 + (0) | ((4) << 16))>,
    <((2) * 8 + (1) | ((4) << 16))>;
 };

 rsci1_pins: rsci1 {
  pinmux = <((13) * 8 + (4) | ((5) << 16))>,
    <((13) * 8 + (5) | ((5) << 16))>,
    <((13) * 8 + (6) | ((6) << 16))>,
    <((13) * 8 + (7) | ((5) << 16))>;
  bias-pull-up;
 };

 rsci2_pins: rsci2 {
  pinmux = <((7) * 8 + (6) | ((5) << 16))>,
    <((7) * 8 + (7) | ((5) << 16))>,
    <((8) * 8 + (0) | ((6) << 16))>,
    <((8) * 8 + (1) | ((5) << 16))>;
  bias-pull-up;
  power-source = <1800>;
 };

 rsci3_pins: rsci3 {
  pinmux = <((8) * 8 + (2) | ((5) << 16))>,
    <((8) * 8 + (3) | ((5) << 16))>;
  bias-pull-up;
  power-source = <1800>;
 };

 rspi2_pins: rspi2 {
  pinmux = <((6) * 8 + (0) | ((2) << 16))>,
    <((6) * 8 + (1) | ((2) << 16))>,
    <((6) * 8 + (2) | ((2) << 16))>,
    <((6) * 8 + (3) | ((2) << 16))>;
    power-source = <1800>;
 };

 scif0_pins: scif0 {
  pins = "SCIF0_TXD", "SCIF0_RXD";
  power-source = <1800>;
 };

 ssi0_pins: ssi0 {
  pinmux = <((17) * 8 + (0) | ((9) << 16))>,
    <((17) * 8 + (1) | ((9) << 16))>,
    <((17) * 8 + (2) | ((9) << 16))>,
    <((17) * 8 + (3) | ((9) << 16))>;
 };
};


&rsci1 {
 pinctrl-0 = <&rsci1_pins>;
 pinctrl-names = "default";

 uart-has-rtscts;

 status = "okay";
};



&rsci2 {
 pinctrl-0 = <&rsci2_pins>;
 pinctrl-names = "default";

 uart-has-rtscts;

 status = "okay";
};



&rsci3 {
 pinctrl-0 = <&rsci3_pins>;
 pinctrl-names = "default";

 status = "okay";
};



&rspi2 {
 pinctrl-0 = <&rspi2_pins>;
 pinctrl-names = "default";
 #address-cells = <1>;
 #size-cells = <0>;

 status = "okay";
};


&scif0 {
 pinctrl-0 = <&scif0_pins>;
 pinctrl-names = "default";
};


&ssi0 {
 clocks = <&cpg 1 77>,
   <&cpg 1 78>,
   <&versa3 2>, <&versa3 3>;
 pinctrl-0 = <&audio_clk_pins>, <&ssi0_pins>;
 pinctrl-names = "default";

 status = "okay";
};
