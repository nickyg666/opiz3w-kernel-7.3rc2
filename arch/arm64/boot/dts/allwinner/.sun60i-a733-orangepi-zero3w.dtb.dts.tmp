&dsi1 {
 status = "disabled";
 pinctrl-0 = <&dsi1_4lane_pins_a>;
 pinctrl-1 = <&dsi1_4lane_pins_b>;
 pinctrl-names = "active","sleep";

 ports {
  dsi1_out: port@1{
   dsi_out_panel: endpoint {
    remote-endpoint = <&panel_input>;
   };
  };
 };
 panel: panel@0 {
  compatible = "allwinner,virtual-panel";
  status = "okay";
  reg = <0>;
  ports {
   panel_in: port@0 {
    reg = <0>;
    panel_input: endpoint@0 {
     reg = <0>;
     remote-endpoint = <&dsi_out_panel>;
    };
   };
   panel_out: port@1 {
    reg = <1>;
    panel_output_0: endpoint@0 {
     reg = <0>;
     remote-endpoint = <&panel0_in>;
    };
   };
  };
 };
};

&serdes {
 udp-disable = <1>;
 status = "okay";
 combophy0: combo-phy0@6c01000{
  lane_invert = <1 1 1 1>;

  lane_remap = <0 1 2 3>;



  typec_remap = <0 1 2 3>;
 };
};

&edp0 {


 compatible = "allwinner,drm-dp";




 status = "okay";
 edp_colordepth = <8>;
 edp_color_fmt = <0>;
 fps_limit_60 = <1>;


 vdd-edp-supply = <&reg_dcdc2>;

 extcon = <&serdes>;
 blacklist_modes = "4096x2160@60",
     "4096x2160@59",
     "4096x2160@50",
     "4096x2160@49",
     "4096x2160@30",
     "4096x2160@29",
     "3840x2160@60",
     "3840x2160@59",
     "3840x2160@50",
     "3840x2160@49";

 ports {
  edp_out: port@1 {
   edp_panel_out: endpoint@0 {
    reg = <0>;
    remote-endpoint = <&edp_panel_in>;
   };
  };
 };
};
# 2973 "arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-zero3w.dts"
&hdmi0 {
 dcdc2-supply = <&reg_dcdc2>;
 cldo2-supply = <&reg_cldo2>;
 hdmi_power0 = "dcdc2";
 hdmi_power1 = "cldo2";
 hdmi_power_cnt = <2>;
# 2999 "arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-zero3w.dts"
 hdmi_hdcp1x_enable = <1>;
 hdmi_hdcp2x_enable = <1>;
 hdmi_cec_enable = <1>;
 hdmi_clock_source = <0>;
 hdmi_resistor_select = <1>;
 hdmi_ddc_index = <20>;
 priority = <6>;


 snps_phy = <
   25000 185625 0x0007 0x8160 0x8188
  185625 185625 0x0007 0x8160 0x8198
  185625 340000 0x0004 0x8040 0x8E85
  340000 600000 0x0000 0x80c0 0x82F6>;

 status = "okay";
};

