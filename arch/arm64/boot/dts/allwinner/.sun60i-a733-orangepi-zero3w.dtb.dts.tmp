&addr_mgt {
 compatible = "allwinner,sunxi-addr_mgt";
 type_addr_wifi = <0x0>;
 type_addr_bt = <0x0>;
 type_addr_eth = <0x0>;
 status = "okay";
};

&rfkill {
 compatible = "allwinner,sunxi-rfkill";
 chip_en;
 power_en;
 pinctrl-0;
 pinctrl-names;
 status = "okay";


 wlan {
  compatible = "allwinner,sunxi-wlan";
  clocks;
  clock-names;
  wlan_power = "axp8191-bldo5", "axp8191-cldo1";
  wlan_power_vol= <1800000>, <1800000>;
  wlan_busnum = <0x1>;
  wlan_regon = <&r_pio 1 1 0>;
