# 4516 "arch/arm64/boot/dts/allwinner/sun60iw2p1.dtsi"
  gpu: gpu@1800000 {
   compatible = "img,img-bxm-4-64", "img,img-rogue";
   reg = <0x0 0x01800000 0x0 0x8ffff>;
   interrupts = <0 63 4>;
   clocks = <&ccu 136>,
     <&ccu 23>,
     <&ccu 137>;
   clock-names = "core", "mem", "sys";
   power-domains = <&pck600 6>,
    <&pck600 5>;
   power-domain-names = "a", "b";
   resets = <&ccu 32>;
   operating-points-v2 = <&gpu_opp_table>;
   #cooling-cells = <2>;
  };
# 4557 "arch/arm64/boot/dts/allwinner/sun60iw2p1.dtsi"
  gpu_opp_table: gpu-opp-table {
   compatible = "allwinner, img-operating-points";
# 4581 "arch/arm64/boot/dts/allwinner/sun60iw2p1.dtsi"
   opp@400000000 {
    opp-hz = /bits/ 64 <400000000>;
