    opp-microvolt-vf0000 = <960000>;
    opp-microvolt-vf0100 = <960000>;
    opp-microvolt-vf0101 = <920000>;
    opp-microvolt-vf0200 = <960000>;
    opp-microvolt-vf0201 = <880000>;
