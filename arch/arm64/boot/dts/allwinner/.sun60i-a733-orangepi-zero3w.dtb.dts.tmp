   clock-names = "ahb", "mmc", "mmc_store", "mmc_mbus", "mmc_msi_lite";
   resets = <&ccu 35>;
   reset-names = "ahb";
   interrupts = <0 161 4>;
   pinctrl-names = "default","mmc_1v8";
   pinctrl-0 = <&sdc0_pins_a &sdc0_pins_f>;
   pinctrl-1 = <&sdc0_pins_b &sdc0_pins_g>;
   status = "disabled";

   max-frequency = <150000000>;
  };

  mmc1: mmc@4021000 {
   compatible = "allwinner,sun60i-a733-mmc",
         "allwinner,sun20i-d1-mmc";
   reg = <0x0 0x04021000 0x0 0x1000>;
   clocks = <&ccu 146>,
    <&ccu 145>,
