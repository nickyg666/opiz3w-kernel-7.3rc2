&gpu {
 status = "okay";
};

&gpu_opp_table {
 status = "okay";
};
# 4237 "arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-zero3w.dts"
&mmc1 {
 compatible = "allwinner,sunxi-mmc-v5p3x", "allwinner,sun60i-a733-mmc", "allwinner,sun20i-d1-mmc";
 device_type = "sdc1";
 max-frequency = <208000000>;
 bus-width = <4>;
 no-mmc;
 no-sd;
 cap-sd-highspeed;
 cap-sdio-irq;
 ignore-pm-notify;
 keep-power-in-suspend;
 sunxi-dly-208M = <0 0 0 0 0 0>;
 execute_tuning_in_kernel;
 ctl-spec-caps = <0x428>;

 sd-uhs-sdr25;
 sd-uhs-sdr50;
 sd-uhs-ddr50;
 sd-uhs-sdr104;
 sunxi-dis-signal-vol-sw;
 status = "okay";
};
# 4270 "arch/arm64/boot/dts/allwinner/sun60i-a733-orangepi-zero3w.dts"
&ufs {
 vcc-supply = <&reg_dldo6>;
 vccq-supply = <&reg_dcdc8>;
 vccq2-supply = <&reg_dcdc8>;
 status = "okay";
};
