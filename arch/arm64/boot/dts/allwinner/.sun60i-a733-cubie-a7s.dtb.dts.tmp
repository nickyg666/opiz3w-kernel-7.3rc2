 s_twi1_pins_default: s_twi1@0 {
  pins = "PL12", "PL13";
  function = "s_twi1";
  drive-strength = <30>;

 };

 s_twi1_pins_sleep: s_twi1@1 {
  pins = "PL12", "PL13";
  function = "gpio_in";
 };

