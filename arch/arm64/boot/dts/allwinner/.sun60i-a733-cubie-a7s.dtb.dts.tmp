  r_pio: pinctrl@7025000 {
   #address-cells = <1>;
   compatible = "allwinner,sun60iw2-r-pinctrl";
   reg = <0x0 0x07025000 0x0 0x410>;
   interrupt-parent = <&gic>;
   interrupts = <0 198 4>,
    <0 200 4>;
   clocks = <&r_ccu 1>, <&dcxo24M>, <&rtc_ccu 3>;
   clock-names = "apb", "hosc", "losc";
   gpio-controller;
   #gpio-cells = <3>;
   interrupt-controller;
   #interrupt-cells = <3>;

   r_i2c0_pins: s_twi0@0 {
    pins = "PL0", "PL1";
    function = "s_twi0";
    drive-strength = <10>;
    bias-pull-up;
   };
  };

  wdt: watchdog@2050000 {
   compatible = "allwinner,sun55i-a523-wdt";
   reg = <0x0 0x02050000 0x0 0x20>;
   interrupts = <0 106 4>;
   status = "okay";
  };

  dma: dma-controller@4601000 {
   compatible = "allwinner,dma-v106";
   reg = <0x0 0x04601000 0x0 0x2000>;
   interrupts = <0 111 4>;
   clocks = <&ccu 98>, <&ccu 97>;
   clock-names = "bus", "mbus";
   dma-channels = <16>;
   dma-requests = <64>;
   resets = <&ccu 11>;
   #dma-cells = <1>;
  };

  sid: sid@3006000 {
   compatible = "allwinner,sunxi-sid";
   reg = <0x0 0x03006000 0x0 0x1000>;
   #address-cells = <1>;
   #size-cells = <1>;
   non-secure-maxoffset = <0x7C>;
   non-secure-maxlen = <0x20>;

   secure_status {
    reg = <0x0 0>;
    offset = <0xa0>;
    size = <0x4>;
   };
   chipid {
    reg = <0x0 0>;
    offset = <0x200>;
    size = <0x10>;
   };
   rotpk {
    reg = <0x0 0>;
    offset = <0x140>;
    size = <0x20>;
   };
   ufs_cal_word_l {
    offset = <0x260>;
    mask = <0xfffffff>;
    shift = <0>;
   };
   ufs_cal_word_h {
    offset = <0x264>;
    mask = <0xfffffff>;
    shift = <0>;
   };
   dvfs_ori {
    offset = <0x24C>;
    mask = <0xff>;
    shift = <8>;
   };
   dvfs_bak {
    offset = <0x24C>;
    mask = <0xff>;
    shift = <16>;
   };
  };

  sram_ctrl: sram_ctrl@3000000 {
   compatible = "allwinner,sram_ctrl";
   reg = <0x0 0x03000000 0x0 0x184>;
   soc_ver {
    offset = <0x24>;
    mask = <0x7>;
    shift = <0>;
   };
  };

  ths: ths@2522000 {
   compatible = "allwinner,sun60iw2p1-ths";
   reg = <0x0 0x02522000 0x0 0x500>;
   clocks = <&ccu 188>,<&ccu 186>;
   clock-names = "bus","gpadc";
   resets = <&ccu 68>;
   #thermal-sensor-cells = <1>;
  };

  nsi0: nsi-controller@2020000 {
   compatible = "allwinner,sunxi-nsi-v2";
   interrupts = <0 43 4>;
   reg = <0x0 0x02020000 0x0 0x10000>,
    <0x0 0x0A030000 0x0 0x20000>;
   clocks = <&ccu 1>, <&ccu 53> , <&ccu 51>,
    <&ccu 6>, <&ccu 48>, <&ccu 52>,
    <&ccu 6>, <&ccu 138>;
   clock-names = "pll", "bus", "nsi", "nsi-p","gic", "nsi-cfg", "bus-p", "cpu_direct";
   resets = <&ccu 1>, <&ccu 2>;
   reset-names = "bus_nsi", "bus_nsi_cfg";
   clock-frequency = <600000000>,<600000000>;
   #nsi-cells = <1>;
   clk_path_type = <1>;
   topology_type = <2>;
   channel_type = <2>;
   master_clks = <6 2>,<10 4>,<18 2>,<19 2>,<20 2>,<32 2>,<33 2>;
   ia_pmu_data_unit = <16>;
   ra_pmu_data_unit = <64>;
   ta_pmu_data_unit = <64>;
   cpu_pmu_data_unit = <64>;
   sub_node_id_mapping;

   cpu0{
    id = <19>;
    cpu_direct_reg = <0x0A030000 0x2000>;
    cpu_direct_mux = <0x8000200 0x0 0>;
   };
   cpu1{
    id = <20>;
    cpu_direct_reg = <0x0A040000 0x2000>;
    cpu_direct_mux = <0x8000200 0x0 0>;
   };

   npu{
    id = <18>;
    power-domains = <&pck600 4>;
   };

   usb_pcie{
    id=<13>;
    power-domains = <&pck600 7>;
   };






   iommu0{
    id = <14>;
    mode = <0>;
    pri = <3>;
    select = <1>;
   };

   iommu1{
    id = <15>;
    mode = <0>;
    pri = <3>;
    select = <1>;
   };

   de {
    id = <2>;
    mode = <0>;
    pri = <2>;
    select = <1>;
    power-domains = <&pck600 1>;
   };

   eink {
    id = <3>;
    mode = <0>;
    pri = <1>;
    select = <1>;
    power-domains = <&pck600 1>;
   };

   di {
    id = <4>;
    mode = <0>;
    pri = <1>;
    select = <1>;
    power-domains = <&pck600 1>;
   };

   g2d {
    id = <5>;
    mode = <0>;
    pri = <1>;
    select = <1>;
    power-domains = <&pck600 1>;
   };

   ve0 {
    id = <7>;
    mode = <0>;
    pri = <1>;
    select = <1>;
    power-domains = <&pck600 2>;
   };

   ve1 {
    id = <8>;
    mode = <0>;
    pri = <1>;
    select = <1>;
    power-domains = <&pck600 2>;
   };

   ve2 {
    id = <9>;
    mode = <0>;
    pri = <1>;
    select = <1>;
    power-domains = <&pck600 3>;
   };


   isp {
    id = <16>;
    mode = <0>;
    pri = <2>;
    select = <1>;
    power-domains = <&pck600 0>;
   };

   csi {
    id = <17>;
    mode = <0>;
    pri = <2>;
    select = <1>;
    power-domains = <&pck600 0>;
   };
  };

  uart0: serial@2500000 {
   compatible = "snps,dw-apb-uart";
   reg = <0x0 0x02500000 0x0 0x400>;
   interrupts = <0 2 4>;
   reg-shift = <2>;
   reg-io-width = <4>;
   clocks = <&ccu 154>;
   resets = <&ccu 41>;
   status = "disabled";
  };

  uart1: serial@2501000 {
   compatible = "snps,dw-apb-uart";
   reg = <0x0 0x02501000 0x0 0x400>;
   interrupts = <0 3 4>;
   reg-shift = <2>;
   reg-io-width = <4>;
   clocks = <&ccu 155>;
   resets = <&ccu 42>;
   status = "disabled";
  };

  uart2: serial@2502000 {
   compatible = "snps,dw-apb-uart";
   reg = <0x0 0x02502000 0x0 0x400>;
   interrupts = <0 4 4>;
   reg-shift = <2>;
