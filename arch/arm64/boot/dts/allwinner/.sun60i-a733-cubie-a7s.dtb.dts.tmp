   interrupts = <0 163 4>;
   pinctrl-names = "default";
   pinctrl-0 = <&sdc2_pins_a &sdc2_pins_c &sdc2_pins_d>;
   status = "disabled";

   max-frequency = <150000000>;
  };

  mmc3: mmc@4023000 {

   compatible = "allwinner,sun50i-a100-emmc";
   reg = <0x0 0x04023000 0x0 0x1000>;
   clocks = <&ccu 150>,
    <&ccu 149>,
    <&ccu 77>,
    <&ccu 58>;
   clock-names = "ahb", "mmc", "mmc_mbus", "mmc_msi_lite";
   resets = <&ccu 38>;
