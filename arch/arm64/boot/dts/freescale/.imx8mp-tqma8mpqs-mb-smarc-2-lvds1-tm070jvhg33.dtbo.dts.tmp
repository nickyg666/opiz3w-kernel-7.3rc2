# 0 "arch/arm64/boot/dts/freescale/imx8mp-tqma8mpqs-mb-smarc-2-lvds1-tm070jvhg33.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/freescale/imx8mp-tqma8mpqs-mb-smarc-2-lvds1-tm070jvhg33.dtso"







/dts-v1/;
/plugin/;

&backlight_lvds1 {
 status = "okay";
};

&panel_lvds1{
 compatible = "tianma,tm070jvhg33";
 status = "okay";

 panel-timing {
  clock-frequency = <74250000>;
  hactive = <1280>;
  vactive = <800>;
  hfront-porch = <64>;
  hback-porch = <5>;
  hsync-len = <1>;
  vfront-porch = <40>;
  vback-porch = <2>;
  vsync-len = <1>;
  de-active = <1>;
 };
};

&lcdif2 {
 status = "okay";
};

&lvds_bridge {
 status = "okay";
};

&pwm2 {
 status = "okay";
};
