   0x00a8 0x0258 0x0000 0x05 0x00 0x31e
   0x00a4 0x0254 0x0000 0x05 0x00 0x31e
   0x00a0 0x0250 0x0000 0x05 0x00 0x31e
   0x00b4 0x0264 0x0000 0x05 0x00 0x31e
   0x00b0 0x0260 0x0000 0x05 0x00 0x31e
  >;
 };

 pinctrl_lpi2c3: lpi2c3grp {
  fsl,pins = <
