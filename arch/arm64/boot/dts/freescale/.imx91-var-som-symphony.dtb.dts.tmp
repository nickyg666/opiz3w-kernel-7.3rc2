   0x00bc 0x026c 0x0000 0x00 0x00 0x5fe
   0x00b8 0x0268 0x0000 0x00 0x00 0x57e
   0x00ac 0x025c 0x0000 0x00 0x00 0x57e
   0x00a8 0x0258 0x0000 0x00 0x00 0x57e
   0x00a4 0x0254 0x0000 0x00 0x00 0x57e
   0x00a0 0x0250 0x0000 0x00 0x00 0x57e
   0x00b4 0x0264 0x0000 0x00 0x00 0x5fe
   0x00b0 0x0260 0x0000 0x00 0x00 0x57e
   0x018c 0x033c 0x0000 0x05 0x00 0x51e
  >;
