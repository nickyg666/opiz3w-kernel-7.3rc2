# 0 "arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-peb-wlbt-05.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-peb-wlbt-05.dtso"





# 1 "./scripts/dtc/include-prefixes/dt-bindings/clock/imx8mp-clock.h" 1
# 7 "arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-peb-wlbt-05.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 8 "arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-peb-wlbt-05.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 9 "arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-peb-wlbt-05.dtso" 2
# 1 "arch/arm64/boot/dts/freescale/imx8mp-pinfunc.h" 1
# 10 "arch/arm64/boot/dts/freescale/imx8mp-phyboard-pollux-peb-wlbt-05.dtso" 2

/dts-v1/;
/plugin/;

&{/} {
 wlbt_clock: clock-32768 {
  compatible = "fixed-clock";
  clock-accuracy = <20000>;
  clock-frequency = <32768>;
  clock-output-names = "WIFIBT_SLOW_CLK";
  #clock-cells = <0>;
 };

 usdhc1_pwrseq: pwr-seq {
  compatible = "mmc-pwrseq-simple";
  post-power-on-delay-ms = <250>;
  reset-gpios = <&gpio5 5 1>;
 };
};

&iomuxc {
 pinctrl_uart3: uart3grp {
  fsl,pins = <
   0x0B4 0x314 0x5F4 0x4 0x0 0x140
   0x0B8 0x318 0x000 0x4 0x0 0x140
   0x230 0x490 0x5F8 0x0 0x6 0x140
   0x234 0x494 0x000 0x0 0x0 0x140
  >;
 };

 pinctrl_bluetooth: bluetoothgrp {
  fsl,pins = <
   0x0A4 0x304 0x000 0x5 0x0 0x106
   0x0A8 0x308 0x000 0x5 0x0 0x106
   0x0B0 0x310 0x000 0x5 0x0 0x106
  >;
 };

 pinctrl_usdhc1: usdhc1grp {
  fsl,pins = <
   0x08C 0x2EC 0x000 0x0 0x0 0x190
   0x090 0x2F0 0x000 0x0 0x0 0x1d0
   0x094 0x2F4 0x000 0x0 0x0 0x1d0
   0x098 0x2F8 0x000 0x0 0x0 0x1d0
   0x09C 0x2FC 0x000 0x0 0x0 0x1d0
   0x0A0 0x300 0x000 0x0 0x0 0x1d0
  >;
 };

 pinctrl_wifi: wifigrp {
  fsl,pins = <
   0x1DC 0x43C 0x000 0x5 0x0 0x106
  >;
 };
};

&uart3 {
 assigned-clocks = <&clk 144>;
 assigned-clock-parents = <&clk 49>;
 pinctrl-0 = <&pinctrl_uart3>;
 pinctrl-names = "default";
 uart-has-rtscts;
 status = "okay";

 bluetooth {
  compatible = "brcm,bcm43438-bt";
  pinctrl-0 = <&pinctrl_bluetooth>;
  pinctrl-names = "default";
  clock-names = "lpo";
  clocks = <&wlbt_clock>;
  device-wakeup-gpios = <&gpio2 6 0>;
  host-wakeup-gpios = <&gpio2 9 0>;
  max-speed = <3000000>;
  shutdown-gpios = <&gpio2 7 0>;
  vbat-supply = <&reg_vcc_3v3_sw>;
  vddio-supply = <&reg_vcc_1v8_exp_con>;
 };
};

&usdhc1 {
 #address-cells = <1>;
 #size-cells = <0>;
 pinctrl-0 = <&pinctrl_usdhc1>;
 pinctrl-names = "default";
 bus-width = <4>;
 max-frequency = <50000000>;
 mmc-pwrseq = <&usdhc1_pwrseq>;
 non-removable;
 vmmc-supply = <&reg_vcc_3v3_sw>;
 status = "okay";

 wifi@1 {
  compatible = "brcm,bcm4329-fmac";
  reg = <1>;
  pinctrl-0 = <&pinctrl_wifi>;
  pinctrl-names = "default";
  reset-gpios = <&gpio5 5 1>;
 };
};
