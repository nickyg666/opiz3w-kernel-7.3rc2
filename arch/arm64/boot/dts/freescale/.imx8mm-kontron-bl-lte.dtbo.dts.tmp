# 0 "arch/arm64/boot/dts/freescale/imx8mm-kontron-bl-lte.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/freescale/imx8mm-kontron-bl-lte.dtso"





/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 10 "arch/arm64/boot/dts/freescale/imx8mm-kontron-bl-lte.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 1
# 13 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/linux-event-codes.h" 1
# 14 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 2
# 11 "arch/arm64/boot/dts/freescale/imx8mm-kontron-bl-lte.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 12 "arch/arm64/boot/dts/freescale/imx8mm-kontron-bl-lte.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/leds/common.h" 1
# 13 "arch/arm64/boot/dts/freescale/imx8mm-kontron-bl-lte.dtso" 2
# 1 "arch/arm64/boot/dts/freescale/imx8mm-pinfunc.h" 1
# 14 "arch/arm64/boot/dts/freescale/imx8mm-kontron-bl-lte.dtso" 2

&{/} {
 compatible = "kontron,imx8mm-bl", "kontron,imx8mm-sl", "fsl,imx8mm";

 gpio-keys {
  compatible = "gpio-keys";
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_gpio_keys>;

  key-user {
   label = "user";
   linux,code = <0x100>;
   gpios = <&gpio4 12 1>;
  };
 };

 leds {
  compatible = "gpio-leds";
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_gpio_led_lte>;

  lte-led1-b {
   label = "lte-led1-blue";
   color = <3>;
   gpios = <&gpio3 17 0>;
  };

  lte-led1-g {
   label = "lte-led1-green";
   color = <2>;
   gpios = <&gpio3 18 0>;
  };

  lte-led1-r {
   label = "lte-led1-red";
   color = <1>;
   gpios = <&gpio5 23 0>;
  };

  lte-led2-b {
   label = "lte-led2-blue";
   color = <3>;
   gpios = <&gpio5 25 0>;
  };

  lte-led2-g {
   label = "lte-led2-green";
   color = <2>;
   gpios = <&gpio5 22 0>;
  };

  lte-led2-r {
   label = "lte-led2-red";
   color = <1>;
   gpios = <&gpio5 24 0>;
  };
 };
};

&ecspi3 {
 status = "disabled";
};

&i2c2 {
 #address-cells = <1>;
 #size-cells = <0>;
 clock-frequency = <400000>;
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_i2c2>;
 status = "okay";

 tpm@2e {
  compatible = "infineon,slb9673", "tcg,tpm-tis-i2c";
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_tpm>;
  reg = <0x2e>;
  interrupt-parent = <&gpio3>;
  interrupts = <11 8>;
 };
};

&gpio3 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_gpio3>;
 gpio-line-names = "", "", "", "",
     "", "", "", "",
     "", "", "VDD_IO_REF", "TPM_PIRQ#",
     "TPM_RESET# ", "", "", "",
     "", "LTE_LED1_B", "LTE_LED1_G", "",
     "";

 vdd-io-ref-hog {
  gpio-hog;
  gpios = <10 0>;
  line-name = "VDD_IO_REF";
  output-high;
 };

 tpm-reset-hog {
  gpio-hog;
  gpios = <12 1>;
  line-name = "TPM_RESET#";
  output-low;
 };
};

&gpio4 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_gpio4>;
 gpio-line-names = "", "", "LTE_RESET", "",
     "", "", "", "",
     "", "", "", "LTE_PWRKEY",
     "", "", "", "",
     "", "", "", "",
     "LTE_PWR_EN";
};

&gpio5 {
 gpio-line-names = "", "", "", "",
     "", "", "", "",
     "", "", "", "",
     "", "", "", "",
     "", "", "", "",
     "", "", "LTE_LED2_G", "LTE_LED1_R",
     "LTE_LED2_R", "LTE_LED2_B";
};

&iomuxc {
 pinctrl_gpio3: gpio3grp {
  fsl,pins = <
   0x11C 0x384 0x000 0x5 0x0 0x19
  >;
 };

 pinctrl_gpio4: gpio4grp {
  fsl,pins = <
   0x164 0x3CC 0x000 0x5 0x0 0x19
   0x188 0x3F0 0x000 0x5 0x0 0x19
   0x1AC 0x414 0x000 0x5 0x0 0x19
  >;
 };

 pinctrl_gpio_keys: gpiokeysgrp {
  fsl,pins = <
   0x18C 0x3F4 0x000 0x5 0x0 0x19
  >;
 };

 pinctrl_gpio_led_lte: gpioledltegrp {
  fsl,pins = <
   0x138 0x3A0 0x000 0x5 0x0 0x19
   0x13C 0x3A4 0x000 0x5 0x0 0x19
   0x238 0x4A0 0x000 0x5 0x0 0x19
   0x240 0x4A8 0x000 0x5 0x0 0x19
   0x234 0x49C 0x000 0x5 0x0 0x19
   0x23C 0x4A4 0x000 0x5 0x0 0x19
  >;
 };

 pinctrl_i2c2: i2c2grp {
  fsl,pins = <
   0x21C 0x484 0x000 0x0 0x0 0x40000083
   0x220 0x488 0x000 0x0 0x0 0x40000083
  >;
 };

 pinctrl_tpm: tpmgrp {
  fsl,pins = <
   0x120 0x388 0x000 0x5 0x0 0x19
   0x124 0x38C 0x000 0x5 0x0 0x39
  >;
 };
};
