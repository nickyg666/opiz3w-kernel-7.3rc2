&lcdif3 {
 status = "okay";
};

&usb3_phy0 {
 fsl,phy-tx-preemp-amp-tune-microamp = <1200>;
 vbus-supply = <&vbus>;
 status = "okay";
};

&usb3_0 {
 status = "okay";
};

&usb3_phy1 {
 fsl,phy-tx-preemp-amp-tune-microamp = <1200>;
 vbus-supply = <&vbus>;
 status = "okay";
};

&usb3_1 {
 status = "okay";
};

&usb_dwc3_0 {
 dr_mode = "host";
};

&usb_dwc3_1 {
 dr_mode = "host";
};

&usdhc2 {
 pinctrl-names = "default", "state_100mhz", "state_200mhz";
 pinctrl-0 = <&usdhc2_pins>;
 pinctrl-1 = <&usdhc2_100mhz_pins>;
 pinctrl-2 = <&usdhc2_200mhz_pins>;
 vmmc-supply = <&vmmc>;
