&uart1 {
 pinctrl-names = "default";
 pinctrl-0 = <&uart1_pins>;
 uart-has-rtscts;

 assigned-clocks = <&clk 142>;
 assigned-clock-parents = <&clk 49>;
 status = "okay";

 bluetooth {
  compatible = "brcm,bcm4345c5";
  device-wakeup-gpios = <&gpio2 7 0>;
  host-wakeup-gpios = <&gpio2 8 0>;
  shutdown-gpios = <&gpio2 10 0>;

  max-speed = <3000000>;
 };
};

&uart2 {
 pinctrl-names = "default";
 pinctrl-0 = <&uart2_pins>;
 status = "okay";
};

&usdhc1 {
 pinctrl-names = "default";
 pinctrl-0 = <&usdhc1_pins>;
 pinctrl-1 = <&usdhc1_100mhz_pins>;
 pinctrl-2 = <&usdhc1_200mhz_pins>;
 vmmc-supply = <&v_3_3>;
 vqmmc-supply = <&v_1_8>;
 bus-width = <4>;
 mmc-pwrseq = <&usdhc1_pwrseq>;
 status = "okay";
};

&usdhc3 {
 pinctrl-names = "default", "state_100mhz", "state_200mhz";
 pinctrl-0 = <&usdhc3_pins>;
 pinctrl-1 = <&usdhc3_100mhz_pins>;
 pinctrl-2 = <&usdhc3_200mhz_pins>;
 vmmc-supply = <&v_3_3>;
 vqmmc-supply = <&v_1_8>;
 bus-width = <8>;
 non-removable;
 status = "okay";
};

&wdog1 {
 pinctrl-names = "default";
 pinctrl-0 = <&wdog1_pins>;
 status = "okay";
};
# 11 "arch/arm64/boot/dts/freescale/imx8mp-cubox-m.dts" 2

/ {
 model = "SolidRun i.MX8MP CuBox-M";
 compatible = "solidrun,imx8mp-cubox-m",
       "solidrun,imx8mp-sr-som", "fsl,imx8mp";

 aliases {
  ethernet0 = &eqos;
  /delete-property/ ethernet1;
  rtc0 = &carrier_rtc;
  rtc1 = &snvs_rtc;
 };

 ir-receiver {
  compatible = "gpio-ir-receiver";
  gpios = <&gpio1 10 1>;
  pinctrl-names = "default";
  pinctrl-0 = <&ir_pins>;
  linux,autosuspend-period = <125>;
  wakeup-source;
 };

 leds {
  compatible = "gpio-leds";
  pinctrl-names = "default";
  pinctrl-0 = <&led_pins>;

  status {
   label = "status";
   color = <1>;
   gpios = <&gpio1 12 1>;
   function = "heartbeat";
  };
 };

 sound-hdmi {
  compatible = "fsl,imx-audio-hdmi";
  model = "audio-hdmi";
  audio-cpu = <&aud2htx>;
  hdmi-out;
 };

 vbus: regulator-vbus {
  compatible = "regulator-fixed";
  regulator-name = "vbus";
  gpio = <&gpio1 7 0>;
  enable-active-high;
  pinctrl-names = "default";
  pinctrl-0 = <&vbus_pins>;
  regulator-min-microvolt = <5000000>;
  regulator-max-microvolt = <5000000>;
 };

 vmmc: regulator-mmc {
  compatible = "regulator-fixed";
  pinctrl-names = "default";
  pinctrl-0 = <&vmmc_pins>;
  regulator-name = "vmmc";
  regulator-min-microvolt = <3300000>;
  regulator-max-microvolt = <3300000>;
  gpio = <&gpio2 19 1>;
  startup-delay-us = <250>;
 };
};

&aud2htx {
 status = "okay";
};

&fec {

 status = "disabled";
};

&hdmi_pvi {
 status = "okay";
};

&hdmi_tx {
 status = "okay";
};

&hdmi_tx_phy {
 status = "okay";
};

&i2c3 {
 carrier_rtc: rtc@32 {
  compatible = "epson,rx8130";
  reg = <0x32>;
 };
};

