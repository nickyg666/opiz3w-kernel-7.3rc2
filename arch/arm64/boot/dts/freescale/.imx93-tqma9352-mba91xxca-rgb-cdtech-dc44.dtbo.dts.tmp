# 0 "arch/arm64/boot/dts/freescale/imx93-tqma9352-mba91xxca-rgb-cdtech-dc44.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/freescale/imx93-tqma9352-mba91xxca-rgb-cdtech-dc44.dtso"







# 1 "./scripts/dtc/include-prefixes/dt-bindings/clock/imx93-clock.h" 1
# 9 "arch/arm64/boot/dts/freescale/imx93-tqma9352-mba91xxca-rgb-cdtech-dc44.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 10 "arch/arm64/boot/dts/freescale/imx93-tqma9352-mba91xxca-rgb-cdtech-dc44.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 11 "arch/arm64/boot/dts/freescale/imx93-tqma9352-mba91xxca-rgb-cdtech-dc44.dtso" 2

/dts-v1/;
/plugin/;

&backlight {
 status = "okay";
};

&display {
 compatible = "cdtech,s070swv29hg-dc44";
 status = "okay";
};

&dpi_bridge {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_rgbdisp>;
 status = "okay";
};

&dpi_to_panel {
 remote-endpoint = <&panel_in>;
};

&lcdif {
 assigned-clocks = <&clk 10>;
 assigned-clock-rates = <333333333>;
 status = "okay";
};

&lpi2c3 {
 #address-cells = <1>;
 #size-cells = <0>;

 polytouch: touchscreen@38 {
  compatible = "edt,edt-ft5406";
  reg = <0x38>;
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_touch>;
  interrupt-parent = <&gpio1>;
  interrupts = <11 2>;
  reset-gpios = <&expander2 0 1>;
  iovcc-supply = <&reg_3v3>;
  vcc-supply = <&reg_3v3>;
  gain = <20>;
  touchscreen-size-x = <800>;
  touchscreen-size-y = <480>;
 };
};

&media_blk_ctrl {
 status = "okay";
};

&panel_in {
 remote-endpoint = <&dpi_to_panel>;
};
