# 1 "arch/arm64/boot/dts/freescale/imx8mp-dhcom-overlay-panel-clock.dtsi" 1







&media_blk_ctrl {





 assigned-clocks = <&clk 97>,
     <&clk 98>,
     <&clk 172>,
     <&clk 313>,
     <&clk 19>,
     <&clk 20>;
 assigned-clock-parents = <&clk 65>,
     <&clk 56>,
     <&clk 39>,
     <&clk 40>;
 assigned-clock-rates = <500000000>, <200000000>,
          <0>, <0>, <0>, <0>;
};

&tc_bridge {
 assigned-clocks = <&clk 317>,
     <&clk 319>,
     <&clk 47>;
 assigned-clock-parents = <&clk 47>;
};
# 12 "arch/arm64/boot/dts/freescale/imx8mp-dhcom-overlay-panel-common.dtsi" 2

&{/} {
 display_bl: display-bl {
  compatible = "pwm-backlight";
  brightness-levels = <0 16 22 30 40 55 75 102 138 188 255>;
  default-brightness-level = <8>;
  enable-gpios = <&gpio1 0 0>;
  status = "okay";
 };

 panel: panel {
  backlight = <&display_bl>;
  power-supply = <&reg_vdd_3p3v_awo>;

  port {
   panel_in: endpoint {
   };
  };
 };
};
# 7 "arch/arm64/boot/dts/freescale/imx8mp-dhcom-overlay-panel-dpi.dtsi" 2

&lcdif1 {
 status = "okay";
};

&mipi_dsi {
 status = "okay";
};

&panel_in {
 remote-endpoint = <&tc_bridge_out>;
};

&tc_bridge {
 status = "okay";

 ports {
  #address-cells = <1>;
  #size-cells = <0>;

  port@1 {
   reg = <1>;

   tc_bridge_out: endpoint {
    remote-endpoint = <&panel_in>;
   };
  };
 };
};
# 10 "arch/arm64/boot/dts/freescale/imx8mp-dhcom-overlay-panel-etm0700g0edh6.dtsi" 2

&{/} {
 led {
  led-0 {

   status = "disabled";
  };
 };
};

&i2c_dhpdk_panel {
 #address-cells = <1>;
 #size-cells = <0>;

 touchscreen@38 {
  compatible = "edt,edt-ft5406";
  reg = <0x38>;
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_dhcom_e>;

  interrupt-parent = <&gpio5>;
  interrupts = <22 2>;
 };
};

&display_bl {
 pwms = <&pwm1 0 5000000 (1 << 0)>;
};

&mipi_dsi {




 samsung,burst-clock-frequency = <500000000>;
};

&panel {
 compatible = "edt,etm0700g0edh6";
};

&pwm1 {
 status = "okay";
};
# 9 "arch/arm64/boot/dts/freescale/imx8mp-dhcom-pdk2-overlay-560-300-x12.dtso" 2
# 1 "arch/arm64/boot/dts/freescale/imx8mp-pinfunc.h" 1
# 10 "arch/arm64/boot/dts/freescale/imx8mp-dhcom-pdk2-overlay-560-300-x12.dtso" 2

&{/} {
 led {
  led-0 {

   status = "disabled";
  };
 };
};

&pinctrl_dhcom_e {
 fsl,pins = <

  0x220 0x480 0x000 0x5 0x0 0x40000000
 >;
};
