# 1 "arch/arm64/boot/dts/freescale/imx8mp-dhcom-overlay-panel-common.dtsi" 1





# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 7 "arch/arm64/boot/dts/freescale/imx8mp-dhcom-overlay-panel-common.dtsi" 2
