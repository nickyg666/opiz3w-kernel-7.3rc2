# 0 "arch/arm64/boot/dts/freescale/imx8mp-hummingboard-iiot-rs485-b.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/freescale/imx8mp-hummingboard-iiot-rs485-b.dtso"







/dts-v1/;
/plugin/;

&uart4 {
 linux,rs485-enabled-at-boot-time;
};

