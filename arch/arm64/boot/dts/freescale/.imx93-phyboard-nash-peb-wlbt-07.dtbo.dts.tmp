# 0 "arch/arm64/boot/dts/freescale/imx93-phyboard-nash-peb-wlbt-07.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/freescale/imx93-phyboard-nash-peb-wlbt-07.dtso"






/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 11 "arch/arm64/boot/dts/freescale/imx93-phyboard-nash-peb-wlbt-07.dtso" 2
# 1 "arch/arm64/boot/dts/freescale/imx93-pinfunc.h" 1
# 12 "arch/arm64/boot/dts/freescale/imx93-phyboard-nash-peb-wlbt-07.dtso" 2

&{/} {
 usdhc3_pwrseq: usdhc3-pwrseq {
  compatible = "mmc-pwrseq-simple";
  reset-gpios = <&gpio4 29 1>;
 };
};

&lpuart5 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_uart5>;
 status = "okay";

 bluetooth {
  compatible = "nxp,88w8987-bt";
 };
};







&usdhc3 {
 pinctrl-names = "default", "sleep";
 pinctrl-0 = <&pinctrl_usdhc3>, <&pinctrl_wlbt>;
 pinctrl-1 = <&pinctrl_usdhc3_sleep>, <&pinctrl_wlbt>;
 mmc-pwrseq = <&usdhc3_pwrseq>;
 bus-width = <4>;
 keep-power-in-suspend;
 non-removable;
 wakeup-source;
 status = "okay";
};

&iomuxc {
 pinctrl_uart5: uart5grp {
  fsl,pins = <
   0x000C 0x01BC 0x0434 0x6 0x0 0x31e
   0x0000 0x01B0 0x0430 0x6 0x0 0x31e
   0x0008 0x01B8 0x042C 0x6 0x0 0x31e
   0x0004 0x01B4 0x0000 0x6 0x0 0x31e
  >;
 };


 pinctrl_usdhc3: usdhc3grp {
  fsl,pins = <
   0x0068 0x0218 0x0458 0x1 0x0 0x179e
   0x013C 0x02EC 0x045C 0x0 0x1 0x4000178e
   0x0140 0x02F0 0x0460 0x0 0x1 0x4000138e
   0x0144 0x02F4 0x0464 0x0 0x1 0x4000138e
   0x0148 0x02F8 0x0468 0x0 0x1 0x4000138e
   0x014C 0x02FC 0x046C 0x0 0x1 0x4000138e
  >;
 };

 pinctrl_usdhc3_sleep: usdhc3sleepgrp {
  fsl,pins = <
   0x0068 0x0218 0x0458 0x1 0x0 0x31e
   0x013C 0x02EC 0x045C 0x0 0x1 0x31e
   0x0140 0x02F0 0x0460 0x0 0x1 0x31e
   0x0144 0x02F4 0x0464 0x0 0x1 0x31e
   0x0148 0x02F8 0x0468 0x0 0x1 0x31e
   0x014C 0x02FC 0x046C 0x0 0x1 0x31e
  >;
 };

 pinctrl_wlbt: wlbtgrp {
  fsl,pins = <
   0x008C 0x023C 0x0000 0x5 0x0 0x31e
   0x0090 0x0240 0x0000 0x5 0x0 0x31e
   0x0094 0x0244 0x0000 0x5 0x0 0x31e
  >;
 };
};
