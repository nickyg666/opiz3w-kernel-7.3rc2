# 0 "arch/arm64/boot/dts/freescale/imx8mp-tx8p-ml81-moduline-display-106-av101hdt-a10.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/freescale/imx8mp-tx8p-ml81-moduline-display-106-av101hdt-a10.dtso"






# 1 "./scripts/dtc/include-prefixes/dt-bindings/clock/imx8mp-clock.h" 1
# 8 "arch/arm64/boot/dts/freescale/imx8mp-tx8p-ml81-moduline-display-106-av101hdt-a10.dtso" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 9 "arch/arm64/boot/dts/freescale/imx8mp-tx8p-ml81-moduline-display-106-av101hdt-a10.dtso" 2

# 1 "arch/arm64/boot/dts/freescale/imx8mp-pinfunc.h" 1
# 11 "arch/arm64/boot/dts/freescale/imx8mp-tx8p-ml81-moduline-display-106-av101hdt-a10.dtso" 2

/dts-v1/;
/plugin/;

&{/} {
 model = "GOcontroll Moduline Display with BOE av101hdt-a10 display";

 panel {
  compatible = "boe,av101hdt-a10";
  backlight = <&backlight>;
  enable-gpios = <&gpio1 7 0>;
  pinctrl-0 = <&pinctrl_panel>;
  pinctrl-names = "default";
  power-supply = <&reg_3v3_per>;
  reset-gpios = <&gpio1 9 1>;

  port {
   panel_lvds_in: endpoint {
    remote-endpoint = <&ldb_lvds_ch0>;
   };
  };
 };

 reg_vbus: regulator-vbus {
  compatible = "regulator-fixed";
  power-supply = <&reg_6v4>;
  regulator-always-on;
  regulator-max-microvolt = <5000000>;
  regulator-min-microvolt = <5000000>;
  regulator-name = "usb-c-vbus";
 };
};

&i2c4 {
 #address-cells = <1>;
 #size-cells = <0>;

 backlight: backlight@6f {
  compatible = "maxim,max25014";
  reg = <0x6f>;
  default-brightness = <50>;
  enable-gpios = <&gpio1 4 0>;
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_backlight>;
  maxim,iset = <7>;
  maxim,strings = <1 1 1 0>;
 };
};

&iomuxc {
 pinctrl_backlight: backlightgrp {
  fsl,pins = <
   0x024 0x284 0x000 0x0 0x0
    (0x40 | 0x100)
  >;
 };

 pinctrl_panel: panelgrp {
  fsl,pins = <
   0x030 0x290 0x000 0x0 0x0
    0x0
   0x038 0x298 0x000 0x0 0x0
    0x0
  >;
 };
};

&lcdif2 {
 status = "okay";
};

&lvds_bridge {
 assigned-clocks = <&clk 174>, <&clk 20>;

 assigned-clock-rates = <0>, <1054620000>;
 status = "okay";

 ports {
  port@1 {
   ldb_lvds_ch0: endpoint {
    remote-endpoint = <&panel_lvds_in>;
   };
  };
 };
};

&usb_dwc3_1 {
 dr_mode = "host";

 connector {
  compatible = "usb-c-connector";
  data-role = "host";
  pd-disable;
  typec-power-opmode = "default";
  vbus-supply = <&reg_vbus>;

  port {
   high_speed_ep: endpoint {
    remote-endpoint = <&usb1_hs_ep>;
   };
  };
 };

 port {
  usb1_hs_ep: endpoint {
   remote-endpoint = <&high_speed_ep>;
  };
 };
};
