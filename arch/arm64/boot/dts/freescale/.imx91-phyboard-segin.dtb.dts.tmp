 pinctrl_usdhc1_200mhz: usdhc1-200mhzgrp {
  fsl,pins = <
   0x0108 0x02b8 0x0000 0x00 0x00 0x11be
   0x010c 0x02bc 0x0000 0x00 0x00 0x139e
   0x0110 0x02c0 0x0000 0x00 0x00 0x139e
   0x0114 0x02c4 0x0000 0x00 0x00 0x13be
   0x0118 0x02c8 0x0000 0x00 0x00 0x13be
   0x011c 0x02cc 0x0000 0x00 0x00 0x13be
   0x0120 0x02d0 0x0000 0x00 0x00 0x13be
   0x0124 0x02d4 0x0000 0x00 0x00 0x13be
