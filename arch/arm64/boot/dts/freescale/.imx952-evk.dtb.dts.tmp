&xspi1 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_xspi1>;
 status = "okay";

 mt35xu01gbba: flash@0 {
  compatible = "jedec,spi-nor";
  reg = <0>;
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_xspi1_reset>;
  reset-gpios = <&gpio5 11 1>;
  #address-cells = <1>;
  #size-cells = <1>;
  spi-max-frequency = <200000000>;
  spi-tx-bus-width = <8>;
  spi-rx-bus-width = <8>;
 };
};
