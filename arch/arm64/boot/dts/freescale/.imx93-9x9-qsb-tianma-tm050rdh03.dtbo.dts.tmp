# 0 "arch/arm64/boot/dts/freescale/imx93-9x9-qsb-tianma-tm050rdh03.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/freescale/imx93-9x9-qsb-tianma-tm050rdh03.dtso"





# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 7 "arch/arm64/boot/dts/freescale/imx93-9x9-qsb-tianma-tm050rdh03.dtso" 2
# 1 "arch/arm64/boot/dts/freescale/imx93-9x9-qsb-ontat-kd50g21-40nt-a1.dtsi" 1





/dts-v1/;
/plugin/;


# 1 "arch/arm64/boot/dts/freescale/imx93-pinfunc.h" 1
# 11 "arch/arm64/boot/dts/freescale/imx93-9x9-qsb-ontat-kd50g21-40nt-a1.dtsi" 2

&{/} {
 backlight: backlight {
  compatible = "gpio-backlight";
  gpios = <&pcal6524 2 0>;
 };

 panel {
  compatible = "ontat,kd50g21-40nt-a1";
  backlight = <&backlight>;
  power-supply = <&reg_rpi_3v3>;

  port {
   panel_in: endpoint {
    remote-endpoint = <&dpi_to_panel>;
   };
  };
 };
};

&dpi_bridge {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_lcdif>;
 status = "okay";

 ports {
  #address-cells = <1>;
  #size-cells = <0>;

  port@1 {
   reg = <1>;

   dpi_to_panel: endpoint {
    remote-endpoint = <&panel_in>;
    bus-width = <18>;
   };
  };
 };
};

&iomuxc {
 pinctrl_lcdif: lcdifgrp {
  fsl,pins = <
   0x0010 0x01C0 0x0000 0x3 0x0 0x31e
   0x0014 0x01C4 0x0000 0x3 0x0 0x31e
   0x0018 0x01C8 0x0000 0x3 0x0 0x31e
   0x001C 0x01CC 0x0000 0x3 0x0 0x31e
   0x0020 0x01D0 0x0000 0x3 0x0 0x31e
   0x0024 0x01D4 0x0000 0x3 0x0 0x31e
   0x0028 0x01D8 0x0000 0x3 0x0 0x31e
   0x002C 0x01DC 0x0000 0x3 0x0 0x31e
   0x0030 0x01E0 0x0000 0x3 0x0 0x31e
   0x0034 0x01E4 0x0000 0x3 0x0 0x31e
   0x0038 0x01E8 0x0000 0x3 0x0 0x31e
   0x003C 0x01EC 0x0000 0x3 0x0 0x31e
   0x0040 0x01F0 0x0000 0x3 0x0 0x31e
   0x0044 0x01F4 0x0000 0x3 0x0 0x31e
   0x0048 0x01F8 0x0000 0x3 0x0 0x31e
   0x004C 0x01FC 0x0000 0x3 0x0 0x31e
   0x0050 0x0200 0x0000 0x3 0x0 0x31e
   0x0054 0x0204 0x0000 0x3 0x0 0x31e
   0x0058 0x0208 0x0000 0x3 0x0 0x31e
   0x005C 0x020C 0x0000 0x3 0x0 0x31e
   0x0060 0x0210 0x0000 0x3 0x0 0x31e
   0x0064 0x0214 0x0000 0x3 0x0 0x31e
  >;
 };
};

&lcdif {
 status = "okay";
};

&media_blk_ctrl {
 status = "okay";
};

&pcal6524 {







 exp-sel-hog {
  status = "disabled";
 };

 exp-high-sel-hog {
  gpio-hog;
  gpios = <22 0>;
  output-high;
 };
};

&sai3 {

 status = "disabled";
};
# 8 "arch/arm64/boot/dts/freescale/imx93-9x9-qsb-tianma-tm050rdh03.dtso" 2

&{/} {
 panel {
  compatible = "tianma,tm050rdh03";
  enable-gpios = <&pcal6524 8 0>;
 };
};
