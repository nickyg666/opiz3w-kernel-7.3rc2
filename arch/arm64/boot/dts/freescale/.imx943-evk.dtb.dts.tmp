    interrupts = <0 105 4>;
    #address-cells = <1>;
    #size-cells = <0>;
    clocks = <&scmi_clk 144>,
      <&scmi_clk 116>;
    clock-names = "per", "ipg";
    dmas = <&edma4 34 0 0>, <&edma4 35 0 0x1>;
    dma-names = "tx", "rx";
    status = "disabled";
   };

   lpspi7: spi@42710000 {
    compatible = "fsl,imx94-spi", "fsl,imx7ulp-spi";
    reg = <0x42710000 0x10000>;
    interrupts = <0 106 4>;
    #address-cells = <1>;
    #size-cells = <0>;
    clocks = <&scmi_clk 145>,
      <&scmi_clk 116>;
    clock-names = "per", "ipg";
    dmas = <&edma2 43 0 0>, <&edma2 44 0 0x1>;
    dma-names = "tx", "rx";
    status = "disabled";
   };

   lpspi8: spi@42720000 {
    compatible = "fsl,imx94-spi", "fsl,imx7ulp-spi";
    reg = <0x42720000 0x10000>;
    interrupts = <0 107 4>;
    #address-cells = <1>;
