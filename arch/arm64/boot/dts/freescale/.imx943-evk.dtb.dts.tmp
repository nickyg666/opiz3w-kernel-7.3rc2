   };

   mu11: mailbox@42730000 {
    compatible = "fsl,imx94-mu", "fsl,imx95-mu";
    reg = <0x42730000 0x10000>;
    interrupts = <0 278 4>;
    clocks = <&scmi_clk 116>;
    #mbox-cells = <2>;
    status = "disabled";
