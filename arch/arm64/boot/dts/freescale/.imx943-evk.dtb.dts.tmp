    clock-names = "per", "ipg";
    dmas = <&edma2 39 0 0>, <&edma2 40 0 0x1>;
    dma-names = "tx", "rx";
    status = "disabled";
   };

   lpi2c8: i2c@426e0000 {
    compatible = "fsl,imx94-lpi2c", "fsl,imx7ulp-lpi2c";
    reg = <0x426e0000 0x10000>;
