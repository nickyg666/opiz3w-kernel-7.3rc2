# 0 "arch/arm64/boot/dts/freescale/imx95-19x19-frdm-pro.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/freescale/imx95-19x19-frdm-pro.dts"





/dts-v1/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/pwm/pwm.h" 1
# 9 "arch/arm64/boot/dts/freescale/imx95-19x19-frdm-pro.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/usb/pd.h" 1
# 10 "arch/arm64/boot/dts/freescale/imx95-19x19-frdm-pro.dts" 2
