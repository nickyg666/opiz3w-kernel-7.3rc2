  "SODIMM_32",
  "SODIMM_26",
  "SODIMM_53",
  "SODIMM_55",
  "SODIMM_12",
  "SODIMM_14";
};

&gpio3 {
 gpio-line-names =
  "SODIMM_84",
  "SODIMM_78",
  "SODIMM_74",
  "SODIMM_80",
  "SODIMM_82",
  "SODIMM_70",
  "SODIMM_72",
  "SODIMM_76",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "PMIC_SD2_VSEL",
  "",
  "",
  "",
  "",
  "",
  "",
  "SODIMM_91",
  "SODIMM_218",
  "",
  "",
  "",
  "";
};

&gpio4 {
 gpio-line-names =
  "SODIMM_59",
  "SODIMM_57",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "",
  "SODIMM_193",
  "SODIMM_191",
  "SODIMM_215",
  "SODIMM_217",
  "SODIMM_219",
  "SODIMM_221",
  "SODIMM_211",
  "SODIMM_213",
  "SODIMM_199",
  "SODIMM_197",
  "SODIMM_201",
  "SODIMM_203",
  "SODIMM_205",
  "SODIMM_207",
  "SODIMM_216",
  "SODIMM_202";
};

&gpio5 {
 gpio-line-names =
  "SODIMM_56",
  "SODIMM_58",
  "SODIMM_60",
  "SODIMM_62",
  "SODIMM_46",
  "SODIMM_44",
  "SODIMM_42",
  "SODIMM_48",
  "SODIMM_66",
  "SODIMM_52",
  "SODIMM_54",
  "SODIMM_64",
  "SODIMM_212",
  "",
  "",
  "",
  "",
  "";
};


&i3c2 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_i3c2>;
 i2c-scl-hz = <400000>;
};


&lpi2c2 {
 pinctrl-names = "default", "gpio";
 pinctrl-0 = <&pinctrl_lpi2c2>, <&pinctrl_io_exp_int>;
 pinctrl-1 = <&pinctrl_lpi2c2_gpio>, <&pinctrl_io_exp_int>;
 clock-frequency = <400000>;
 scl-gpios = <&gpio1 2 (0 | (2 | 4))>;
 sda-gpios = <&gpio1 3 (0 | (2 | 4))>;
 single-master;

 status = "okay";

 som_gpio_expander: gpio@20 {
  compatible = "nxp,pcal6416";
  reg = <0x20>;
  #interrupt-cells = <2>;
  interrupt-controller;
  interrupt-parent = <&gpio1>;
  interrupts = <13 8>;
  #gpio-cells = <2>;
  gpio-controller;

  gpio-line-names =
   "SODIMM_220",
   "SODIMM_222",
   "SODIMM_17",
   "SODIMM_21",
   "SODIMM_244",
   "SODIMM_161",
   "SODIMM_157",
   "SODIMM_155",
   "SODIMM_185",
   "SODIMM_187",
   "USB_RECOV_CTRL#",
   "ENET1_INT#",
   "TPM_INT#",
   "TPM_CS#",
   "",
   "";
# 442 "arch/arm64/boot/dts/freescale/imx95-verdin.dtsi"
  usb_recov_ctrl: usb-recov-ctrl-hog {
   gpio-hog;
   gpios = <10 0>;
   line-name = "USB_RECOV_CTRL#";
   output-high;
  };
 };

 rtc_i2c: rtc@32 {
  compatible = "epson,rx8130";
  reg = <0x32>;
 };

 temperature-sensor@48 {
  compatible = "ti,tmp1075";
  reg = <0x48>;
 };

 som_eeprom: eeprom@50 {
  compatible = "st,24c02", "atmel,24c02";
  reg = <0x50>;
  pagesize = <16>;
 };
};


&lpi2c3 {
 pinctrl-names = "default", "gpio";
 pinctrl-0 = <&pinctrl_lpi2c3>;
 pinctrl-1 = <&pinctrl_lpi2c3_gpio>;
 clock-frequency = <100000>;
 scl-gpios = <&gpio2 29 (0 | (2 | 4))>;
 sda-gpios = <&gpio2 28 (0 | (2 | 4))>;
 single-master;
};


&lpi2c4 {
 pinctrl-names = "default", "gpio";
 pinctrl-0 = <&pinctrl_lpi2c4>;
 pinctrl-1 = <&pinctrl_lpi2c4_gpio>;
 clock-frequency = <100000>;
 scl-gpios = <&gpio2 31 (0 | (2 | 4))>;
 sda-gpios = <&gpio2 30 (0 | (2 | 4))>;
 single-master;
};


&lpi2c5 {
 pinctrl-names = "default", "gpio";
 pinctrl-0 = <&pinctrl_lpi2c5>;
 pinctrl-1 = <&pinctrl_lpi2c5_gpio>;
 clock-frequency = <100000>;
 scl-gpios = <&gpio2 23 (0 | (2 | 4))>;
 sda-gpios = <&gpio2 22 (0 | (2 | 4))>;
 single-master;
};


&lpspi6 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_lpspi6>, <&pinctrl_spi1_cs>;
 cs-gpios = <&gpio4 29 1>,
     <&som_gpio_expander 13 1>;

 status = "okay";

 som_tpm: tpm@1 {
  compatible = "infineon,slb9670", "tcg,tpm_tis-spi";
  reg = <0x1>;
  interrupt-parent = <&som_gpio_expander>;
  interrupts = <12 2>;




  spi-max-frequency = <12000000>;
 };
};


&lpuart1 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_uart1>;
};


&lpuart2 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_uart2>;
};


&lpuart7 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_uart7>;
 uart-has-rtscts;
};


&lpuart8 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_uart8>, <&pinctrl_uart8_cts>, <&pinctrl_uart8_rts>;
 uart-has-rtscts;
};

&mu7 {
 status = "okay";
};

&netc_blk_ctrl {
 status = "okay";
};

&netc_bus0 {
 msi-map = <0x0 &its 0x60 0x1>,
    <0x10 &its 0x61 0x1>,
    <0x20 &its 0x62 0x1>,
    <0x40 &its 0x63 0x1>,
    <0x50 &its 0x65 0x1>,
    <0x60 &its 0x66 0x1>,
    <0x80 &its 0x64 0x1>,
    <0xc0 &its 0x67 0x1>;
 iommu-map = <0x0 &smmu 0x20 0x1>,
      <0x10 &smmu 0x21 0x1>,
      <0x20 &smmu 0x22 0x1>,
      <0x40 &smmu 0x23 0x1>,
      <0x50 &smmu 0x25 0x1>,
      <0x60 &smmu 0x26 0x1>,
      <0x80 &smmu 0x24 0x1>,
      <0xc0 &smmu 0x27 0x1>;
};


&netc_emdio {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_emdio>;

 status = "okay";

 ethphy1: ethernet-phy@0 {
  reg = <0>;
  interrupt-parent = <&som_gpio_expander>;
  interrupts = <11 2>;
  ti,rx-internal-delay = <0x7>;
  ti,tx-internal-delay = <0x7>;
 };
};

&netc_timer {
 status = "okay";
};

&netcmix_blk_ctrl {
 status = "okay";
};


&pcie0 {

 reset-gpios = <&som_gpio_expander 4 1>;
};


&sai3 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_sai3>;
 assigned-clocks = <&scmi_clk 14>,
     <&scmi_clk 16>,
     <&scmi_clk 15>,
     <&scmi_clk 17>,
     <&scmi_clk (41 + 107)>;
 assigned-clock-parents = <0>, <0>, <0>, <0>,
     <&scmi_clk 15>;
 assigned-clock-rates = <3932160000>,
          <3612672000>, <393216000>,
          <361267200>, <12288000>;
 #sound-dai-cells = <0>;
 fsl,sai-mclk-direction-output;
};

&scmi_bbm {
 linux,code = <116>;
};

&thermal_zones {

 pf09-thermal {
  polling-delay = <2000>;
  polling-delay-passive = <250>;
  thermal-sensors = <&scmi_sensor 2>;

  trips {
   trip0 {
    hysteresis = <2000>;
    temperature = <155000>;
    type = "critical";
   };
  };
 };


 pf53-arm-thermal {
  polling-delay = <2000>;
  polling-delay-passive = <250>;
  thermal-sensors = <&scmi_sensor 4>;

  trips {
   trip0 {
    hysteresis = <2000>;
    temperature = <155000>;
    type = "critical";
   };
  };
 };


 pf53-soc-thermal {
  polling-delay = <2000>;
  polling-delay-passive = <250>;
  thermal-sensors = <&scmi_sensor 3>;

  trips {
   trip0 {
    hysteresis = <2000>;
    temperature = <155000>;
    type = "critical";
   };
  };
 };
};


&tpm4 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_tpm4>;
};


&tpm5 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_tpm5>;
};


&tpm6 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_tpm6>;
};


&usb2 {
 dr_mode = "otg";
 adp-disable;
 hnp-disable;
 srp-disable;
 usb-role-switch;
 vbus-supply = <&reg_usb1_vbus>;

 port {
  usb1_id: endpoint {
   remote-endpoint = <&usb_dr_connector>;
  };
 };
};


&usb3 {
 fsl,disable-port-power-control;
};

&usb3_dwc3 {
 dr_mode = "host";
};

&usb3_phy {
 vbus-supply = <&reg_usb2_vbus>;
};


&usdhc1 {
 pinctrl-names = "default", "state_100mhz", "state_200mhz";
 pinctrl-0 = <&pinctrl_usdhc1>;
 pinctrl-1 = <&pinctrl_usdhc1>;
 pinctrl-2 = <&pinctrl_usdhc1_200mhz>;
 bus-width = <8>;
 non-removable;
 no-sdio;
 no-sd;

 status = "okay";
};


&usdhc2 {
 pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
 pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_cd>;
 pinctrl-1 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_cd>;
 pinctrl-2 = <&pinctrl_usdhc2_200mhz>,<&pinctrl_usdhc2_cd>;
 pinctrl-3 = <&pinctrl_usdhc2_sleep>, <&pinctrl_usdhc2_cd>;
 cd-gpios = <&gpio3 0 1>;
 vmmc-supply = <&reg_usdhc2_vmmc>;
 vqmmc-supply = <&reg_usdhc2_vqmmc>;
};

&wdog3 {
 fsl,ext-reset-output;

 status = "okay";
};

