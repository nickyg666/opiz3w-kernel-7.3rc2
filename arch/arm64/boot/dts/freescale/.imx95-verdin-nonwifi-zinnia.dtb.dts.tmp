# 12 "arch/arm64/boot/dts/freescale/imx95-verdin-nonwifi-zinnia.dts" 2
# 1 "arch/arm64/boot/dts/freescale/imx95-verdin-nonwifi.dtsi" 1
# 11 "arch/arm64/boot/dts/freescale/imx95-verdin-nonwifi.dtsi"
&usdhc3 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_usdhc3>;

 status = "disabled";
};
# 13 "arch/arm64/boot/dts/freescale/imx95-verdin-nonwifi-zinnia.dts" 2
# 1 "arch/arm64/boot/dts/freescale/imx95-verdin-zinnia.dtsi" 1
# 11 "arch/arm64/boot/dts/freescale/imx95-verdin-zinnia.dtsi"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/leds/common.h" 1
# 12 "arch/arm64/boot/dts/freescale/imx95-verdin-zinnia.dtsi" 2


/ {
 aliases {
  eeprom1 = &carrier_eeprom;
 };

 leds {
  compatible = "gpio-leds";
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_zinnia_leds>;


  led-1 {
   color = <1>;
   default-state = "off";
   function = "status";
   function-enumerator = <1>;
   gpios = <&gpio5 7 0>;
  };


  led-2 {
   color = <3>;
   default-state = "off";
   function = "status";
   function-enumerator = <1>;
   gpios = <&gpio5 4 0>;
  };


  led-3 {
   color = <1>;
   default-state = "off";
   function = "status";
   function-enumerator = <3>;
   gpios = <&gpio5 5 0>;
  };


  led-4 {
   color = <2>;
   default-state = "off";
   function = "status";
   function-enumerator = <3>;
   gpios = <&gpio5 10 0>;
  };


  led-5 {
   color = <3>;
   default-state = "off";
   function = "status";
   function-enumerator = <3>;
   gpios = <&gpio2 20 0>;
  };


  led-6 {
   color = <1>;
   default-state = "off";
   function = "status";
   function-enumerator = <4>;
   gpios = <&gpio2 21 0>;
  };


  led-7 {
   color = <2>;
   default-state = "off";
   function = "status";
   function-enumerator = <4>;
   gpios = <&gpio2 26 0>;
  };


  led-8 {
   color = <3>;
   default-state = "off";
   function = "status";
   function-enumerator = <4>;
   gpios = <&gpio2 16 0>;
  };
 };


 zinnia-1v8-voltage {
  compatible = "voltage-divider";
  full-ohms = <39000>;

  io-channels = <&adc1 3>;
  output-ohms = <27000>;
 };

 zinnia-3v3-voltage {
  compatible = "voltage-divider";
  full-ohms = <54000>;

  io-channels = <&adc1 2>;
  output-ohms = <27000>;
 };

 zinnia-5v-voltage {
  compatible = "voltage-divider";
  full-ohms = <39000>;

  io-channels = <&adc1 1>;
  output-ohms = <12000>;
 };

 zinnia-input-voltage {
  compatible = "voltage-divider";
  full-ohms = <204700>;

  io-channels = <&adc1 0>;
  output-ohms = <4700>;
 };
};


&adc1 {
 status = "okay";
};


&enetc_port0 {
 status = "okay";
};


&enetc_port1 {
 phy-handle = <&ethphy2>;
 phy-mode = "rgmii-id";

 status = "okay";
};


&flexcan1 {
 status = "okay";
