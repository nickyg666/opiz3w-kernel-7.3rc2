};


&usb3 {
 status = "okay";
};

&usb3_phy {
 status = "okay";
};


&usdhc2 {
 status = "okay";
};

&scmi_iomuxc {
 pinctrl_uart8_cts_gpio: uart8ctsgrp {
  fsl,pins = <0x0048 0x024C 0x0000 0x00 0x00 0x51e>;
 };

 pinctrl_zinnia_leds: zinnialedsgrp {
  fsl,pins = <0x0050 0x0254 0x0000 0x00 0x00 0x11e>,
      <0x0078 0x027C 0x0000 0x00 0x00 0x11e>,
      <0x0064 0x0268 0x0000 0x00 0x00 0x11e>,
      <0x0060 0x0264 0x0000 0x00 0x00 0x11e>,
      <0x0184 0x0388 0x0000 0x05 0x00 0x11e>,
      <0x0180 0x0384 0x0000 0x05 0x00 0x11e>,
      <0x018C 0x0390 0x0000 0x05 0x00 0x11e>,
      <0x0198 0x039C 0x0000 0x05 0x00 0x11e>;
 };
};
# 14 "arch/arm64/boot/dts/freescale/imx95-verdin-nonwifi-zinnia.dts" 2

/ {
 model = "Toradex Verdin iMX95 on Zinnia Board";
 compatible = "toradex,verdin-imx95-nonwifi-zinnia",
       "toradex,verdin-imx95-nonwifi",
       "toradex,verdin-imx95",
       "fsl,imx95";
};
