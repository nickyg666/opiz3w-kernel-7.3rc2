# 0 "arch/arm64/boot/dts/freescale/imx93-11x11-frdm-pixpaper.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/freescale/imx93-11x11-frdm-pixpaper.dtso"
# 9 "arch/arm64/boot/dts/freescale/imx93-11x11-frdm-pixpaper.dtso"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 10 "arch/arm64/boot/dts/freescale/imx93-11x11-frdm-pixpaper.dtso" 2
# 1 "arch/arm64/boot/dts/freescale/imx93-pinfunc.h" 1
# 11 "arch/arm64/boot/dts/freescale/imx93-11x11-frdm-pixpaper.dtso" 2

/dts-v1/;
/plugin/;

&iomuxc {
 pinctrl_epd_ctrl: epdctrlgrp {
  fsl,pins = <
   0x0024 0x01D4 0x0000 0x0 0x0 0x31e
   0x0028 0x01D8 0x0000 0x0 0x0 0x31e
   0x0078 0x0228 0x0000 0x0 0x0 0x31e
  >;
 };

 pinctrl_lpspi3: lpspi3grp {
  fsl,pins = <
   0x0030 0x01E0 0x0000 0x0 0x0 0x3fe
   0x0034 0x01E4 0x0000 0x1 0x0 0x3fe
   0x0038 0x01E8 0x0000 0x1 0x0 0x3fe
   0x003C 0x01EC 0x0000 0x1 0x0 0x3fe
  >;
 };
};

&lpspi3 {
 #address-cells = <1>;
 #size-cells = <0>;
 cs-gpios = <&gpio2 8 1>;
 pinctrl-0 = <&pinctrl_lpspi3>, <&pinctrl_epd_ctrl>;
 pinctrl-names = "default";
 status = "okay";

 display@0 {
  compatible = "mayqueen,pixpaper";
  reg = <0>;
  busy-gpios = <&gpio2 26 0>;
  dc-gpios = <&gpio2 5 0>;
  reset-gpios = <&gpio2 6 0>;
  spi-max-frequency = <1000000>;
 };
};
