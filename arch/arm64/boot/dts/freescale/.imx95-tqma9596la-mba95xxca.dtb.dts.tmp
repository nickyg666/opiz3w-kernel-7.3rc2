 ethphy0: ethernet-phy@0 {
  compatible = "ethernet-phy-ieee802.3-c22";
  reg = <0>;
  reset-gpios = <&expander3 0 1>;
  reset-assert-us = <500000>;
  reset-deassert-us = <50000>;
  ti,rx-internal-delay = <0x9>;
  ti,tx-internal-delay = <0x9>;
  ti,fifo-depth = <0x01>;
