    sram0: sram@445b1000 {
     compatible = "mmio-sram";
     reg = <0x445b1000 0x400>;
     ranges = <0x0 0x445b1000 0x400>;
     #address-cells = <1>;
     #size-cells = <1>;

     scmi_buf0: scmi-sram-section@0 {
      compatible = "arm,scmi-shmem";
      reg = <0x0 0x80>;
     };

     scmi_buf1: scmi-sram-section@80 {
      compatible = "arm,scmi-shmem";
      reg = <0x80 0x80>;
     };
    };

   };

