   #size-cells = <1>;

   smmu: iommu@490d0000 {
    compatible = "arm,smmu-v3";
    reg = <0x490d0000 0x40000>;
    interrupts = <0 325 1>,
          <0 328 1>,
          <0 334 1>,
          <0 326 1>;
    interrupt-names = "eventq", "gerror", "priq", "cmdq-sync";
    #iommu-cells = <1>;
    status = "disabled";
   };

   pmu@490d2000 {
    compatible = "arm,smmu-v3-pmcg";
    reg = <0x490d2000 0x1000>,
          <0x490f2000 0x1000>;
    interrupts = <0 333 1>;
   };

   pmu@49112000 {
