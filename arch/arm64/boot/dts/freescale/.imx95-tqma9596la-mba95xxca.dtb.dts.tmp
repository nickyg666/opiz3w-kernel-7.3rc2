          <0x491a2000 0x1000>;
    interrupts = <0 323 1>;
   };

   pmu@491b2000 {
    compatible = "arm,smmu-v3-pmcg";
    reg = <0x491b2000 0x1000>,
          <0x491c2000 0x1000>;
    interrupts = <0 323 1>;
   };

   pmu@491d2000 {
    compatible = "arm,smmu-v3-pmcg";
    reg = <0x491d2000 0x1000>,
          <0x491e2000 0x1000>;
    interrupts = <0 323 1>;
   };

   pmu@491f2000 {
    compatible = "arm,smmu-v3-pmcg";
