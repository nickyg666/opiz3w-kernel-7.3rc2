 pinctrl-0 = <&pinctrl_tpm5>;
};

&usb2 {
 dr_mode = "otg";
 hnp-disable;
 srp-disable;
 adp-disable;
 usb-role-switch;
 disable-over-current;
 samsung,picophy-pre-emp-curr-control = <3>;
 samsung,picophy-dc-vol-level-adjust = <7>;
 status = "okay";

 port {
  typec_hs: endpoint {
   remote-endpoint = <&typec_con_hs>;
  };
 };
};

&usb3 {
 status = "okay";
};

&usb3_dwc3 {
 dr_mode = "host";
 #address-cells = <1>;
 #size-cells = <0>;
 status = "okay";

 hub_2_0: hub@1 {
  compatible = "usb451,8142";
  reg = <1>;
  peer-hub = <&hub_3_0>;
  reset-gpios = <&expander2 3 1>;
  vdd-supply = <&reg_v3v3_mb>;
  #address-cells = <1>;
  #size-cells = <0>;

  hub_2_1: hub@1 {
   compatible = "usb424,2514";
   reg = <1>;
   reset-gpios = <&expander2 4 1>;
   vdd-supply = <&reg_v3v3_mb>;
   vdda-supply = <&reg_v3v3_mb>;
  };
 };

 hub_3_0: hub@2 {
  compatible = "usb451,8140";
  reg = <2>;
  peer-hub = <&hub_2_0>;
  reset-gpios = <&expander2 3 1>;
  vdd-supply = <&reg_v3v3_mb>;
 };
};

