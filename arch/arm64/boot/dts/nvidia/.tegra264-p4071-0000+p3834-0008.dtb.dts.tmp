   };
  };
 };


 bus@8180000000 {
  compatible = "simple-bus";
  #address-cells = <2>;
  #size-cells = <2>;

  ranges = <0x000 0x00000000 0x81 0x80000000 0x00 0x10000000>,
    <0x100 0x00000000 0x00 0x20000000 0x00 0x40000000>,
    <0x200 0x00000000 0xa8 0x80000000 0x57 0x80000000>;

  host1x@1200000 {
   compatible = "nvidia,tegra264-host1x";
   reg = <0x0 0x1200000 0x0 0x10000>,
         <0x0 0x1210000 0x0 0x10000>,
         <0x0 0x1240000 0x0 0x10000>;
   reg-names = "common", "hypervisor", "vm";
   interrupts = <0 327 4>,
         <0 328 4>,
         <0 329 4>,
         <0 330 4>,
         <0 331 4>,
         <0 332 4>,
         <0 333 4>,
         <0 334 4>,
         <0 325 4>;
   interrupt-names = "syncpt0", "syncpt1", "syncpt2", "syncpt3", "syncpt4",
       "syncpt5", "syncpt6", "syncpt7", "host1x";
   clocks = <&bpmp 14>;
   clock-names = "host1x";

   #address-cells = <2>;
   #size-cells = <2>;

   ranges = <0x000 0x00000000 0x00 0x08000000 0x00 0x01000000>,
     <0x000 0x02800000 0x00 0x0a800000 0x00 0x00800000>;

   interconnects = <&mc 0x16 &emc>;
   interconnect-names = "dma-mem";
   iommus = <&smmu1 ((0x0b) << 8)>;
   dma-coherent;


   iommu-map = <0 &smmu1 (((0x30) << 8) + 1) 16>;

   vic@50000 {
    compatible = "nvidia,tegra264-vic";
    reg = <0x0 0x50000 0x0 0x40000>;
    interrupts = <0 468 4>;
    clocks = <&bpmp 59>;
    clock-names = "vic";
    resets = <&bpmp 49>;
    reset-names = "vic";
    power-domains = <&bpmp 18>;
    interconnects = <&mc 0x6c &emc>,
      <&mc 0x6d &emc>;
    interconnect-names = "dma-mem", "write";

    iommus = <&smmu1 ((0x30) << 8)>;
    dma-coherent;
   };
  };
 };


 bus@8800000000 {
  compatible = "simple-bus";
