     <0x0 0x9972000 0x0 0x1000>;
    interrupts = <0 0x231
     ((((1 << (4)) - 1) << 8) | 4)>;
    clocks = <&bpmp 156>;
    clock-names = "clk";
    status = "disabled";
   };

