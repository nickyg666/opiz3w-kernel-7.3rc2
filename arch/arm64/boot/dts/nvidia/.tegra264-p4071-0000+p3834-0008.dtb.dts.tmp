 pmu {
  compatible = "arm,armv8-pmuv3";
  interrupts = <1 7 8>;
 };

 psci {
  compatible = "arm,psci-1.0";
  method = "smc";
 };

 sound {
  compatible = "nvidia,tegra264-audio-graph-card";

  clocks = <&bpmp 158>,
    <&bpmp 159>;
  clock-names = "pll_a", "plla_out0";
  assigned-clocks = <&bpmp 158>,
   <&bpmp 159>,
   <&bpmp 277>;
  assigned-clock-parents = <0>,
   <&bpmp 158>,
   <&bpmp 159>;

  status = "disabled";
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupts = <1 13 8>,
        <1 14 8>,
        <1 11 8>,
        <1 10 8>,
        <1 12 8>;
 };
};
# 4 "arch/arm64/boot/dts/nvidia/tegra264-p3834.dtsi" 2

/ {
 compatible = "nvidia,p3834", "nvidia,tegra264";

 aliases {
 };

 bus@0 {
  dma-controller@8400000 {
   status = "okay";
  };

  serial@c4e0000 {
   status = "okay";
  };

  serial@c5a0000 {
   status = "okay";
  };
 };

 bus@8100000000 {
  iommu@5000000 {
   status = "okay";
  };

  cmdqv@5200000 {
   status = "okay";
  };

  iommu@6000000 {
   status = "okay";
  };

  cmdqv@6200000 {
   status = "okay";
  };
 };
};
# 4 "arch/arm64/boot/dts/nvidia/tegra264-p3834-0008.dtsi" 2

/ {
 compatible = "nvidia,p3834-0008", "nvidia,tegra264";
};
# 6 "arch/arm64/boot/dts/nvidia/tegra264-p4071-0000+p3834-0008.dts" 2
# 1 "arch/arm64/boot/dts/nvidia/tegra264-p4071-0000+p3834.dtsi" 1


/ {
 aliases {
  serial0 = &{/bus@0/serial@c4e0000};
  serial1 = &{/bus@0/serial@c5a0000};
 };

 chosen {
  stdout-path = "serial0:115200n8";
 };
};
# 7 "arch/arm64/boot/dts/nvidia/tegra264-p4071-0000+p3834-0008.dts" 2

/ {
 model = "NVIDIA Jetson AGX Thor Developer Kit";
 compatible = "nvidia,p4071-0000+p3834-0008", "nvidia,p3834-0008", "nvidia,tegra264";

 bus@a800000000 {

  pci@8420000 {
   status = "okay";
  };


  pci@8480000 {
   status = "okay";
  };
 };
};
