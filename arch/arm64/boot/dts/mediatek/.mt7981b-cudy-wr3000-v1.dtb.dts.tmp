# 0 "arch/arm64/boot/dts/mediatek/mt7981b-cudy-wr3000-v1.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/mediatek/mt7981b-cudy-wr3000-v1.dts"


/dts-v1/;
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 1
# 13 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/input/linux-event-codes.h" 1
# 14 "./scripts/dtc/include-prefixes/dt-bindings/input/input.h" 2
# 5 "arch/arm64/boot/dts/mediatek/mt7981b-cudy-wr3000-v1.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 6 "arch/arm64/boot/dts/mediatek/mt7981b-cudy-wr3000-v1.dts" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/leds/common.h" 1
# 7 "arch/arm64/boot/dts/mediatek/mt7981b-cudy-wr3000-v1.dts" 2

# 1 "arch/arm64/boot/dts/mediatek/mt7981b.dtsi" 1


# 1 "./scripts/dtc/include-prefixes/dt-bindings/clock/mediatek,mt7981-clk.h" 1
# 4 "arch/arm64/boot/dts/mediatek/mt7981b.dtsi" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/arm-gic.h" 1
# 9 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/arm-gic.h"
# 1 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/irq.h" 1
# 10 "./scripts/dtc/include-prefixes/dt-bindings/interrupt-controller/arm-gic.h" 2
# 5 "arch/arm64/boot/dts/mediatek/mt7981b.dtsi" 2

# 1 "./scripts/dtc/include-prefixes/dt-bindings/phy/phy.h" 1
# 7 "arch/arm64/boot/dts/mediatek/mt7981b.dtsi" 2
# 1 "./scripts/dtc/include-prefixes/dt-bindings/reset/mt7986-resets.h" 1
# 8 "arch/arm64/boot/dts/mediatek/mt7981b.dtsi" 2

/ {
 compatible = "mediatek,mt7981b";
 interrupt-parent = <&gic>;
 #address-cells = <2>;
 #size-cells = <2>;

 cpus {
  #address-cells = <1>;
  #size-cells = <0>;

  cpu@0 {
   compatible = "arm,cortex-a53";
   reg = <0x0>;
   device_type = "cpu";
   enable-method = "psci";
  };

  cpu@1 {
   compatible = "arm,cortex-a53";
   reg = <0x1>;
   device_type = "cpu";
   enable-method = "psci";
  };
 };

 oscillator-40m {
  compatible = "fixed-clock";
  clock-frequency = <40000000>;
  clock-output-names = "clkxtal";
  #clock-cells = <0>;
 };

 psci {
  compatible = "arm,psci-1.0";
  method = "smc";
 };

 reserved-memory {
  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  wo_boot: wo-boot@15194000 {
   reg = <0 0x15194000 0 0x1000>;
   no-map;
  };

  wo_ilm0: wo-ilm@151e0000 {
   reg = <0 0x151e0000 0 0x8000>;
   no-map;
  };

  wo_dlm0: wo-dlm@151e8000 {
   reg = <0 0x151e8000 0 0x2000>;
   no-map;
  };


  secmon_reserved: secmon@43000000 {
   reg = <0 0x43000000 0 0x30000>;
   no-map;
  };

  wmcpu_emi: wmcpu-reserved@47c80000 {
   reg = <0 0x47c80000 0 0x100000>;
   no-map;
  };

  wo_emi0: wo-emi@47d80000 {
   reg = <0 0x47d80000 0 0x40000>;
   no-map;
  };

  wo_data: wo-data@47dc0000 {
   reg = <0 0x47dc0000 0 0x240000>;
   no-map;
  };
 };

 soc {
  compatible = "simple-bus";
  ranges;
  #address-cells = <2>;
  #size-cells = <2>;

  gic: interrupt-controller@c000000 {
   compatible = "arm,gic-v3";
   reg = <0 0x0c000000 0 0x40000>,
         <0 0x0c080000 0 0x200000>;
   interrupt-parent = <&gic>;
   interrupts = <1 9 4>;
   interrupt-controller;
   #interrupt-cells = <3>;
  };

  infracfg: clock-controller@10001000 {
   compatible = "mediatek,mt7981-infracfg", "syscon";
   reg = <0 0x10001000 0 0x1000>;
   #clock-cells = <1>;
  };

  topckgen: clock-controller@1001b000 {
   compatible = "mediatek,mt7981-topckgen", "syscon";
   reg = <0 0x1001b000 0 0x1000>;
   #clock-cells = <1>;
  };

  watchdog: watchdog@1001c000 {
   compatible = "mediatek,mt7986-wdt";
   reg = <0 0x1001c000 0 0x1000>;
   interrupts = <0 110 4>;
   #reset-cells = <1>;
  };

  apmixedsys: clock-controller@1001e000 {
   compatible = "mediatek,mt7981-apmixedsys";
   reg = <0 0x1001e000 0 0x1000>;
   #clock-cells = <1>;
  };

  pwm: pwm@10048000 {
   compatible = "mediatek,mt7981-pwm";
   reg = <0 0x10048000 0 0x1000>;
   clocks = <&infracfg 14>,
     <&infracfg 13>,
     <&infracfg 15>,
     <&infracfg 16>,
     <&infracfg 17>;
   clock-names = "top", "main", "pwm1", "pwm2", "pwm3";
   #pwm-cells = <2>;
  };

  sgmiisys0: syscon@10060000 {
   compatible = "mediatek,mt7981-sgmiisys_0", "syscon";
   reg = <0 0x10060000 0 0x1000>;
   #clock-cells = <1>;
  };

  sgmiisys1: syscon@10070000 {
   compatible = "mediatek,mt7981-sgmiisys_1", "syscon";
   reg = <0 0x10070000 0 0x1000>;
   #clock-cells = <1>;
  };

  crypto@10320000 {
   compatible = "mediatek,mt7981-crypto",
    "inside-secure,safexcel-eip97ies";
   reg = <0 0x10320000 0 0x40000>;
   interrupts = <0 116 4>,
         <0 117 4>,
         <0 118 4>,
         <0 119 4>;
   interrupt-names = "ring0", "ring1", "ring2", "ring3";
   clocks = <&topckgen 66>;
   clock-names = "core";
   assigned-clocks = <&topckgen 99>;
   assigned-clock-parents = <&topckgen 21>;
  };

  uart0: serial@11002000 {
   compatible = "mediatek,mt7981-uart", "mediatek,mt6577-uart";
   reg = <0 0x11002000 0 0x100>;
   interrupts = <0 123 4>;
   interrupt-names = "uart", "wakeup";
   clocks = <&infracfg 1>,
     <&infracfg 31>;
   clock-names = "baud", "bus";
   pinctrl-names = "default";
   pinctrl-0 = <&uart0_pins>;
   status = "disabled";
  };

  uart1: serial@11003000 {
   compatible = "mediatek,mt7981-uart", "mediatek,mt6577-uart";
   reg = <0 0x11003000 0 0x100>;
   interrupts = <0 124 4>;
   interrupt-names = "uart", "wakeup";
   clocks = <&infracfg 2>,
     <&infracfg 32>;
   clock-names = "baud", "bus";
   status = "disabled";
  };

  uart2: serial@11004000 {
   compatible = "mediatek,mt7981-uart", "mediatek,mt6577-uart";
   reg = <0 0x11004000 0 0x100>;
   interrupts = <0 125 4>;
   interrupt-names = "uart", "wakeup";
   clocks = <&infracfg 3>,
     <&infracfg 33>;
   clock-names = "baud", "bus";
   status = "disabled";
  };

  i2c@11007000 {
   compatible = "mediatek,mt7981-i2c";
   reg = <0 0x11007000 0 0x1000>,
         <0 0x10217080 0 0x80>;
   interrupts = <0 136 4>;
   clocks = <&infracfg 30>,
     <&infracfg 26>,
     <&infracfg 51>,
     <&infracfg 52>;
   clock-names = "main", "dma", "arb", "pmic";
   #address-cells = <1>;
   #size-cells = <0>;
   status = "disabled";
  };

  spi2: spi@11009000 {
   compatible = "mediatek,mt7981-spi-ipm", "mediatek,spi-ipm";
   reg = <0 0x11009000 0 0x1000>;
   interrupts = <0 142 4>;
   clocks = <&topckgen 2>,
     <&topckgen 78>,
     <&infracfg 34>,
     <&infracfg 35>;
   clock-names = "parent-clk", "sel-clk", "spi-clk", "hclk";
   #address-cells = <1>;
   #size-cells = <0>;
   status = "disabled";
  };

  spi@1100a000 {
   compatible = "mediatek,mt7981-spi-ipm", "mediatek,spi-ipm";
   reg = <0 0x1100a000 0 0x1000>;
   interrupts = <0 140 4>;
   clocks = <&topckgen 2>,
     <&topckgen 78>,
     <&infracfg 39>,
     <&infracfg 41>;
   clock-names = "parent-clk", "sel-clk", "spi-clk", "hclk";
   #address-cells = <1>;
   #size-cells = <0>;
   status = "disabled";
  };

  spi@1100b000 {
   compatible = "mediatek,mt7981-spi-ipm", "mediatek,spi-ipm";
   reg = <0 0x1100b000 0 0x1000>;
   interrupts = <0 141 4>;
   clocks = <&topckgen 2>,
     <&topckgen 78>,
     <&infracfg 40>,
     <&infracfg 42>;
   clock-names = "parent-clk", "sel-clk", "spi-clk", "hclk";
   #address-cells = <1>;
   #size-cells = <0>;
   status = "disabled";
  };

  thermal@1100c800 {
   compatible = "mediatek,mt7981-thermal",
         "mediatek,mt7986-thermal";
   reg = <0 0x1100c800 0 0x800>;
   interrupts = <0 138 4>;
   clocks = <&infracfg 29>,
     <&infracfg 48>;
   clock-names = "therm", "auxadc";
   nvmem-cells = <&thermal_calibration>;
   nvmem-cell-names = "calibration-data";
   #thermal-sensor-cells = <1>;
   mediatek,auxadc = <&auxadc>;
   mediatek,apmixedsys = <&apmixedsys>;
  };

  auxadc: adc@1100d000 {
   compatible = "mediatek,mt7981-auxadc",
         "mediatek,mt7986-auxadc";
   reg = <0 0x1100d000 0 0x1000>;
   clocks = <&infracfg 48>;
   clock-names = "main";
   #io-channel-cells = <1>;
   status = "disabled";
  };

  xhci: usb@11200000 {
   compatible = "mediatek,mt7986-xhci", "mediatek,mtk-xhci";
   reg = <0 0x11200000 0 0x2e00>, <0 0x11203e00 0 0x0100>;
   reg-names = "mac", "ippc";
   clocks = <&infracfg 55>,
     <&infracfg 56>,
     <&infracfg 53>,
     <&infracfg 54>,
     <&topckgen 107>;
   clock-names = "sys_ck", "ref_ck", "mcu_ck", "dma_ck", "xhci_ck";
   interrupts = <0 173 4>;
   phys = <&u2port0 3>, <&u3port0 4>;
   status = "disabled";
  };

  pcie: pcie@11280000 {
   compatible = "mediatek,mt7981-pcie",
         "mediatek,mt8192-pcie";
   reg = <0 0x11280000 0 0x4000>;
   reg-names = "pcie-mac";
   ranges = <0x82000000 0 0x20000000
      0x0 0x20000000 0 0x10000000>;
   bus-range = <0x00 0xff>;
   clocks = <&infracfg 57>,
     <&infracfg 58>,
     <&infracfg 59>,
     <&infracfg 60>;
   clock-names = "pl_250m", "tl_26m", "peri_26m", "top_133m";
   device_type = "pci";
   phys = <&u3port0 2>;
   phy-names = "pcie-phy";
   interrupts = <0 168 4>;
   interrupt-map-mask = <0 0 0 7>;
   interrupt-map = <0 0 0 1 &pcie_intc 0>,
     <0 0 0 2 &pcie_intc 1>,
     <0 0 0 3 &pcie_intc 2>,
     <0 0 0 4 &pcie_intc 3>;
   #address-cells = <3>;
   #interrupt-cells = <1>;
   #size-cells = <2>;
   status = "disabled";

   pcie_intc: interrupt-controller {
    interrupt-controller;
    #address-cells = <0>;
    #interrupt-cells = <1>;
   };
  };

  pio: pinctrl@11d00000 {
   compatible = "mediatek,mt7981-pinctrl";
   reg = <0 0x11d00000 0 0x1000>,
         <0 0x11c00000 0 0x1000>,
         <0 0x11c10000 0 0x1000>,
         <0 0x11d20000 0 0x1000>,
         <0 0x11e00000 0 0x1000>,
         <0 0x11e20000 0 0x1000>,
         <0 0x11f00000 0 0x1000>,
         <0 0x11f10000 0 0x1000>,
         <0 0x1000b000 0 0x1000>;
   reg-names = "gpio", "iocfg_rt", "iocfg_rm", "iocfg_rb", "iocfg_lb",
        "iocfg_bl", "iocfg_tm", "iocfg_tl", "eint";
   interrupt-controller;
   interrupts = <0 225 4>;
   interrupt-parent = <&gic>;
   gpio-ranges = <&pio 0 0 57>;
   gpio-controller;
   #gpio-cells = <2>;
   #interrupt-cells = <2>;

   uart0_pins: uart0-pins {
    mux {
     function = "uart";
     groups = "uart0";
    };
   };
  };

  topmisc: topmisc@11d10000 {
   compatible = "mediatek,mt7981-topmisc", "syscon";
   reg = <0 0x11d10000 0 0x10000>;
   #clock-cells = <1>;
  };

  usb_phy: t-phy@11e10000 {
   compatible = "mediatek,mt7981-tphy",
         "mediatek,generic-tphy-v2";
   ranges = <0 0 0x11e10000 0x1700>;
   #address-cells = <1>;
   #size-cells = <1>;
   status = "disabled";

   u2port0: usb-phy@0 {
    reg = <0x0 0x700>;
    clocks = <&topckgen 108>;
    clock-names = "ref";
    #phy-cells = <1>;
   };

   u3port0: usb-phy@700 {
    reg = <0x700 0x900>;
    clocks = <&topckgen 100>;
    clock-names = "ref";
    #phy-cells = <1>;
    mediatek,syscon-type = <&topmisc 0x218 0>;
   };
  };

  efuse@11f20000 {
   compatible = "mediatek,mt7981-efuse", "mediatek,efuse";
   reg = <0 0x11f20000 0 0x1000>;
   #address-cells = <1>;
   #size-cells = <1>;

   soc-uuid@140 {
    reg = <0x140 0x10>;
   };

   thermal_calibration: thermal-calib@274 {
    reg = <0x274 0xc>;
   };

   phy_calibration: phy-calib@8dc {
    reg = <0x8dc 0x10>;
   };
  };

  ethsys: clock-controller@15000000 {
   compatible = "mediatek,mt7981-ethsys", "syscon";
   reg = <0 0x15000000 0 0x1000>;
   #clock-cells = <1>;
   #reset-cells = <1>;
  };

  wed: wed@15010000 {
   compatible = "mediatek,mt7981-wed",
         "syscon";
   reg = <0 0x15010000 0 0x1000>;
   interrupts = <0 205 4>;
   memory-region = <&wo_emi0>, <&wo_ilm0>, <&wo_dlm0>,
     <&wo_data>, <&wo_boot>;
   memory-region-names = "wo-emi", "wo-ilm", "wo-dlm",
           "wo-data", "wo-boot";
   mediatek,wo-ccif = <&wo_ccif0>;
  };

  eth: ethernet@15100000 {
   compatible = "mediatek,mt7981-eth";
   reg = <0 0x15100000 0 0x40000>;
   assigned-clocks = <&topckgen 96>,
       <&topckgen 97>;
   assigned-clock-parents = <&topckgen 27>,
       <&topckgen 34>;
   clocks = <&ethsys 0>,
     <&ethsys 1>,
     <&ethsys 2>,
     <&ethsys 3>,
     <&topckgen 64>,
     <&sgmiisys0 0>,
     <&sgmiisys0 1>,
     <&sgmiisys0 2>,
     <&sgmiisys0 3>,
     <&sgmiisys1 0>,
     <&sgmiisys1 1>,
     <&sgmiisys1 2>,
     <&sgmiisys1 3>,
     <&topckgen 93>,
     <&topckgen 94>;
   clock-names = "fe", "gp2", "gp1", "wocpu0",
          "sgmii_ck",
          "sgmii_tx250m", "sgmii_rx250m",
          "sgmii_cdr_ref", "sgmii_cdr_fb",
          "sgmii2_tx250m", "sgmii2_rx250m",
          "sgmii2_cdr_ref", "sgmii2_cdr_fb",
          "netsys0", "netsys1";
   interrupts = <0 196 4>,
         <0 197 4>,
         <0 198 4>,
         <0 199 4>,
         <0 189 4>,
         <0 190 4>,
         <0 191 4>,
         <0 192 4>;
   interrupt-names = "fe0", "fe1", "fe2", "fe3", "pdma0",
       "pdma1", "pdma2", "pdma3";
   sram = <&eth_sram>;
   mediatek,ethsys = <&ethsys>;
   mediatek,sgmiisys = <&sgmiisys0>, <&sgmiisys1>;
   mediatek,infracfg = <&topmisc>;
   mediatek,wed = <&wed>;
   status = "disabled";

   mdio_bus: mdio-bus {
    #address-cells = <1>;
    #size-cells = <0>;

    int_gbe_phy: ethernet-phy@0 {
     compatible = "ethernet-phy-ieee802.3-c22";
     reg = <0>;
     phy-mode = "gmii";
     phy-is-integrated;
     nvmem-cells = <&phy_calibration>;
     nvmem-cell-names = "phy-cal-data";
    };
   };
  };

  eth_sram: sram@15140000 {
   compatible = "mmio-sram";
   reg = <0 0x15140000 0 0x40000>;
   ranges = <0 0x15140000 0 0x40000>;
   #address-cells = <1>;
   #size-cells = <1>;
  };

  wo_ccif0: syscon@151a5000 {
   compatible = "mediatek,mt7986-wo-ccif", "syscon";
   reg = <0 0x151a5000 0 0x1000>;
   interrupts = <0 211 4>;
  };

  wifi: wifi@18000000 {
   compatible = "mediatek,mt7981-wmac";
   reg = <0 0x18000000 0 0x1000000>,
         <0 0x10003000 0 0x1000>,
         <0 0x11d10000 0 0x1000>;
   interrupts = <0 213 4>,
         <0 214 4>,
         <0 215 4>,
         <0 216 4>;
   clocks = <&topckgen 95>,
     <&topckgen 92>;
   clock-names = "mcu", "ap2conn";
   memory-region = <&wmcpu_emi>;
   resets = <&watchdog 23>;
   reset-names = "consys";
   status = "disabled";
  };
 };

 timer {
  compatible = "arm,armv8-timer";
  interrupt-parent = <&gic>;
  interrupts = <1 13 8>,
        <1 14 8>,
        <1 11 8>,
        <1 10 8>;
 };
};
# 9 "arch/arm64/boot/dts/mediatek/mt7981b-cudy-wr3000-v1.dts" 2

/ {
 compatible = "cudy,wr3000-v1", "mediatek,mt7981b";
 model = "Cudy WR3000 V1";

 memory@40000000 {
  reg = <0 0x40000000 0 0x10000000>;
  device_type = "memory";
 };

 keys {
  compatible = "gpio-keys";

  key-wps {
   label = "WPS";
   gpios = <&pio 0 1>;
   linux,code = <0x211>;
  };

  key-reset {
   label = "RESET";
   gpios = <&pio 1 1>;
   linux,code = <0x198>;
  };
 };

 leds {
  compatible = "gpio-leds";

  led-0 {
   color = <3>;
   function = "wan";
   gpios = <&pio 5 1>;
  };

  led-1 {
   color = <3>;
   function = "wlan-2ghz";
   gpios = <&pio 6 1>;
  };

  led-2 {
   color = <3>;
   function = "wlan-5ghz";
   gpios = <&pio 7 1>;
  };

  led-3 {
   color = <3>;
   function = "lan";
   gpios = <&pio 9 1>;
  };

  led-4 {
   color = <3>;
   function = "status";
   gpios = <&pio 10 1>;
  };

  led-5 {
   color = <3>;
   function = "wan-online";
   gpios = <&pio 11 1>;
  };
 };
};
