# 0 "arch/arm64/boot/dts/ti/k3-am642-phyboard-electra-x27-gpio1-spi1-uart3.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/ti/k3-am642-phyboard-electra-x27-gpio1-spi1-uart3.dtso"
# 11 "arch/arm64/boot/dts/ti/k3-am642-phyboard-electra-x27-gpio1-spi1-uart3.dtso"
/dts-v1/;
/plugin/;

# 1 "arch/arm64/boot/dts/ti/k3-pinctrl.h" 1
# 15 "arch/arm64/boot/dts/ti/k3-am642-phyboard-electra-x27-gpio1-spi1-uart3.dtso" 2

&{/} {
 aliases {
  serial5 = "/bus@f4000/serial@2830000";
 };
};

&main_pmx0 {
 main_gpio1_exp_header_gpio_pins_default: main-gpio1-exp-header-gpio-default-pins {
  pinctrl-single,pins = <
   (((0x0220) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (7))
  >;
 };

 main_spi1_pins_default: main-spi1-default-pins {
  pinctrl-single,pins = <
   (((0x0224) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (0))
   (((0x021c) & 0x1fff)) ((((0 << (18)) | (1 << (16)))) | (0))
   (((0x0228) & 0x1fff)) ((((0 << (18)) | (1 << (16)))) | (0))
   (((0x022c) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (0))
  >;
 };

 main_uart3_pins_default: main-uart3-default-pins {
  pinctrl-single,pins = <
   (((0x0048) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (2))
   (((0x004c) & 0x1fff)) ((((0 << (18)) | (1 << (16)))) | (2))
  >;
 };
};

&main_gpio1 {
 pinctrl-names = "default";
 pinctrl-0 = <&main_gpio1_exp_header_gpio_pins_default>;
 status = "okay";
};

&main_spi1 {
 pinctrl-names = "default";
 pinctrl-0 = <&main_spi1_pins_default>;
 ti,pindir-d0-out-d1-in;
 status = "okay";
};

&main_uart3 {
 pinctrl-names = "default";
 pinctrl-0 = <&main_uart3_pins_default>;
 status = "okay";
};
