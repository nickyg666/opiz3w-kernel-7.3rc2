# 0 "arch/arm64/boot/dts/ti/k3-am625-verdin-dsi-to-hdmi.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/ti/k3-am625-verdin-dsi-to-hdmi.dtso"
# 10 "arch/arm64/boot/dts/ti/k3-am625-verdin-dsi-to-hdmi.dtso"
/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 14 "arch/arm64/boot/dts/ti/k3-am625-verdin-dsi-to-hdmi.dtso" 2

&{/} {
 hdmi-connector {
  compatible = "hdmi-connector";
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_pwm3_dsi_gpio>;
  ddc-i2c-bus = <&main_i2c2>;

  hpd-gpios = <&main_gpio1 17 0>;
  type = "a";

  port {
   hdmi_connector_in: endpoint {
    remote-endpoint = <&dsi_hdmi_bridge_out>;
   };
  };
 };
};

&dsi_bridge {
 status = "okay";
};

&dsi_bridge_ports {
 #address-cells = <1>;
 #size-cells = <0>;

 port@1 {
  reg = <1>;

  dsi_bridge_out: endpoint {
   remote-endpoint = <&dsi_hdmi_bridge_in>;
  };
 };
};

&dss {
 status = "okay";
};


&epwm1 {
 status = "disabled";
};


&main_i2c1 {
 #address-cells = <1>;
 #size-cells = <0>;

 hdmi@48 {
  compatible = "lontium,lt8912b";
  reg = <0x48>;
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_dsi1_bkl_en>;

  reset-gpios = <&main_gpio0 30 1>;

  ports {
   #address-cells = <1>;
   #size-cells = <0>;

   port@0 {
    reg = <0>;

    dsi_hdmi_bridge_in: endpoint {
     data-lanes = <1 2 3 4>;
     remote-endpoint = <&dsi_bridge_out>;
    };
   };

   port@1 {
    reg = <1>;

    dsi_hdmi_bridge_out: endpoint {
     remote-endpoint = <&hdmi_connector_in>;
    };
   };
  };
 };
};
