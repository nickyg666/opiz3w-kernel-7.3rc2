# 0 "arch/arm64/boot/dts/ti/k3-am625-verdin-dev-mezzanine-can.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/ti/k3-am625-verdin-dev-mezzanine-can.dtso"
# 10 "arch/arm64/boot/dts/ti/k3-am625-verdin-dev-mezzanine-can.dtso"
/dts-v1/;
/plugin/;

# 1 "arch/arm64/boot/dts/ti/k3-pinctrl.h" 1
# 14 "arch/arm64/boot/dts/ti/k3-am625-verdin-dev-mezzanine-can.dtso" 2

&mcu_pmx0 {
 pinctrl_mcu_mcan1: mcu-mcan1-default-pins {
  pinctrl-single,pins = <
   (((0x0040) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (0))
   (((0x003c) & 0x1fff)) ((((0 << (18)) | (1 << (16)))) | (0))
  >;
 };
};

&mcu_mcan1 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_mcu_mcan1>;
 status = "okay";
};
