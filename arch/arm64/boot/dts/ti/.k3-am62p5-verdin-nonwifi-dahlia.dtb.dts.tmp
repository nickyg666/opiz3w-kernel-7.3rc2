# 0 "arch/arm64/boot/dts/ti/k3-am62p5-verdin-nonwifi-dahlia.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/ti/k3-am62p5-verdin-nonwifi-dahlia.dts"
# 9 "arch/arm64/boot/dts/ti/k3-am62p5-verdin-nonwifi-dahlia.dts"
/dts-v1/;

# 1 "arch/arm64/boot/dts/ti/k3-am62p5.dtsi" 1
