  ti,esm-pins = <0>, <1>, <2>, <85>, <86>;
 };






 mcu_timer0: timer@4800000 {
  compatible = "ti,am654-timer";
  reg = <0x00 0x4800000 0x00 0x400>;
  clocks = <&k3_clks 35 2>;
  clock-names = "fck";
  power-domains = <&k3_pds 35 1>;
