&reserved_memory {
 mcu_r5fss0_core0_dma_memory_region: memory@9b800000 {
  compatible = "shared-dma-pool";
  reg = <0x00 0x9b800000 0x00 0x100000>;
  no-map;
 };

 mcu_r5fss0_core0_memory_region: memory@9b900000 {
  compatible = "shared-dma-pool";
  reg = <0x00 0x9b900000 0x00 0xf00000>;
  no-map;
 };
};

&mailbox0_cluster0 {
 status = "okay";

