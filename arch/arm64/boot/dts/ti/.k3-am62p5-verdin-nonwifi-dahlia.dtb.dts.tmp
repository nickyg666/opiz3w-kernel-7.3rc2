  status = "reserved";
 };

 mcu_timer1: timer@4810000 {
  compatible = "ti,am654-timer";
  reg = <0x00 0x4810000 0x00 0x400>;
  clocks = <&k3_clks 48 2>;
  clock-names = "fck";
  power-domains = <&k3_pds 48 1>;
