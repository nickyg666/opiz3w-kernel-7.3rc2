 som_adc: adc@49 {
  compatible = "ti,tla2024";
  reg = <0x49>;
  #address-cells = <1>;
  #size-cells = <0>;
  #io-channel-cells = <1>;


  channel@0 {
   reg = <0>;
   ti,datarate = <4>;
   ti,gain = <2>;
  };


  channel@1 {
   reg = <1>;
   ti,datarate = <4>;
   ti,gain = <2>;
  };


  channel@2 {
   reg = <2>;
   ti,datarate = <4>;
   ti,gain = <2>;
  };


  channel@3 {
   reg = <3>;
   ti,datarate = <4>;
   ti,gain = <2>;
  };


  channel@4 {
   reg = <4>;
   ti,datarate = <4>;
   ti,gain = <2>;
  };


  channel@5 {
   reg = <5>;
   ti,datarate = <4>;
   ti,gain = <2>;
  };


  channel@6 {
   reg = <6>;
   ti,datarate = <4>;
   ti,gain = <2>;
  };


  channel@7 {
   reg = <7>;
   ti,datarate = <4>;
   ti,gain = <2>;
  };
 };

 som_eeprom: eeprom@50 {
  compatible = "st,24c02", "atmel,24c02";
