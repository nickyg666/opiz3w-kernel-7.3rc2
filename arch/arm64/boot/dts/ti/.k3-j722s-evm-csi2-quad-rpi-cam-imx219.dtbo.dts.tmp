&cdns_csi2rx3 {
 ports {
  #address-cells = <1>;
  #size-cells = <0>;

  csi3_port0: port@0 {
   reg = <0>;
   status = "okay";

   csi2rx3_in_sensor: endpoint {
    remote-endpoint = <&csi2_cam3>;
    bus-type = <4>;
    clock-lanes = <0>;
    data-lanes = <1 2>;
   };
  };
 };
};

&ti_csi2rx0 {
 status = "okay";
};

&dphy0 {
 status = "okay";
};

&ti_csi2rx1 {
 status = "okay";
};

&dphy1 {
 status = "okay";
};

&ti_csi2rx2 {
 status = "okay";
};

&dphy2 {
 status = "okay";
};

&ti_csi2rx3 {
 status = "okay";
};

&dphy3 {
 status = "okay";
};
