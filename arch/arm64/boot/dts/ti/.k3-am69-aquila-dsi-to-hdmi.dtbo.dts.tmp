# 0 "arch/arm64/boot/dts/ti/k3-am69-aquila-dsi-to-hdmi.dtso"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "arch/arm64/boot/dts/ti/k3-am69-aquila-dsi-to-hdmi.dtso"
# 11 "arch/arm64/boot/dts/ti/k3-am69-aquila-dsi-to-hdmi.dtso"
/dts-v1/;
/plugin/;

# 1 "./scripts/dtc/include-prefixes/dt-bindings/gpio/gpio.h" 1
# 15 "arch/arm64/boot/dts/ti/k3-am69-aquila-dsi-to-hdmi.dtso" 2

&{/} {
 hdmi-connector {
  compatible = "hdmi-connector";
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_pwm3_dsi_gpio>;
  ddc-i2c-bus = <&i2c_dsi_1>;

  hpd-gpios = <&main_gpio0 33 0>;
  type = "a";

  port {
   hdmi_connector_in: endpoint {
    remote-endpoint = <&dsi_hdmi_bridge_out>;
   };
  };
 };
};

&dphy_tx0 {
 status = "okay";
};

&dsi0 {
 status = "okay";
};

&dsi0_ports {
 #address-cells = <1>;
 #size-cells = <0>;

 port@0 {
  reg = <0>;

  dsi0_out: endpoint {
   remote-endpoint = <&dsi_hdmi_bridge_in>;
  };
 };

 port@1 {
  reg = <1>;

  dsi0_in: endpoint {
   remote-endpoint = <&dpi2_out>;
  };
 };
};

&dss_ports {
 #address-cells = <1>;
 #size-cells = <0>;

 port@2 {
  reg = <2>;

  dpi2_out: endpoint {
   remote-endpoint = <&dsi0_in>;
  };
 };
};


&main_ehrpwm5 {
 status = "disabled";
};

&i2c_dsi_0 {
 #address-cells = <1>;
 #size-cells = <0>;

 hdmi@48 {
  compatible = "lontium,lt8912b";
  reg = <0x48>;
  pinctrl-names = "default";
  pinctrl-0 = <&pinctrl_gpio_20_dsi_1>;

  reset-gpios = <&main_gpio0 18 1>;

  ports {
   #address-cells = <1>;
   #size-cells = <0>;

   port@0 {
    reg = <0>;

    dsi_hdmi_bridge_in: endpoint {
     remote-endpoint = <&dsi0_out>;
     data-lanes = <1 2 3 4>;
    };
   };

   port@1 {
    reg = <1>;

    dsi_hdmi_bridge_out: endpoint {
     remote-endpoint = <&hdmi_connector_in>;
    };
   };
  };
 };
};
