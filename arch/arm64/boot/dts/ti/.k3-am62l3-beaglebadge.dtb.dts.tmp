   (((0x004) & 0x1fff)) ((((0 << (18)) | (1 << (16)))) | (7))
  >;
  bootph-all;
 };

 mmc1_pins_default: mmc1-default-pins {
  pinctrl-single,pins = <
   (((0x0230) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (0))
   (((0x0228) & 0x1fff)) ((((0 << (18)) | (1 << (16)))) | (0))
   (((0x0224) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (0))
   (((0x0220) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (0))
