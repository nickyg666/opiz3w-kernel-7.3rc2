 uart1_pins_default: uart1-default-pins {
  pinctrl-single,pins = <
   (((0x019c) & 0x1fff)) ((((0 << (18)) | (1 << (16)))) | (2))
   (((0x0198) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (2))
   (((0x0180) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (2))
