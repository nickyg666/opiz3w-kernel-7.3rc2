   (((0x00c0) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (7))
   (((0x00e8) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (7))
   (((0x00b8) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (7))
   (((0x01c0) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (16)))) | (7))
