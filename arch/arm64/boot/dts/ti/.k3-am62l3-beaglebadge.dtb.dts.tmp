   (((0x01d8) & 0x1fff)) ((((1 << (18)) | (1 << (14)) | (1 << (17) | (0 << (16))))) | (0))
  >;
  bootph-all;
 };

 i2c2_qwiic_pins_default: i2c2-qwiic-default-pins {
