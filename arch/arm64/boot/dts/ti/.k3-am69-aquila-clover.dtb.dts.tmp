 fss: bus@47000000 {
  compatible = "simple-bus";
  #address-cells = <2>;
  #size-cells = <2>;
  ranges = <0x00 0x47000000 0x00 0x47000000 0x00 0x00000100>,
    <0x00 0x47040000 0x00 0x47040000 0x00 0x00000100>,
    <0x00 0x47050000 0x00 0x47050000 0x00 0x00000100>,
    <0x00 0x50000000 0x00 0x50000000 0x00 0x10000000>,
