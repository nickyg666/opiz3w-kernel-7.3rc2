};


&pcie0_rc {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_pcie0_reset>;
 clocks = <&k3_clks 332 0>, <&serdes1 0>;
 clock-names = "fck", "pcie_refclk";
 num-lanes = <2>;
 phy-names = "pcie-phy";
 phys = <&serdes1_pcie0_2l_link>;
 reset-gpios = <&main_gpio0 32 0>;
 ti,syscon-acspcie-proxy-ctrl = <&acspcie1_proxy_ctrl 0x3>;
 status = "disabled";
};


&pcie1_rc {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_pcie1_reset>;
 clocks = <&k3_clks 333 0>, <&serdes0 0>;
 clock-names = "fck", "pcie_refclk";
 num-lanes = <2>;
 phy-names = "pcie-phy";
 phys = <&serdes0_pcie1_2l_link>;
 reset-gpios = <&main_gpio0 41 0>;
 ti,syscon-acspcie-proxy-ctrl = <&acspcie0_proxy_ctrl 0x3>;
 status = "disabled";
};


&pcie2_rc {
 clocks = <&k3_clks 334 0>, <&serdes1 0>;
 clock-names = "fck", "pcie_refclk";
 num-lanes = <1>;
 phy-names = "pcie-phy";
 phys = <&serdes1_pcie2_1l_link>;
 reset-gpios = <&som_gpio_expander 3 0>;
 ti,syscon-acspcie-proxy-ctrl = <&acspcie1_proxy_ctrl 0x3>;
 status = "okay";

 pci@0,0 {
  device_type = "pci";
  reg = <0x0 0x0 0x0 0x0 0x0>;

  #address-cells = <3>;
  #size-cells = <2>;
  ranges;

  usb@0 {
   compatible = "pci104c,8241";
   reg = <0x0 0x0 0x0 0x0 0x0>;
   ti,pwron-active-high;
  };
 };
};


&pcie3_rc {
 clocks = <&k3_clks 335 0>, <&serdes0 0>;
 clock-names = "fck", "pcie_refclk";
 num-lanes = <1>;
 phy-names = "pcie-phy";
 phys = <&serdes0_pcie3_1l_link>;
 reset-gpios = <&som_gpio_expander 4 0>;
 ti,syscon-acspcie-proxy-ctrl = <&acspcie0_proxy_ctrl 0x3>;
 status = "okay";
};

&serdes0 {
 status = "okay";


 serdes0_pcie1_2l_link: phy@0 {
  reg = <0>;
  #phy-cells = <0>;
  resets = <&serdes_wiz0 1>, <&serdes_wiz0 2>;
  cdns,num-lanes = <2>;
  cdns,phy-type = <2>;
 };


 serdes0_pcie3_1l_link: phy@2 {
  reg = <2>;
  #phy-cells = <0>;
  resets = <&serdes_wiz0 3>;
  cdns,num-lanes = <1>;
  cdns,phy-type = <2>;
 };


 serdes0_usb0_ss_link: phy@3 {
  reg = <3>;
  #phy-cells = <0>;
