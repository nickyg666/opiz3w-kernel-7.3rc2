  compatible = "ti,am654-timer";
  reg = <0x00 0x40410000 0x00 0x400>;
  interrupts = <0 817 4>;
  clocks = <&k3_clks 117 2>;
  clock-names = "fck";
  assigned-clocks = <&k3_clks 117 2>;
  assigned-clock-parents = <&k3_clks 117 3>;
  power-domains = <&k3_pds 117 1>;
  ti,timer-pwm;

