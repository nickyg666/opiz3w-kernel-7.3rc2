  compatible = "ti,am654-timer";
  reg = <0x00 0x40420000 0x00 0x400>;
  interrupts = <0 818 4>;
  clocks = <&k3_clks 118 2>;
  clock-names = "fck";
  assigned-clocks = <&k3_clks 118 2>;
  assigned-clock-parents = <&k3_clks 118 3>;
  power-domains = <&k3_pds 118 1>;
