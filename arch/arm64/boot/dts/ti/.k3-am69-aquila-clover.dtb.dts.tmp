 status = "okay";
};


&pcie1_rc {
 status = "okay";
};

&serdes2 {
 status = "okay";
};

&serdes4 {
 status = "okay";
};

&serdes_wiz2 {
 status = "okay";
};

&serdes_wiz4 {
 status = "okay";
};


&tscadc0 {
 status = "okay";
};

&usbss0 {
 status = "okay";
};

&usb0ss_mux {
 status = "okay";

 port {
  usb0_ss_mux: endpoint {
   remote-endpoint = <&usb_1_con_ss>;
  };
 };
};

&usb0 {
 status = "okay";

 port {
  usb0_hs: endpoint {
   remote-endpoint = <&usb_1_con_hs>;
  };
 };
};

&wkup0_thermal {
 cooling-maps {
  map0 {
   cooling-device = <&fan 1 1>;
   trip = <&wkup0_alert0>;
  };

  map1 {
   cooling-device = <&fan 2 2>;
   trip = <&wkup0_alert1>;
  };
 };
};

&wkup1_thermal {
 cooling-maps {
  map0 {
   cooling-device = <&fan 1 1>;
   trip = <&wkup1_alert0>;
  };

  map1 {
   cooling-device = <&fan 2 2>;
   trip = <&wkup1_alert1>;
  };
 };
};

&wkup_gpio0 {
 pinctrl-names = "default";
 pinctrl-0 = <&pinctrl_gpio_04>;
};


&wkup_uart0 {
 status = "okay";
};
