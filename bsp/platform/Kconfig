	depends on ARCH_SUN50I
	help
	  Support for Allwinner SUN50IW9 SoC

config ARCH_SUN50IW3
	bool "SUN50IW3"
	depends on ARCH_SUN50I
	help
	  Support for Allwinner SUN50IW3 SoC

config ARCH_SUN50IW4
	bool "SUN50IW4"
	depends on ARCH_SUN50I
	help
	  Support for Allwinner SUN50IW4 SoC

config ARCH_SUN50IW5
	bool "SUN50IW5"
	depends on ARCH_SUN50I
	help
